62\225, \354\230\244\353\245\230/\354\235\264\354\212\210, \354\227\260\354\236\245, \355\231\230\353\266\210, \355\201\264\353\240\210\354\236\204 \353\223\261 | \353\254\270\354\235\230 \354\234\240\355\230\225 \354\271\264\355\205\214\352\263\240\353\246\254 |\n| `status` | VARCHAR | \355\225\264\352\262\260\354\244\221, \352\263\265\354\234\240\354\236\220 \354\227\260\353\235\275 \354\244\221, \354\234\240\354\204\240 \353\266\200\354\204\234 \355\231\225\354\235\270 \354\244\221, \354\231\204\353\243\214 | \354\247\204\354\262\231\353\217\204 \353\214\200\353\266\204\353\245\230 |\n| `sub_status` | TEXT | - | \354\247\204\354\262\231\353\217\204 \354\206\214\353\266\204\353\245\230/\354\203\201\354\204\270 \354\202\254\354\234\240 (\354\230\210: \353\266\200\354\236\254\354\244\221 1\354\260\250, \352\260\234\353\260\234\355\214\200 \353\214\200\352\270\260 \353\223\261) |\n| `agent_name` | VARCHAR | FOREIGN KEY (`internal_agents.agent_name`) | \355\230\204\354\236\254 \353\213\264\353\213\271 \354\203\201\353\213\264\354\233\220 \354\235\264\353\246\204 (\353\210\204\352\260\200 \354\235\221\353\214\200 \354\244\221\354\235\270\352\260\200) |\n| `summary` | TEXT | - | \354\203\201\353\213\264 \353\251\224\353\252\250 \353\260\217 AI \354\232\224\354\225\275 \353\202\264\354\232\251 |\n| `created_at` | TIMESTAMP | DEFAULT NOW() | \354\203\201\353\213\264 \354\240\221\354\210\230 \354\235\274\354\213\234 |\n| `updated_at` | TIMESTAMP | DEFAULT NOW() | \354\265\234\354\242\205 \354\210\230\354\240\225 \354\235\274\354\213\234 |\n\n### \360\237\223\212 \355\205\214\354\235\264\353\270\224 6: \355\214\224\353\241\234\354\232\260\354\227\205 \353\246\254\353\247\210\354\235\270\353\215\224 \355\203\234\354\212\244\355\201\254 (`agent_tasks`)\n\n| **\354\273\254\353\237\274\353\252\205 (\355\225\204\353\223\234)** | **\353\215\260\354\235\264\355\204\260 \355\203\200\354\236\205** | **\354\240\234\354\225\275 \354\241\260\352\261\264 / \354\204\240\355\203\235\354\247\200** | **\354\204\244\353\252\205** |\n| --- | --- | --- | --- |\n| `id` | UUID | PRIMARY KEY | \355\203\234\354\212\244\355\201\254 \352\263\240\354\234\240 ID |\n| `consultation_id` | UUID | FOREIGN KEY (`consultations.id`) | \354\227\260\353\217\231\353\220\234 \354\203\201\353\213\264 ID |\n| `agent_name` | VARCHAR | NOT NULL | \353\213\264\353\213\271 \354\203\201\353\213\264\354\233\220 (\352\265\254\352\270\200 Task \353\213\264\353\213\271\354\236\220) |\n| `task_title` | TEXT | NOT NULL | \355\225\240 \354\235\274 \353\202\264\354\232\251 (\354\230\210: \"[\352\263\265\354\234\240\354\236\220 \353\266\200\354\236\254] 16:00 \354\236\254\355\206\265\355\231\224\") |\n| `due_date` | TIMESTAMP | NOT NULL | \354\227\260\353\235\275 \353\223\234\353\246\254\352\270\260\353\241\234 \354\225\275\354\206\215\355\225\234 \354\213\234\352\260\204 (\353\215\260\353\223\234\353\235\274\354\235\270) |\n| `is_completed` | BOOLEAN | DEFAULT FALSE | \353\247\210\352\260\220/\354\231\204\353\243\214 \354\227\254\353\266\200 (\354\262\264\355\201\254\353\260\225\354\212\244) |\n\n## 4. UI/UX \355\231\224\353\251\264 \354\204\244\352\263\204 \353\260\217 \355\225\265\354\213\254 \352\270\260\353\212\245 \353\252\205\354\204\270\n\n### \360\237\226\245\357\270\217 \355\231\224\353\251\264 1: 3\353\266\204\355\225\240 \355\206\265\355\225\251 \354\203\201\353\213\264 \354\233\214\355\201\254\354\212\244\355\216\230\354\235\264\354\212\244 (Main Dashboard)\n\n\354\203\201\353\213\264\354\233\220\354\235\264 \355\231\224\353\251\264\354\235\204 \354\235\264\355\203\210\355\225\230\354\247\200 \354\225\212\352\263\240 \355\225\230\353\202\230\354\235\230 \353\267\260\354\227\220\354\204\234 \354\271\264\355\206\241/\354\240\204\355\231\224 \352\270\260\353\241\235, \352\263\240\352\260\235\354\240\225\353\263\264 \354\236\205\353\240\245, \355\203\234\354\212\244\355\201\254 \352\264\200\353\246\254\353\245\274 \353\217\231\354\213\234\354\227\220 \354\262\230\353\246\254\355\225\230\353\212\224 \355\231\224\353\251\264\354\236\205\353\213\210\353\213\244.\n\n- **[\354\242\214\354\270\241] \354\235\270\355\204\260\353\236\231\354\205\230, \353\205\271\354\267\250 \355\224\214\353\240\210\354\235\264\354\226\264 & STT \352\270\260\353\241\235 \354\230\201\354\227\255**\n    - **\355\206\265\355\231\224 \353\205\271\354\267\250 & STT \355\224\214\353\240\210\354\235\264\354\226\264 \354\234\204\354\240\257**: \352\263\240\352\260\235 \354\240\204\355\231\224 \354\210\230\354\213\240 \354\213\234 `call_logs`\354\231\200 \354\227\260\353\217\231\353\220\230\354\226\264 \354\235\264\354\240\204/\355\230\204\354\236\254 \355\206\265\355\231\224 \354\235\214\354\204\261 \355\214\214\354\235\274 \354\236\254\354\203\235 \352\270\260\353\212\245(`audio_url`)\352\263\274 AI STT \353\263\200\355\231\230 \354\212\244\355\201\254\353\246\275\355\212\270 \353\267\260\354\226\264 \355\203\221\354\236\254. \354\235\264\354\240\204 \355\206\265\355\231\224\354\227\220\354\204\234 \352\263\240\352\260\235\354\235\264 \354\232\224\352\265\254\355\225\234 \355\225\265\354\213\254 \354\202\254\355\225\255(\"\352\260\225\353\202\250\354\227\255 \352\267\274\354\262\230 SUV \354\236\220\353\246\254 \353\254\270\354\235\230\355\226\210\354\227\210\354\235\214\")\354\235\264 AI \354\232\224\354\225\275 \354\203\201\354\236\220\353\241\234 \354\236\220\353\217\231 \353\205\270\354\266\234\353\220\250.\n    - **\353\251\224\353\252\250/\355\205\215\354\212\244\355\212\270 \355\214\250\353\223\234**: \354\271\264\355\206\241 \353\260\217 \354\234\240\354\204\240 \354\235\221\353\214\200 \353\202\264\354\232\251\354\235\204 \354\213\244\354\213\234\352\260\204\354\234\274\353\241\234 \353\260\233\354\225\204 \354\240\201\353\212\224 \352\263\265\352\260\204. \354\203\201\353\213\264\354\233\220 \352\260\204 \354\213\240\354\206\215\355\225\234 \354\227\205\353\254\264 \354\235\264\352\264\200 \353\260\217 \354\232\224\354\262\255\354\235\204 \354\234\204\355\225\264