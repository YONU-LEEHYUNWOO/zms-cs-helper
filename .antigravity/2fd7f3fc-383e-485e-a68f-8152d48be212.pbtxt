        target_content: "export const CenterCustomerForm: React.FC<CenterCustomerFormProps> = ({\n  customer,\n  parkingSpots,\n  onChangeCustomerField,\n  onSelectRecommendedParking,\n}) => {\n  const [showRecommendation, setShowRecommendation] = useState(false);\n\n  const carTypes: CarType[] = [\n    \'\352\262\275\354\260\250\',\n    \'\354\206\214\355\230\225\354\204\270\353\213\250\',\n    \'\354\244\200\354\244\221\355\230\225\354\204\270\353\213\250\',\n    \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n    \'\353\214\200\355\230\225\354\204\270\353\213\250\',\n    \'SUV\',\n    \'RV\',\n  ];\n\n  // Match available parking spots that fit this customer\'s car_type\n  const matchedSpots = customer\n    ? parkingSpots.filter((spot) => spot.allowed_car_types.includes(customer.car_type))\n    : parkingSpots;\n\n  return (\n    <div className=\"bg-white dark:bg-[#0b1c30] rounded-xl border border-[#c5c5d8]/40 p-4 h-full shadow-sm flex flex-col overflow-y-auto\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-4 pb-2 border-b border-[#c5c5d8]/30\">\n        <h2 className=\"text-sm font-semibold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n          <Car className=\"w-4 h-4 text-[#000eba]\" />\n          Customer Profile (\352\263\240\352\260\235 \353\260\217 \354\260\250\353\237\211 \353\247\210\354\212\244\355\204\260)\n        </h2>\n        <span className=\"px-2 py-0.5 bg-[#e5eeff] text-[#000eba] text-[11px] font-bold rounded flex items-center gap-1\">\n          <ShieldCheck className=\"w-3.5 h-3.5 text-[#000eba]\" /> Verified DB\n        </span>\n      </div>\n\n      <form className=\"space-y-4 flex-1\">\n        {/* Contact Details */}\n        <div className=\"space-y-2\">\n          <h3 className=\"text-xs font-bold text-[#454555] uppercase tracking-wider\">\n            CONTACT DETAILS (\352\263\240\352\260\235 \354\227\260\353\235\275\354\262\230)\n          </h3>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-medium text-[#0b1c30] dark:text-gray-200 mb-1\">\n                Phone Number (\354\240\204\355\231\224\353\262\210\355\230\270)\n              </label>\n              <input\n                type=\"tel\"\n                value={customer ? formatPhoneNumber(customer.phone_number) : \'\'}\n                onChange={(e) => onChangeCustomerField(\'phone_number\', e.target.value)}\n                placeholder=\"010-1234-5678\"\n                className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg px-3 py-1.5 text-xs text-[#0b1c30] dark:text-white font-mono focus:ring-2 focus:ring-[#000eba]\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-[#0b1c30] dark:text-gray-200 mb-1\">\n                Account Email (\354\235\264\353\251\224\354\235\274)\n              </label>\n              <input\n                type=\"email\"\n                defaultValue=\"customer@example.com\"\n                className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg px-3 py-1.5 text-xs text-[#0b1c30] dark:text-white focus:ring-2 focus:ring-[#000eba]\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Primary Vehicle Info */}\n        <div className=\"space-y-2 pt-2 border-t border-[#c5c5d8]/30\">\n          <h3 className=\"text-xs font-bold text-[#454555] uppercase tracking-wider\">\n            PRIMARY VEHICLE (\354\260\250\353\237\211 \354\240\225\353\260\200 \354\204\270\353\266\204\355\231\224)\n          </h3>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-medium text-[#0b1c30] dark:text-gray-200 mb-1\">\n                License Plate (\354\260\250\353\237\211\353\262\210\355\230\270)\n              </label>\n              <input\n                type=\"text\"\n                value={customer?.car_number || \'\'}\n                onChange={(e) => onChangeCustomerField(\'car_number\', e.target.value)}\n                placeholder=\"12\352\260\2003456\"\n                className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg px-3 py-1.5 text-xs text-[#0b1c30] dark:text-white font-mono uppercase font-bold focus:ring-2 focus:ring-[#000eba]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-[#0b1c30] dark:text-gray-200 mb-1\">\n                Car Type (\354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230)\n              </label>\n              <div className=\"relative\">\n                <select\n                  value={customer?.car_type || \'\354\244\221\355\230\225\354\204\270\353\213\250\'}\n                  onChange={(e) => onChangeCustomerField(\'car_type\', e.target.value as CarType)}\n                  className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg pl-3 pr-8 py-1.5 text-xs text-[#0b1c30] dark:text-white appearance-none focus:ring-2 focus:ring-[#000eba] font-medium\"\n                >\n                  {carTypes.map((ct) => (\n                    <option key={ct} value={ct}>\n                      {ct}\n                    </option>\n                  ))}\n                </select>\n                <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400\" />\n              </div>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-medium text-[#0b1c30] dark:text-gray-200 mb-1\">\n              Detailed Model (\354\203\201\354\204\270 \354\260\250\354\242\205\353\252\205)\n            </label>\n            <input\n              type=\"text\"\n              value={customer?.car_detail || \'\'}\n              onChange={(e) => onChangeCustomerField(\'car_detail\', e.target.value)}\n              placeholder=\"\354\230\210: \354\217\230\353\202\230\355\203\200 DN8, \354\225\204\353\260\230\353\226\274 CN7, \355\214\260\353\246\254\354\204\270\354\235\264\353\223\234\"\n              className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg px-3 py-1.5 text-xs text-[#0b1c30] dark:text-white focus:ring-2 focus:ring-[#000eba]\"\n            />\n          </div>\n        </div>\n\n        {/* Payment Method / Bank Info */}\n        <div className=\"space-y-2 pt-2 border-t border-[#c5c5d8]/30\">\n          <h3 className=\"text-xs font-bold text-[#454555] uppercase tracking-wider\">\n            PAYMENT & REFUND BANK (\354\240\225\354\202\260 \353\260\217 \355\231\230\353\266\210 \352\263\204\354\242\214)\n          </h3>\n          <div className=\"bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg p-3 space-y-2\">\n            <div className=\"grid grid-cols-3 gap-2\">\n              <div>\n                <label className=\"text-[11px] text-gray-500 block mb-0.5\">\354\235\200\355\226\211\353\252\205</label>\n                <input\n                  type=\"text\"\n                  value={customer?.bank_name || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'bank_name\', e.target.value)}\n                  placeholder=\"\354\213\240\355\225\234\354\235\200\355\226\211\"\n                  className=\"w-full bg-white dark:bg-[#0b1c30] border border-[#c5c5d8]/30 rounded px-2 py-1 text-xs text-[#0b1c30] dark:text-white\"\n                />\n              </div>\n              <div className=\"col-span-2\">\n                <label className=\"text-[11px] text-gray-500 block mb-0.5\">\352\263\204\354\242\214\353\262\210\355\230\270</label>\n                <input\n                  type=\"text\"\n                  value={customer?.account_number || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'account_number\', e.target.value)}\n                  placeholder=\"110-123-456789\"\n                  className=\"w-full bg-white dark:bg-[#0b1c30] border border-[#c5c5d8]/30 rounded px-2 py-1 text-xs text-[#0b1c30] dark:text-white font-mono\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-[11px] text-gray-500 block mb-0.5\">\354\230\210\352\270\210\354\243\274\353\252\205</label>\n              <input\n                type=\"text\"\n                value={customer?.account_holder || \'\'}\n                onChange={(e) => onChangeCustomerField(\'account_holder\', e.target.value)}\n                placeholder=\"\355\231\215\352\270\270\353\217\231\"\n                className=\"w-full bg-white dark:bg-[#0b1c30] border border-[#c5c5d8]/30 rounded px-2 py-1 text-xs text-[#0b1c30] dark:text-white\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* AI Parking Match Auto-Recommend Button */}\n        <div className=\"pt-2\">\n          <button\n            type=\"button\"\n            onClick={() => setShowRecommendation(!showRecommendation)}\n            className=\"w-full py-2 px-3 rounded-xl bg-[#2532d8] hover:bg-[#000eba] text-white font-bold text-xs shadow flex items-center justify-center gap-2 transition-all\"\n          >\n            <Sparkles className=\"w-4 h-4 text-amber-300\" />\n            \354\236\220\354\202\254 \354\226\264\353\223\234\353\257\274 \354\227\260\353\217\231 \354\243\274\354\260\250\354\236\245 \353\247\244\353\254\274 \354\236\220\353\217\231 \354\266\224\354\262\234 ({matchedSpots.length}\352\261\264 \352\260\200\353\212\245)\n          </button>\n\n          {showRecommendation && (\n            <div className=\"mt-2 p-3 bg-[#e5eeff] dark:bg-[#213145] rounded-xl border border-[#c5c5d8]/40 space-y-2\">\n              <div className=\"text-xs font-bold text-[#000eba] dark:text-[#bec2ff] flex items-center gap-1\">\n                <Building className=\"w