on State\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer>(INITIAL_CUSTOMERS[0]);\n  const [currentAgentName, setCurrentAgentName] = useState<string>(\'\352\271\200\354\262\240\354\210\230\');\n  const [notes, setNotes] = useState<string>(\n    \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245 \354\260\250\353\213\250\352\270\260 \353\257\270\354\235\270\354\213\235 \353\254\270\354\235\230\353\241\234 \354\233\220\352\262\251 \352\260\234\353\260\251 \354\262\230\353\246\254 \354\231\204\353\243\214\355\225\250. \354\266\234\354\260\250 \353\252\250\353\213\210\355\204\260\353\247\201 \354\230\210\354\240\225.\'\n  );\n\n  // Active consultation tied to selected customer with robust draft fallback\n  const activeConsultation: Consultation =\n    consultations.find(\n      (c) => c.customer_id === selectedCustomer.id && c.status !== \'\354\231\204\353\243\214\'\n    ) ||\n    consultations.find((c) => c.customer_id === selectedCustomer.id) || {\n      id: `draft-${selectedCustomer.id}`,\n      customer_id: selectedCustomer.id,\n      car_number: selectedCustomer.car_number,\n      phone_number: selectedCustomer.phone_number,\n      user_type: \'\354\202\254\354\232\251\354\236\220\',\n      parking_type: \'\354\235\274\354\243\274\354\260\250\',\n      parking_name: \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n      inquiry_type: \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n      status: \'\354\240\221\354\210\230\',\n      sub_status: \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n      agent_name: currentAgentName,\n      summary: notes,\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n\n  const activeCallLog =\n    callLogs.find((cl) => cl.customer_id === selectedCustomer.id) || callLogs[0];\n\n  // Load live CTI logs on boot\n  useEffect(() => {\n    fetchCTICallLogs().then((logs) => {\n      if (logs && logs.length > 0) {\n        setCallLogs((prev) => [...logs, ...prev]);\n      }\n    });\n  }, []);\n\n  // Handlers for Workspace\n  const handleUpdateCustomerField = (field: keyof Customer, value: any) => {\n    setCustomers((prev) => {\n      const exists = prev.some((c) => c.id === selectedCustomer.id);\n      if (exists) {\n        return prev.map((c) => (c.id === selectedCustomer.id ? { ...c, [field]: value } : c));\n      }\n      return [{ ...selectedCustomer, [field]: value }, ...prev];\n    });\n    setSelectedCustomer((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const handleResetForm = () => {\n    const freshCustomer: Customer = {\n      id: `cust-${Date.now()}`,\n      phone_number: \'\',\n      car_number: \'\',\n      car_type: \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n      car_detail: \'\',\n      bank_name: \'\',\n      account_number: \'\',\n      account_holder: \'\',\n      is_blacklist: false,\n      special_note: \'\',\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n    setSelectedCustomer(freshCustomer);\n    setNotes(\'\');\n  };\n\n  const handleSaveLog = (summaryText: string) => {\n    const updatedSummary = summaryText || notes || \'\354\203\201\353\213\264 \353\202\264\354\232\251 \352\270\260\353\241\235 \354\231\204\353\243\214\';\n\n    // Snapshot customer identifiers\n    const customerId = selectedCustomer.id || `cust-${Date.now()}`;\n    const phone = selectedCustomer.phone_number || \'\';\n    const carNum = selectedCustomer.car_number || \'\';\n\n    // Register or update customer record in DB state\n    const customerRecord: Customer = {\n      ...selectedCustomer,\n      id: customerId,\n      phone_number: phone,\n      car_number: carNum,\n      updated_at: new Date().toISOString(),\n    };\n\n    setCustomers((prev) => {\n      const idx = prev.findIndex((c) => c.id === customerId);\n      if (idx !== -1) {\n        return prev.map((c, i) => (i === idx ? customerRecord : c));\n      }\n      return [customerRecord, ...prev];\n    });\n\n    // ALWAYS create a NEW unique Consultation record in DB\n    const newConsId = `cons-${Date.now()}-${Math.floor(Math.random() * 1000)}`;\n    const newConsultation: Consultation = {\n      id: newConsId,\n      customer_id: customerId,\n      car_number: carNum,\n      phone_number: phone,\n      user_type: selectedCustomer.user_type as any || \'\354\202\254\354\232\251\354\236\220\',\n      parking_type: \'\354\235\274\354\243\274\354\260\250\',\n      parking_name: activeConsultation?.parking_name || \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n      inquiry_type: activeConsultation?.inquiry_type || \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n      status: activeConsultation?.status || \'\354\234\240\354\204\240 \353\266\200\354\204\234 \355\231\225\354\235\270 \354\244\221\',\n      sub_status: activeConsultation?.sub_status || \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n      agent_name: currentAgentName,\n      summary: updatedSummary,\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n      is_archived: false,\n    };\n\n    setConsultations((prev) => [newConsultation, ...prev]);\n\n    // Reset Form Input State for next customer call\n    const nextCustomer: Customer = {\n      id: `cust-${Date.now() + 1}`,\n      phone_number: \'\',\n      car_number: \'\',\n      car_type: \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n      car_detail: \'\',\n      bank_name: \'\',\n      account_number: \'\',\n      account_holder: \'\',\n      is_blacklist: false,\n      special_note: \'\',\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n\n    setSelectedCustomer(nextCustomer);\n    setNotes(\'\');\n  };\n\n  const handleChangeStatus = (newStatus: ConsultationStatus, subStatusReason?: string) => {\n    setConsultations((prev) => {\n      const targetIndex = prev.findIndex((c) => c.id === activeConsultation?.id);\n      if (targetIndex !== -1) {\n        return prev.map((c, idx) =>\n          idx === targetIndex\n            ? {\n                ...c,\n                status: newStatus,\n                sub_status: subStatusReason !== undefined ? subStatusReason : c.sub_status,\n                updated_at: new Date().toISOString(),\n              }\n            : c\n        );\n      }\n      return prev;\n    });\n  };"
      replacement_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { SideNavBar } from \'./components/SideNavBar\';\nimport { TopNavBar } from \'./components/TopNavBar\';\nimport { LeftInteractionPad } from \'./components/workspace/LeftInteractionPad\';\nimport { MainConsultationHub } from \'./components/workspace/MainConsultationHub\';\nimport { CalendarView } from \'./components/calendar/CalendarView\';\nimport { KanbanBoardView } from \'./components/kanban/KanbanBoardView\';\nimport { AdminPanel } from \'./components/admin/AdminPanel\';\nimport { LogsArchiveView } from \'./components/logs/LogsArchiveView\';\nimport { SupportAiKms } from \'./components/support/SupportAiKms\';\n\nimport {\n  Customer,\n  InternalAgent,\n  SavedTemplate,\n  CallLog,\n  Consultation,\n  AgentTask,\n  ParkingSpot,\n  ConsultationStatus,\n} from \'./types\';\n\nimport {\n  INITIAL_AGENTS,\n  INITIAL_TEMPLATES,\n  INITIAL_CUSTOMERS,\n  INITIAL_CALL_LOGS,\n  INITIAL_CONSULTATIONS,\n  INITIAL_TASKS,\n  INITIAL_PARKING_SPOTS,\n} from \'./lib/mockData\';\n\nimport { takeoverConsultation } from \'./lib/services/customerService\';\nimport { fetchCTICallLogs } from \'./lib/services/sttService\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\n    \'workspace\' | \'calendar\' | \'kanban\' | \'admin\' | \'logs\' | \'support\'\n  >(\'workspace\');\n\n  // Master State Databases\n  const [customers, setCustomers] = useState<Customer[]>(INITIAL_CUSTOMERS);\n  const [agents, setAgents] = useState<InternalAgent[]>(INITIAL_AGENTS);\n  const [templates, setTemplates] = useState<SavedTemplate[]>(INITIAL_TEMPLATES);\n  const [callLogs, setCallLogs] = useState<CallLog[]>(INITIAL_CALL_LOGS);\n  const [consultations, setConsultations] = useState<Consultation[]>(INITIAL_CONSULTATIONS);\n  const [tasks, setTasks] = useState<AgentTask[]>(INITIAL_TASKS);\n  const [parkingSpots] = useState<ParkingSpot[]>(INITIAL_PARKING_SPOTS);\n\n  // Active Workspace Selection State\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer>(INITIAL_CUSTOMERS[0]);\n  const [selectedConsultationId, setSelectedConsultationId] = useState<string | null>(null);\n  const [currentAgentName, setCurrentAgentName] = useState<string>(\'\352\271\200\354\262\240\354\210\230\');\n  const [notes, setNotes] = useState<string>(\n    \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245 \354\260\250\353\213\250\352\270\260 \353\257\270\354\235\270\354\213\235 \353\254\270\354\235\230\353\241\234 \354\233\220\352\262\251 \352\260\234\353\260\251 \354\262\230\353\246\254 \354\231\204\353\243\214\355\225\250. \354\266\234\354\260\250 \353\252\250\353\213\210\355\204\260\353\247\201 \354\230\210\354\240\225.\'\n  );\n\n  // Active consultation tied to selected consultation ID or customer with robust fallback\n  const activeConsultation: Consultation = useMemo(() => {\n    if (selectedConsultationId) {\n      const found = consultations.find((c) => c.id === selectedConsultationId);\n      if (found) return found;\n    }\n    const byCust =\n      consultations.find((c) => c.customer_id === selectedCustomer.id && c.status !== \'\354\231\204\353\243\214\') ||\n      consultations.find((c) => c.customer_id === selectedCustomer.id);\n    if (byCust) return byCust;\n\n    return {\n      id: `draft-${selectedCustomer.id}`,\n      customer_id: selectedCustomer.id,\n      car_number: selectedCustomer.car_number,\n      phone_number: selectedCustomer.phone_number,\n      user_type: (selectedCustomer.user_type as any) || \'\354\202\254\354\232\251\354\236\220\',\n      parking_type: \'\354\235\274\354\243\274\354\260\250\',\n      parking_name: \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n      inquiry_type: \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n      status: \'\354\240\221\354\210\230\',\n      sub_status: \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n      agent_name: currentAgentName,\n      summary: notes,\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n  }, [selectedConsultationId, consultations, selectedCustomer, currentAgentName, notes]);\n\n  const isExistingConsultation = useMemo(() => {\n    return consultations.some((c) => c.id === activeConsultation?.id);\n  }, [consultations, activeConsultation]);\n\n  const activeCallLog =\n    callLogs.find((cl) => cl.customer_id === selectedCustomer.id) || callLogs[0];\n\n  // Load live CTI logs on boot\n  useEffect(() => {\n    fetchCTICallLogs().then((logs) => {\n      if (logs && logs.length > 0) {\n        setCallLogs((prev) => [...logs, ...prev]);\n      }\n    });\n  }, []);\n\n  // Handlers for Workspace\n  const handleUpdateCustomerField = (field: keyof Customer, value: any) => {\n    setCustomers((prev) => {\n      const exists = prev.some((c) => c.id === selectedCustomer.id);\n      if (exists) {\n        return prev.map((c) => (c.id === selectedCustomer.id ? { ...c, [field]: value } : c));\n      }\n      return [{ ...selectedCustomer, [field]: value }, ...prev];\n    });\n    setSelectedCustomer((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const handleSelectConsultation = (consId: string) => {\n    const target = consultations.find((c) => c.id === consId);\n    if (target) {\n      setSelectedConsultationId(consId);\n      setNotes(target.summary || \'\');\n\n      // Sync customer\n      const matchingCust =\n        customers.find((c) => c.id === target.customer_id) ||\n        customers.find((c) => c.car_number && c.car_number === target.car_number) ||\n        customers.find((c) => c.phone_number && c.phone_number === target.phone_number);\n\n      if (matchingCust) {\n        setSelectedCustomer(matchingCust);\n      } else {\n        setSelectedCustomer({\n          id: target.customer_id || `cust-${Date.now()}`,\n          phone_number: target.phone_number || \'\',\n          car_number: target.car_number || \'\',\n          car_type: \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n          car_detail: \'\',\n          bank_name: \'\',\n          account_number: \'\',\n          account_holder: \'\',\n          is_blacklist: false,\n          special_note: \'\',\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString(),\n        });\n      }\n\n      setActiveTab(\'workspace\');\n    }\n  };\n\n  const handleStartNewConsultation = () => {\n    setSelectedConsultationId(null);\n    setNotes(\'\');\n  };\n\n  const handleResetForm = () => {\n    setSelectedConsultationId(null);\n    const freshCustomer: Customer = {\n      id: `cust-${Date.now()}`,\n      phone_number: \'\',\n      car_number: \'\',\n      car_type: \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n      car_detail: \'\',\n      bank_name: \'\',\n      account_number: \'\',\n      account_holder: \'\',\n      is_blacklist: false,\n      special_note: \'\',\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n    setSelectedCustomer(freshCustomer);\n    setNotes(\'\');\n  };\n\n  const handleSaveLog = (summaryText: string) => {\n    const updatedSummary = summaryText || notes || \'\354\203\201\353\213\264 \353\202\264\354\232\251 \352\270\260\353\241\235 \354\231\204\353\243\214\';\n\n    // Snapshot customer identifiers\n    const customerId = selectedCustomer.id || `cust-${Date.now()}`;\n    const phone = selectedCustomer.phone_number || \'\';\n    const carNum = selectedCustomer.car_number || \'\';\n\n    // Register or update customer record in DB state\n    const customerRecord: Customer = {\n      ...selectedCustomer,\n      id: customerId,\n      phone_number: phone,\n      car_number: carNum,\n      updated_at: new Date().toISOString(),\n    };\n\n    setCustomers((prev) => {\n      const idx = prev.findIndex((c) => c.id === customerId);\n      if (idx !== -1) {\n        return prev.map((c, i) => (i === idx ? customerRecord : c));\n      }\n      return [customerRecord, ...prev];\n    });\n\n    // Check if active consultation exists in DB\n    const existingIndex = consultations.findIndex((c) => c.id === activeConsultation?.id);\n\n    if (existingIndex !== -1) {\n      // UPDATE EXISTING CONSULTATION\n      setConsultations((prev) =>\n        prev.map((c, idx) =>\n          idx === existingIndex\n            ? {\n                ...c,\n                car_number: carNum || c.car_number,\n                phone_number: phone || c.phone_number,\n                parking_name: activeConsultation.parking_name,\n                inquiry_type: activeConsultation.inquiry_type,\n                status: activeConsultation.status,\n                sub_status: activeConsultation.sub_status,\n                agent_name: currentAgentName,\n                summary: updatedSummary,\n                updated_at: new Date().toISOString(),\n              }\n            : c\n        )\n      );\n    } else {\n      // CREATE NEW CONSULTATION\n      const newConsId = `cons-${Date.now()}-${Math.floor(Math.random() * 1000)}`;\n      const newConsultation: Consultation = {\n        id: newConsId,\n        customer_id: customerId,\n        car_number: carNum,\n        phone_number: phone,\n        user_type: (selectedCustomer.user_type as any) || \'\354\202\254\354\232\251\354\236\220\',\n        parking_type: \'\354\235\274\354\243\274\354\260\250\',\n        parking_name: activeConsultation?.parking_name || \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n        inquiry_type: activeConsultation?.inquiry_type || \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n        status: activeConsultation?.status || \'\354\240\221\354\210\230\',\n        sub_status: activeConsultation?.sub_status || \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n        agent_name: currentAgentName,\n        summary: updatedSummary,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n        is_archived: false,\n      };\n\n      setConsultations((prev) => [newConsultation, ...prev]);\n      setSelectedConsultationId(newConsId);\n    }\n  };\n\n  const handleChangeStatus = (newStatus: ConsultationStatus, subStatusReason?: string) => {\n    setConsultations((prev) => {\n      const targetIndex = prev.findIndex((c) => c.id === activeConsultation?.id);\n\n      if (targetIndex !== -1) {\n        // Existing consultation in consultations array: update directly\n        return prev.map((c, idx) =>\n          idx === targetIndex\n            ? {\n                ...c,\n                status: newStatus,\n                sub_status: subStatusReason !== undefined ? subStatusReason : c.sub_status,\n                updated_at: new Date().toISOString(),\n              }\n            : c\n        );\n      } else {\n        // Draft consultation not yet saved in array: insert it so status and sub_status update smoothly\n        const newDraftCons: Consultation = {\n          ...activeConsultation,\n          status: newStatus,\n          sub_status: subStatusReason !== undefined ? subStatusReason : activeConsultation?.sub_status || \'\',\n          agent_name: currentAgentName,\n          summary: notes,\n          updated_at: new Date().toISOString(),\n        };\n        setSelectedConsultationId(newDraftCons.id);\n        return [newDraftCons, ...prev];\n      }\n    });\n  };"
