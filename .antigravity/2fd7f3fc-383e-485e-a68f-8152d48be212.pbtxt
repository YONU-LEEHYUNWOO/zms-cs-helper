    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, UserCheck, AlertTriangle, Phone, Car, Clock, ShieldAlert, ArrowRight } from \'lucide-react\';\nimport { Customer, Consultation } from \'../../types\';\nimport { normalizePhoneNumber, normalizeCarNumber, formatPhoneNumber } from \'../../lib/utils/normalize\';\n\ninterface HeaderSearchBarProps {\n  customers: Customer[];\n  consultations: Consultation[];\n  currentAgentName: string;\n  onSelectCustomer: (cust: Customer) => void;\n  onTakeoverConsultation: (consultationId: string) => void;\n}\n\nexport const HeaderSearchBar: React.FC<HeaderSearchBarProps> = ({\n  customers,\n  consultations,\n  currentAgentName,\n  onSelectCustomer,\n  onTakeoverConsultation,\n}) => {\n  const [query, setQuery] = useState(\'\');\n  const [isOpen, setIsOpen] = useState(false);\n  const [selectedCustForModal, setSelectedCustForModal] = useState<Customer | null>(null);\n\n  const cleanQuery = query.trim();\n  const normPhoneQuery = normalizePhoneNumber(cleanQuery);\n  const normCarQuery = normalizeCarNumber(cleanQuery);\n\n  // Search logic matching normalized values\n  const matchingCustomers = cleanQuery\n    ? customers.filter((c) => {\n        const cPhone = normalizePhoneNumber(c.phone_number);\n        const cCar = normalizeCarNumber(c.car_number);\n        return (\n          (normPhoneQuery.length >= 3 && cPhone.includes(normPhoneQuery)) ||\n          (normCarQuery.length >= 2 && cCar.includes(normCarQuery)) ||\n          c.phone_number.includes(cleanQuery) ||\n          c.car_number.includes(cleanQuery)\n        );\n      })\n    : [];\n\n  return (\n    <div className=\"relative w-full max-w-md\">\n      {/* Search Input Box */}\n      <div className=\"relative flex items-center\">\n        <Search className=\"w-4 h-4 absolute left-3 text-[#454555]\" />\n        <input\n          type=\"text\"\n          value={query}\n          onChange={(e) => {\n            setQuery(e.target.value);\n            setIsOpen(true);\n          }}\n          onFocus={() => setIsOpen(true)}\n          placeholder=\"\354\260\250\353\237\211\353\262\210\355\230\270 (12\352\260\2003456) \353\230\220\353\212\224 \354\240\204\355\231\224\353\262\210\355\230\270 (010-1234-5678) \352\262\200\354\203\211...\"\n          className=\"w-full pl-9 pr-8 py-1.5 bg-[#e5eeff] dark:bg-[#213145] rounded-full border-none text-xs text-[#0b1c30] dark:text-white focus:ring-2 focus:ring-[#000eba] focus:bg-white dark:focus:bg-[#0b1c30] transition-all placeholder:text-[#454555]\"\n        />\n        {query && (\n          <button\n            onClick={() => {\n              setQuery(\'\');\n              setIsOpen(false);\n            }}\n            className=\"absolute right-3 text-xs text-gray-400 hover:text-gray-600\"\n          >\n            \342\234\225\n          </button>\n        )}\n      </div>\n\n      {/* Live Matching Dropdown */}\n      {isOpen && cleanQuery && (\n        <div className=\"absolute left-0 right-0 top-full mt-1 bg-white dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-xl shadow-xl z-50 overflow-hidden max-h-96 overflow-y-auto\">\n          <div className=\"p-2 bg-[#f8f9ff] dark:bg-[#0b1c30] border-b border-[#c5c5d8]/30 flex justify-between items-center text-[11px] text-[#454555]\">\n            <span>\352\262\200\354\203\211 \352\262\260\352\263\274 ({matchingCustomers.length}\352\261\264)</span>\n            <span className=\"font-mono text-[10px] text-[#000eba]\">\354\240\225\352\267\234\355\231\224 \354\236\220\353\217\231 \353\247\244\354\271\255</span>\n          </div>\n\n          {matchingCustomers.length === 0 ? (\n            <div className=\"p-4 text-center text-xs text-[#454555]\">\n              \353\247\244\354\271\255\353\220\230\353\212\224 \352\263\240\352\260\235 \354\240\225\353\263\264\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244. (\354\240\204\355\231\224/\354\260\250\353\237\211\353\262\210\355\230\270 \353\214\200\354\213\234 \354\227\206\354\235\264 \354\236\205\353\240\245 \352\260\200\353\212\245)\n            </div>\n          ) : (\n            matchingCustomers.map((cust) => {\n              const activeCons = consultations.find(\n                (c) => c.customer_id === cust.id && c.status !== \'\354\231\204\353\243\214\'\n              ) || consultations.find((c) => c.customer_id === cust.id);\n\n              return (\n                <div\n                  key={cust.id}\n                  onClick={() => {\n                    onSelectCustomer(cust);\n                    setSelectedCustForModal(cust);\n                    setIsOpen(false);\n                  }}\n                  className=\"p-3 border-b border-[#c5c5d8]/20 hover:bg-[#e5eeff]/50 dark:hover:bg-[#1926d1]/20 cursor-pointer transition-colors\"\n                >\n                  <div className=\"flex items-center justify-between mb-1\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-mono font-bold text-xs text-[#000eba] dark:text-[#bec2ff]\">\n                        {cust.car_number}\n                      </span>\n                      <span className=\"text-xs text-[#0b1c30] dark:text-white\">\n                        {formatPhoneNumber(cust.phone_number)}\n                      </span>\n                      <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300\">\n                        {cust.car_type} {cust.car_detail || \'\'}\n                      </span>\n                    </div>\n\n                    {cust.is_blacklist && (\n                      <span className=\"px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-bold text-[10px] flex items-center gap-1 animate-pulse\">\n                        <AlertTriangle className=\"w-3 h-3\" />\n                        \353\270\224\353\236\231\353\246\254\354\212\244\355\212\270\n                      </span>\n                    )}\n                  </div>\n\n                  {activeCons && (\n                    <div className=\"flex items-center justify-between text-[11px] mt-1 pt-1 border-t border-dashed border-gray-200\">\n                      <div className=\"flex items-center gap-1.5\">\n                        <span className=\"px-1.5 py-0.5 rounded bg-[#000eba]/10 text-[#000eba] font-semibold\">\n                          \353\213\264\353\213\271: {activeCons.agent_name}\n                        </span>\n                        <span className=\"px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800\">\n                          {activeCons.status} ({activeCons.sub_status || \'\354\235\274\353\260\230\'})\n                        </span>\n                      </div>\n                      <span className=\"text-[10px] text-gray-400 flex items-center gap-0.5\">\n                        <Clock className=\"w-3 h-3\" /> {activeCons.updated_at.slice(5, 16).replace(\'T\', \' \')}\n                      </span>\n                    </div>\n                  )}\n                </div>\n              );\n            })\n          )}\n        </div>\n      )}\n\n      {/* Customer Timeline Modal Preview */}\n      {selectedCustForModal && (\n        <CustomerTimelineModal\n          customer={selectedCustForModal}\n          consultations={consultations.filter((c) => c.customer_id === selectedCustForModal.id)}\n          currentAgentName={currentAgentName}\n          onClose={() => setSelectedCustForModal(null)}\n          onTakeover={(consId) => {\n            onTakeoverConsultation(consId);\n            setSelectedCustForModal(null);\n          }}\n        />\n      )}\n    </div>\n  );\n};\n\ninterface CustomerTimelineModalProps {\n  customer: Customer;\n  consultations: Consultation[];\n  currentAgentName: string;\n  onClose: () => void;\n  onTakeover: (consId: string) => void;\n}\n\nconst CustomerTimelineModal: React.FC<CustomerTimelineModalProps> = ({\n  customer,\n  consultations,\n  currentAgentName,\n  onClose,\n  onTakeover,\n}) => {\n  const activeCons = consultations.find((c) => c.status !== \'\354\231\204\353\243\214\') || consultations[0];\n\n  return (\n    <div className=\"fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white dark:bg-[#0b1c30] rounded-2xl shadow-2xl max-w-2xl w-full border border-[#c5c5d8]/40 overflow-hidden flex flex-col max-h-[85vh]\">\n        {/* Modal Header */}\n        <div className=\"p-4 bg-[#f8f9ff] dark:bg-[#213145] border-b border-[#c5c5d8]/40 flex justify-between items-center\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h3 className=\"font-bold text-lg text-[#0b1c30] dark:text-white\">\n                \354\260\250\353\237\211\353\262\210\355\230\270: {customer.car_number}\n              </h3>\n              <span className=\"text-xs px-2 py-0.5 rounded bg-[#e5eeff] text-[#000eba] font-semibold\">\n                {customer.car_type} ({customer.car_detail || \'\354\203\201\354\204\270 \353\257\270\354\247\200\354\240\225\'})\n              </span>\n            </div>\n            <p className=\"text-xs text-[#454555] font-mono\">\n              \354\240\204\355\231\224\353\262\210\355\230\270: {formatPhoneNumber(customer.phone_number)}\n            </p>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-200 flex items-center justify-center hover:bg-gray-300\"\n          >\n            \342\234\225\n          </button>\n        </div>\n\n        {/* Status Badges Banner */}\n        <div className=\"p-4 bg-emerald-50/50 dark:bg-emerald-950/20 border-b border-emerald-200/50 flex flex-wrap gap-2 items-center justify-between\">\n          <div className=\"flex flex-wrap gap-2 items-center\">\n            {activeCons && (\n              <>\n                <span className=\"px-2.5 py-1 rounded-full bg-[#2532d8] text-white text-xs font-bold flex items-center gap-1\">\n                  <UserCheck className=\"w-3.5 h-3.5\" />\n                  \355\230\204\354\236\254 \353\213\264\353\213\271\354\236\220: {activeCons.agent_name}\n                </span>\n\n                <span className=\"px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-semibold\">\n                  \354\247\204\354\262\231\353\217\204: {activeCons.status} ({activeCons.sub_status || \'\354\235\221\353\214\200\354\244\221\'})\n                </span>\n              </>\n            )}\n\n            {customer.is_blacklist && (\n              <span className=\"px-2.5 py-1 rounded-full bg-red-600 text-white text-xs font-bold flex items-center gap-1 animate-pulse\">\n                <ShieldAlert className=\"w-3.5 h-3.5\" />\360\237\224\264 \354\243\274\354\235\230: \354\203\201\354\212\265 \353\266\200\354\240\225\354\243\274\354\260\250/\355\201\264\353\240\210\354\236\204 \354\234\240\354\240\200\n              </span>\n            )}\n          </div>\n\n          {activeCons && activeCons.agent_name !== currentAgentName && (\n            <button\n              onClick={() => onTakeover(activeCons.id)}\n              className=\"px-3 py-1.5 rounded-lg bg-[#000eba] hover:bg-[#2532d8] text-white text-xs font-bold shadow transition-all flex items-center gap-1\"\n            >\n              [\353\202\264\352\260\200 \354\235\264\354\226\264\353\260\233\352\270\260] <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {/* Special Note Box if any */}\n        {customer.special_note && (\n          <div className=\"p-3 mx-4 mt-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 text-amber-900 dark:text-amber-200 text-xs\">\n            <span className=\"font-bold\">\360\237\223\214 \355\212\271\354\235\264\354\202\254\355\225\255 \353\260\217 \354\232\224\354\243\274\354\235\230 \353\251\224\353\252\250:</span> {customer.special_note}\n          </div>\n        )}\n\n        {/* Timeline List */}\n        <div className=\"p-4 flex-1 overflow-y-auto space-y-4\">\n          <h4 className=\"text-xs font-bold text-[#454555] uppercase tracking-wider\">\n            \355\206\265\355\231\224 \353\260\217 \354\203\201\353\213\264 \354\235\264\353\240\245 \355\203\200\354\236\204\353\235\274\354\235\270 ({consultations.length}\352\261\264)\n          </h4>\n\n          {consultations.length === 0 ? (\n            <p className=\"text-xs text-gray-400 py-6 text-center\">\353\223\261\353\241\235\353\220\234 \352\263\274\352\261\260 \354\203\201\353\213\264 \352\270\260\353\241\235\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.</p>\n          ) : (\n            consultations.map((c) => (\n              <div\n                key={c.id}\n                className=\"p-3.5 rounded-xl bg-[#f8f9ff] dark:bg-[#1926d1]/10 border border-[#c5c5d8]/40 space-y-2\"\n              >\n                <div className=\"flex justify-between items-center text-xs\">\n                  <span className=\"font-bold text-[#000eba] dark:text-[#bec2ff]\">\n                    [{c.created_at.slice(0, 10)}] {c.agent_name} \354\203\201\353\213\264\354\233\220\n                  </span>\n                  <span className=\"px-2 py-0.5 rounded bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-200 text-[11px]\">\n                    {c.inquiry_type} / {c.parking_name || \'\354\243\274\354\260\250\354\236\245 \353\257\270\354\247\200\354\240\225\'}\n                  </span>\n                </div>\n\n                <p className=\"text-xs text-[#0b1c30] dark:text-gray-200 bg-white dark:bg-[#0b1c30] p-2.5 rounded-lg border border-gray-100 dark:border-gray-800\">\n                  {c.summary}\n                </p>\n\n                {c.sub_status && (\n                  <p className=\"text-[11px] text-emerald-600 dark:text-emerald-400 font-medium\">\n                    \342\206\263 \354\247\204\355\226\211 \354\204\270\353\266\200: {c.sub_status}\n                  </p>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-3 bg-[#f8f9ff] dark:bg-[#213145] border-t border-[#c5c5d8]/40 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 rounded-lg bg-gray-200 dark:bg-gray-700 text-xs font-semibold text-gray-800 dark:text-gray-200 hover:bg-gray-300\"\n          >\n            \353\213\253\352\270\260\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
