        target_content: "import React, { useState, useEffect } from \'react\';\nimport { SideNavBar } from \'./components/SideNavBar\';\nimport { TopNavBar } from \'./components/TopNavBar\';\nimport { LeftInteractionPad } from \'./components/workspace/LeftInteractionPad\';\nimport { MainConsultationHub } from \'./components/workspace/MainConsultationHub\';\nimport { CalendarView } from \'./components/calendar/CalendarView\';\nimport { KanbanBoardView } from \'./components/kanban/KanbanBoardView\';\nimport { AdminPanel } from \'./components/admin/AdminPanel\';\nimport { LogsArchiveView } from \'./components/logs/LogsArchiveView\';\nimport { SupportAiKms } from \'./components/support/SupportAiKms\';\n\nimport {\n  Customer,\n  InternalAgent,\n  SavedTemplate,\n  CallLog,\n  Consultation,\n  AgentTask,\n  ParkingSpot,\n  ConsultationStatus,\n} from \'./types\';\n\nimport {\n  INITIAL_AGENTS,\n  INITIAL_TEMPLATES,\n  INITIAL_CUSTOMERS,\n  INITIAL_CALL_LOGS,\n  INITIAL_CONSULTATIONS,\n  INITIAL_TASKS,\n  INITIAL_PARKING_SPOTS,\n} from \'./lib/mockData\';\n\nimport { takeoverConsultation } from \'./lib/services/customerService\';\nimport { fetchCTICallLogs } from \'./lib/services/sttService\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\n    \'workspace\' | \'calendar\' | \'kanban\' | \'admin\' | \'logs\' | \'support\'\n  >(\'workspace\');\n\n  // Master State Databases\n  const [customers, setCustomers] = useState<Customer[]>(INITIAL_CUSTOMERS);\n  const [agents, setAgents] = useState<InternalAgent[]>(INITIAL_AGENTS);\n  const [templates, setTemplates] = useState<SavedTemplate[]>(INITIAL_TEMPLATES);\n  const [callLogs, setCallLogs] = useState<CallLog[]>(INITIAL_CALL_LOGS);\n  const [consultations, setConsultations] = useState<Consultation[]>(INITIAL_CONSULTATIONS);\n  const [tasks, setTasks] = useState<AgentTask[]>(INITIAL_TASKS);\n  const [parkingSpots] = useState<ParkingSpot[]>(INITIAL_PARKING_SPOTS);\n\n  // Active Workspace Selec