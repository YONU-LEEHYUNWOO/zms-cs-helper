                   </p>\n\n                      {/* Sub-status Badge */}\n                      {cons.sub_status && (\n                        <p className=\"text-[11px] text-emerald-700 font-bold bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200 flex items-center gap-1\">\n                          <span>\342\206\263 \354\203\201\354\204\270 \354\202\254\354\234\240:</span> {cons.sub_status}\n                        </p>\n                      )}\n\n                      {/* Footer: Agent & Column Movement */}\n                      <div className=\"pt-2 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-500\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"flex items-center gap-1 font-semibold text-slate-700\">\n                            <User className=\"w-3 h-3 text-blue-600\" /> {cons.agent_name}\n                          </span>\n                          {cons.created_at && (\n                            <span className=\"text-slate-400 font-mono\">\n                              {cons.created_at.slice(11, 16)}\n                            </span>\n                          )}\n                        </div>\n\n                        {/* Column Transition Buttons */}\n                        <div className=\"flex gap-1\">\n                          {columns.indexOf(colStatus) > 0 && (\n                            <button\n                              onClick={() =>\n                                onUpdateStatus(\n                                  cons.id,\n                                  columns[columns.indexOf(colStatus) - 1]\n                                )\n                              }\n                              title=\"\354\235\264\354\240\204 \353\213\250\352\263\204\353\241\234 \354\235\264\353\217\231\"\n                              className=\"p-1 hover:bg-slate-100 rounded text-slate-600 transition-colors border border-sl