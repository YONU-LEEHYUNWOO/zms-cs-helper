  user_input {
    user_response: "\354\230\244\354\274\200\354\235\264 \354\210\230\354\240\225 \354\236\230 \353\220\230\353\212\224\352\261\260 \353\204\210\353\254\264 \354\242\213\352\263\240 \354\213\240\352\267\234 \354\236\205\353\240\245 \354\264\210\352\270\260\355\231\224\352\260\200 \353\224\224\355\217\264\355\212\270 \352\260\222\354\235\264 \353\220\230\352\262\214 \355\225\264\354\244\230 \n\352\267\270\353\203\245 \353\262\210\355\230\270\353\247\214 \355\201\264\353\246\255\355\226\210\354\235\204\353\225\214 DB\354\227\220 \352\270\260\354\241\264 \353\202\264\354\227\255\354\235\264 \354\236\210\354\234\274\353\251\264 \352\267\270 \353\202\264\354\227\255\354\235\264 \355\231\225\354\235\270\354\235\264 \353\220\230\352\263\240 \n\354\203\210\353\241\234\354\232\264 \353\262\210\355\230\270\353\251\264 \354\203\210\353\241\234 \354\236\205\353\240\245\354\235\264 \352\260\200\353\212\245\355\225\230\352\262\214 \n\n\352\267\270\353\246\254\352\263\240 \354\260\250\353\237\211\353\262\210\355\230\270, \354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230, \354\260\250\354\242\205\353\252\205\354\227\220 \352\270\260\353\263\270\352\260\222\354\234\274\353\241\234 \353\271\210\354\271\270\354\234\274\353\241\234\353\217\204 \354\240\200\354\236\245\354\235\264 \353\220\230\352\262\214\355\225\264 \354\244\230\n(\354\225\204\354\247\201 \355\231\225\354\235\270\354\240\204\354\235\264\352\261\260\353\202\230 \355\231\225\354\235\270\354\235\264 \354\225\210\353\220\234 \354\203\201\355\231\251\354\227\220 \353\251\224\353\252\250\353\245\274 \355\225\240\354\210\230\353\217\204 \354\236\210\354\234\274\353\213\210)\n\352\267\270\353\246\254\352\263\240 \354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230\354\227\220 \355\231\224\353\254\274\354\260\250 (1T \355\203\221\354\260\250) / \355\231\224\353\254\274\354\260\250 (1T \354\235\264\355\225\230) , \352\270\260\355\203\200 \354\260\250\353\237\211(\354\236\205\353\240\245\354\235\264 \352\260\200\353\212\245\355\225\230\352\262\214 \354\204\244\354\240\225) \354\234\274\353\241\234 \354\210\230\354\240\225\355\225\264\354\244\230"
