    replacement_chunks {
      target_content: "export const SideNavBar: React.FC<SideNavBarProps> = ({ activeTab, setActiveTab, agentName }) => {\n  return (\n    <nav className=\"bg-[#f8f9ff] dark:bg-[#0b1c30] border-r border-[#c5c5d8]/40 fixed left-0 top-0 h-screen w-[260px] flex flex-col p-4 z-40 hidden md:flex\">\n      {/* Header / Brand */}\n      <div className=\"flex items-center gap-3 mb-6\">\n        <div className=\"w-10 h-10 rounded-full bg-[#dce9ff] flex items-center justify-center overflow-hidden border border-[#2532d8]/20\">\n          <Building2 className=\"w-5 h-5 text-[#000eba]\" />\n        </div>\n        <div>\n          <h1 className=\"text-sm font-bold text-[#0b1c30] dark:text-white tracking-tight\">\n            Command Center\n          </h1>\n          <p className=\"text-xs text-[#454555]\">CS Operations</p>\n        </div>\n      </div>\n\n      {/* Navigation List */}\n      <ul className=\"flex flex-col gap-1 flex-1\">\n        <li>\n          <button\n            onClick={() => setActiveTab(\'workspace\')}\n            className={`w-full rounded-xl font-bold flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'workspace\'\n                ? \'bg-[#86f2e4]/30 text-[#005049] dark:bg-[#005049] dark:text-[#89f5e7]\'\n                : \'text-[#454555] hover:bg-[#dce9ff]/50 dark:hover:bg-[#1926d1]/20\'\n            }`}\n          >\n            <LayoutDashboard className=\"w-4 h-4\" />\n            <span>Workspace</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'calendar\')}\n            className={`w-full rounded-xl flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'calendar\'\n                ? \'bg-[#86f2e4]/30 text-[#005049] font-bold dark:bg-[#005049] dark:text-[#89f5e7]\'\n                : \'text-[#454555] hover:bg-[#dce9ff]/50 dark:hover:bg-[#1926d1]/20\'\n            }`}\n          >\n            <CalendarIcon className=\"w-4 h-4\" />\n            <span>Calendar</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'kanban\')}\n            className={`w-full rounded-xl flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'kanban\'\n                ? \'bg-[#86f2e4]/30 text-[#005049] font-bold dark:bg-[#005049] dark:text-[#89f5e7]\'\n                : \'text-[#454555] hover:bg-[#dce9ff]/50 dark:hover:bg-[#1926d1]/20\'\n            }`}\n          >\n            <KanbanIcon className=\"w-4 h-4\" />\n            <span>Kanban</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'admin\')}\n            className={`w-full rounded-xl flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'admin\'\n                ? \'bg-[#86f2e4]/30 text-[#005049] font-bold dark:bg-[#005049] dark:text-[#89f5e7]\'\n                : \'text-[#454555] hover:bg-[#dce9ff]/50 dark:hover:bg-[#1926d1]/20\'\n            }`}\n          >\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Admin</span>\n          </button>\n        </li>\n      </ul>\n\n      {/* Agent status badge */}\n      <div className=\"mb-4 p-3 bg-[#e5eeff] dark:bg-[#213145] rounded-xl border border-[#c5c5d8]/40 flex items-center gap-2\">\n        <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse\"></div>\n        <div className=\"flex-1 overflow-hidden\">\n          <p className=\"text-xs font-semibold text-[#0b1c30] dark:text-white truncate\">\n            {agentName} \354\203\201\353\213\264\354\233\220\n          </p>\n          <p className=\"text-[11px] text-[#454555]\">\354\230\250\353\235\274\354\235\270 / CTI \353\214\200\352\270\260\354\244\221</p>\n        </div>\n      </div>\n\n      {/* Footer Nav */}\n      <ul className=\"flex flex-col gap-1 pt-3 border-t border-[#c5c5d8]/40\">\n        <li>\n          <button\n            onClick={() => setActiveTab(\'support\')}\n            className={`w-full rounded-xl flex items-center gap-3 px-3 py-2 transition-all text-sm ${\n              activeTab === \'support\'\n                ? \'bg-[#86f2e4]/30 text-[#005049] font-bold\'\n                : \'text-[#454555] hover:bg-[#dce9ff]/50\'\n            }`}\n          >\n            <HelpCircle className=\"w-4 h-4\" />\n            <span>Support</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'logs\')}\n            className={`w-full rounded-xl flex items-center gap-3 px-3 py-2 transition-all text-sm ${\n              activeTab === \'logs\'\n                ? \'bg-[#86f2e4]/30 text-[#005049] font-bold\'\n                : \'text-[#454555] hover:bg-[#dce9ff]/50\'\n            }`}\n          >\n            <History className=\"w-4 h-4\" />\n            <span>Logs</span>\n          </button>\n        </li>\n      </ul>\n    </nav>\n  );\n};"
      replacement_content: "export const SideNavBar: React.FC<SideNavBarProps> = ({ activeTab, setActiveTab, agentName }) => {\n  return (\n    <nav className=\"bg-white border-r border-slate-200 fixed left-0 top-0 h-screen w-[260px] flex flex-col p-4 z-40 hidden md:flex\">\n      {/* Header / Brand */}\n      <div className=\"flex items-center gap-3 mb-6\">\n        <div className=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-sm\">\n          <Building2 className=\"w-5 h-5\" />\n        </div>\n        <div>\n          <h1 className=\"text-sm font-bold text-slate-900 tracking-tight\">\n            ZMS CS HELPER\n          </h1>\n          <p className=\"text-xs text-slate-500\">\354\243\274\354\260\250 \352\263\265\354\234\240 CS \355\206\265\355\225\251 \352\264\200\354\240\234</p>\n        </div>\n      </div>\n\n      {/* Navigation List */}\n      <ul className=\"flex flex-col gap-1 flex-1\">\n        <li>\n          <button\n            onClick={() => setActiveTab(\'workspace\')}\n            className={`w-full rounded-lg font-medium flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'workspace\'\n                ? \'bg-slate-900 text-white shadow-sm font-semibold\'\n                : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'\n            }`}\n          >\n            <LayoutDashboard className=\"w-4 h-4\" />\n            <span>Workspace</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'calendar\')}\n            className={`w-full rounded-lg font-medium flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'calendar\'\n                ? \'bg-slate-900 text-white shadow-sm font-semibold\'\n                : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'\n            }`}\n          >\n            <CalendarIcon className=\"w-4 h-4\" />\n            <span>Calendar</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'kanban\')}\n            className={`w-full rounded-lg font-medium flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'kanban\'\n                ? \'bg-slate-900 text-white shadow-sm font-semibold\'\n                : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'\n            }`}\n          >\n            <KanbanIcon className=\"w-4 h-4\" />\n            <span>Kanban</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'admin\')}\n            className={`w-full rounded-lg font-medium flex items-center gap-3 px-3 py-2.5 transition-all text-sm ${\n              activeTab === \'admin\'\n                ? \'bg-slate-900 text-white shadow-sm font-semibold\'\n                : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'\n            }`}\n          >\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Admin</span>\n          </button>\n        </li>\n      </ul>\n\n      {/* Agent status badge */}\n      <div className=\"mb-4 p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center gap-2\">\n        <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse\"></div>\n        <div className=\"flex-1 overflow-hidden\">\n          <p className=\"text-xs font-semibold text-slate-900 truncate\">\n            {agentName} \354\203\201\353\213\264\354\233\220\n          </p>\n          <p className=\"text-[11px] text-slate-500\">\354\230\250\353\235\274\354\235\270 / CTI \353\214\200\352\270\260\354\244\221</p>\n        </div>\n      </div>\n\n      {/* Footer Nav */}\n      <ul className=\"flex flex-col gap-1 pt-3 border-t border-slate-200\">\n        <li>\n          <button\n            onClick={() => setActiveTab(\'support\')}\n            className={`w-full rounded-lg font-medium flex items-center gap-3 px-3 py-2 transition-all text-sm ${\n              activeTab === \'support\'\n                ? \'bg-blue-50 text-blue-700 font-semibold\'\n                : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'\n            }`}\n          >\n            <HelpCircle className=\"w-4 h-4\" />\n            <span>Support AI / KMS</span>\n          </button>\n        </li>\n        <li>\n          <button\n            onClick={() => setActiveTab(\'logs\')}\n            className={`w-full rounded-lg font-medium flex items-center gap-3 px-3 py-2 transition-all text-sm ${\n              activeTab === \'logs\'\n                ? \'bg-blue-50 text-blue-700 font-semibold\'\n                : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'\n            }`}\n          >\n            <History className=\"w-4 h-4\" />\n            <span>Logs & \353\205\271\354\267\250\354\235\264\353\240\245</span>\n          </button>\n        </li>\n      </ul>\n    </nav>\n  );\n};"
