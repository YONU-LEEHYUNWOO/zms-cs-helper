              </div>\n            </div>\n\n            <div>\n              <label className=\"text-[11px] text-slate-500 block mb-0.5\">\354\230\210\352\270\210\354\243\274\353\252\205</label>\n              <input\n                type=\"text\"\n                value={customer?.account_holder || \'\'}\n                onChange={(e) => onChangeCustomerField(\'account_holder\', e.target.value)}\n                placeholder=\"\355\231\215\352\270\270\353\217\231\"\n                className=\"w-full bg-white border border-slate-200 rounded px-2 py-1 text-xs text-slate-900\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* AI Parking Match Auto-Recommend Button */}\n        <div className=\"pt-2\">\n          <button\n            type=\"button\"\n            onClick={() => setShowRecommendation(!showRecommendation)}\n            className=\"w-full py-2 px-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-sm flex items-center justify-center gap-2 transition-all\"\n          >\n            <Sparkles className=\"w-4 h-4 text-amber-300\" />\n            \354\236\220\354\202\254 \354\226\264\353\223\234\353\257\274 \354\227\260\353\217\231 \354\243\274\354\260\250\354\236\245 \353\247\244\353\254\274 \354\236\220\353\217\231 \354\266\224\354\262\234 ({matchedSpots.length}\352\261\264 \352\260\200\353\212\245)\n          </button>\n\n          {showRecommendation && (\n            <div className=\"mt-2 p-3 bg-slate-100 rounded-xl border border-slate-200 space-y-2\">\n              <div className=\"text-xs font-bold text-blue-700 flex items-center gap-1\">\n                <Building className=\"w-3.5 h-3.5\" /> \354\260\250\354\242\205({customer?.car_type || \'\354\244\221\355\230\225\354\204\270\353\213\250\'}) \354\236\205\354\260\250 \352\260\200\353\212\245 \353\247\244\353\254\274 \353\252\251\353\241\235\n              </div>\n\n              {matchedSpots.map((spot) => (\n                <div\n                  key={spot.id}\n                  className=\"p-2.5 bg-white rounded-lg border border-slate-200 flex items-center justify-between text-xs shadow-sm\"\n                >\n                  <div>\n                    <p className=\"font-bold text-slate-900\">{spot.name}</p>\n                    <p className=\"text-[11px] text-slate-500 flex items-center gap-0.5\">\n                      <MapPin className=\"w-3 h-3\" /> {spot.address} | \354\213\234\352\260\204\353\213\271 {spot.price_per_hour.toLocaleString()}\354\233\220\n                    </p>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      onSelectRecommendedParking(spot);\n                      setShowRecommendation(false);\n                    }}\n                    className=\"px-2.5 py-1 bg-blue-600 text-white text-[11px] font-semibold rounded hover:bg-blue-700\"\n                  >\n                    \354\204\240\355\203\235 \354\240\201\354\232\251\n                  </button>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      </form>\n    </div>\n  );\n};"
