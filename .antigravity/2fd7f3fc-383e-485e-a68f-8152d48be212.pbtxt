lass=\\\"w-full border-slate-200 rounded-lg text-xs\\\">\\n              </div>\\n            </div>\\n          </div>\\n          <div class=\\\"space-y-4\\\">\\n            <div>\\n              <label class=\\\"text-[10px] font-bold text-slate-400 uppercase mb-1 block\\\">\354\240\225\354\202\260 \352\263\204\354\242\214 \354\240\225\353\263\264 (\354\235\200\355\226\211/\352\263\204\354\242\214/\354\230\210\352\270\210\354\243\274)</label>\\n              <div class=\\\"flex gap-2\\\">\\n                <input type=\\\"text\\\" value=\\\"\354\213\240\355\225\234\354\235\200\355\226\211\\\" class=\\\"w-1/3 border-slate-200 rounded-lg text-xs\\\">\\n                <input type=\\\"text\\\" value=\\\"110-234-567890\\\" class=\\\"flex-1 border-slate-200 rounded-lg text-xs font-mono\\\">\\n              </div>\\n            </div>\\n            <div>\\n              <label class=\\\"text-[10px] font-bold text-slate-400 uppercase mb-1 block\\\">\354\243\274\354\260\250 \354\203\201\355\222\210 \354\240\225\353\263\264</label>\\n              <div class=\\\"p-3 bg-slate-50 rounded-lg border border-slate-100\\\">\\n                <div class=\\\"text-xs font-bold\\\">\352\260\225\353\202\250\354\227\255 \354\211\220\354\226\264\353\247\201 \354\243\274\354\260\250\354\236\245 (A-102)</div>\\n                <div class=\\\"text-[10px] text-slate-500\\\">\354\233\224\354\243\274\354\260\250 | \354\235\264\354\232\251\352\270\260\352\260\204: 24.06.01 ~ 24.06.30</div>\\n              </div>\\n            </div>\\n            <div>\\n              <label class=\\\"text-[10px] font-bold text-slate-400 uppercase mb-1 block\\\">\355\212\271\354\235\264\354\202\254\355\225\255</label>\\n              <input type=\\\"text\\\" value=\\\"\354\203\201\354\212\265 \353\257\270\353\202\251 \354\235\264\353\240\245 \354\236\210\354\235\214, \355\231\230\353\266\210 \354\232\224\354\262\255 \354\213\234 \352\264\200\353\246\254\354\236\220 \355\231\225\354\235\270 \355\225\204\354\210