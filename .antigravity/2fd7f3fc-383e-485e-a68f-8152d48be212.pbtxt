  file_change {
    absolute_path_uri: "file:///src/components/calendar/CalendarView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Calendar as CalendarIcon, Clock, User, AlertCircle, ChevronLeft, ChevronRight } from \'lucide-react\';\nimport { Consultation, AgentTask } from \'../../types\';\n\ninterface CalendarViewProps {\n  consultations: Consultation[];\n  tasks: AgentTask[];\n  currentAgentName: string;\n}\n\nexport const CalendarView: React.FC<CalendarViewProps> = ({\n  consultations,\n  tasks,\n  currentAgentName,\n}) => {\n  const [filterAgent, setFilterAgent] = useState<string>(currentAgentName);\n\n  const filteredConsultations = consultations.filter((c) =>\n    filterAgent ? c.agent_name === filterAgent : true\n  );\n\n  const filteredTasks = tasks.filter((t) =>\n    filterAgent ? t.agent_name === filterAgent : true\n  );\n\n  // Sample calendar days grid for August 2026\n  const days = Array.from({ length: 31 }, (_, i) => i + 1);\n\n  return (\n    <div className=\"p-6 max-w-[1600px] mx-auto space-y-6\">\n      {/* Calendar Header Bar */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-[#0b1c30] p-4 rounded-2xl border border-[#c5c5d8]/40 shadow-sm\">\n        <div>\n          <h2 className=\"text-lg font-bold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <CalendarIcon className=\"w-5 h-5 text-[#000eba]\" />\n            \353\202\264 \354\203\201\353\213\264 \354\212\244\354\274\200\354\244\204 & Task \353\247\210\352\260\220 \354\272\230\353\246\260\353\215\224\n          </h2>\n          <p className=\"text-xs text-[#454555]\">\n            \353\213\264\353\213\271\354\236\220\353\263\204 \354\243\274\354\260\250 \355\235\254\353\247\235\354\235\274 \353\260\217 \354\227\260\353\235\275 \354\225\275\354\206\215(Task Deadline) \354\213\234\352\260\201\354\235\204 \354\213\234\352\260\201\355\231\224\355\225\251\353\213\210\353\213\244.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-1.5 bg-[#f8f9ff] dark:bg-[#213145] px-3 py-1.5 rounded-xl border text-xs\">\n            <User className=\"w-4 h-4 text-[#000eba]\" />\n            <span className=\"text-gray-500\">\355\225\204\355\204\260:</span>\n            <select\n              value={filterAgent}\n              onChange={(e) => setFilterAgent(e.target.value)}\n              className=\"bg-transparent font-bold text-[#0b1c30] dark:text-white focus:outline-none\"\n            >\n              <option value=\"\">\354\240\204\354\262\264 \354\203\201\353\213\264\354\233\220 \353\263\264\352\270\260</option>\n              <option value=\"\352\271\200\354\262\240\354\210\230\">\352\271\200\354\262\240\354\210\230 \354\203\201\353\213\264\354\202\254</option>\n              <option value=\"\353\260\225\354\230\201\355\235\254\">\353\260\225\354\230\201\355\235\254 \354\203\201\353\213\264\354\202\254</option>\n              <option value=\"\354\235\264\353\257\274\354\210\230\">\354\235\264\353\257\274\354\210\230 \354\203\201\353\213\264\354\202\254</option>\n            </select>\n          </div>\n\n          <div className=\"flex items-center gap-1 bg-[#e5eeff] dark:bg-[#213145] rounded-xl p-1\">\n            <button className=\"p-1 hover:bg-white dark:hover:bg-gray-700 rounded text-gray-600 dark:text-gray-200\">\n              <ChevronLeft className=\"w-4 h-4\" />\n            </button>\n            <span className=\"text-xs font-bold px-2 text-[#000eba] dark:text-[#bec2ff]\">2026\353\205\204 8\354\233\224</span>\n            <button className=\"p-1 hover:bg-white dark:hover:bg-gray-700 rounded text-gray-600 dark:text-gray-200\">\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Calendar Grid */}\n      <div className=\"bg-white dark:bg-[#0b1c30] rounded-2xl border border-[#c5c5d8]/40 shadow-sm overflow-hidden\">\n        {/* Days of Week */}\n        <div className=\"grid grid-cols-7 bg-[#f8f9ff] dark:bg-[#213145] border-b border-[#c5c5d8]/40 text-center py-2 text-xs font-bold text-[#454555]\">\n          <span className=\"text-red-500\">\354\235\274</span>\n          <span>\354\233\224</span>\n          <span>\355\231\224</span>\n          <span>\354\210\230</span>\n          <span>\353\252\251</span>\n          <span>\352\270\210</span>\n          <span className=\"text-blue-500\">\355\206\240</span>\n        </div>\n\n        {/* Days Grid */}\n        <div className=\"grid grid-cols-7 auto-rows-fr gap-px bg-[#c5c5d8]/30 min-h-[500px]\">\n          {days.map((day) => {\n            const dateStr = `2026-08-${day < 10 ? \'0\' + day : day}`;\n            const matchedCons = filteredConsultations.filter(\n              (c) => c.hope_date === dateStr || c.created_at.startsWith(dateStr)\n            );\n            const matchedTasks = filteredTasks.filter((t) => t.due_date.startsWith(dateStr));\n\n            return (\n              <div\n                key={day}\n                className={`bg-white dark:bg-[#0b1c30] p-2 flex flex-col min-h-[100px] hover:bg-[#f8f9ff] transition-colors ${\n                  day === 4 ? \'ring-2 ring-[#000eba] ring-inset\' : \'\'\n                }`}\n              >\n                <div className=\"flex justify-between items-center mb-1\">\n                  <span\n                    className={`text-xs font-bold font-mono ${\n                      day === 4\n                        ? \'w-5 h-5 rounded-full bg-[#000eba] text-white flex items-center justify-center\'\n                        : \'text-[#0b1c30] dark:text-white\'\n                    }`}\n                  >\n                    {day}\n                  </span>\n                  {day === 4 && <span className=\"text-[10px] font-bold text-[#000eba]\">\354\230\244\353\212\230</span>}\n                </div>\n\n                {/* Consultation Items for this day */}\n                <div className=\"space-y-1 flex-1 overflow-y-auto\">\n                  {matchedCons.map((c) => (\n                    <div\n                      key={c.id}\n                      className={`p-1.5 rounded text-[11px] font-semibold border leading-tight ${\n                        c.status === \'\355\225\264\352\262\260\354\244\221\'\n                          ? \'bg-amber-50 text-amber-900 border-amber-200\'\n                          : c.status === \'\352\263\265\354\234\240\354\236\220 \354\227\260\353\235\275 \354\244\221\'\n                          ? \'bg-purple-50 text-purple-900 border-purple-200\'\n                          : \'bg-emerald-50 text-emerald-900 border-emerald-200\'\n                      }`}\n                    >\n                      <p className=\"truncate\">[{c.status}] {c.parking_name || \'\354\243\274\354\260\250\354\236\245\'}</p>\n                      <p className=\"text-[10px] font-normal text-gray-500 truncate\">\353\213\264\353\213\271: {c.agent_name}</p>\n                    </div>\n                  ))}\n\n                  {/* Task Items */}\n                  {matchedTasks.map((t) => (\n                    <div\n                      key={t.id}\n                      className=\"p-1 bg-red-50 text-red-900 border border-red-200 rounded text-[10px] font-medium flex items-center gap-1 truncate\"\n                    >\n                      <Clock className=\"w-3 h-3 text-red-600 shrink-0\" />\n                      <span className=\"truncate\">{t.task_title}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
