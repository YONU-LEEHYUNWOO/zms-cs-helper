    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Kanban as KanbanIcon, User, Clock, ArrowRight, ArrowLeft } from \'lucide-react\';\nimport { Consultation, ConsultationStatus } from \'../../types\';\n\ninterface KanbanBoardViewProps {\n  consultations: Consultation[];\n  onUpdateStatus: (consId: string, newStatus: ConsultationStatus) => void;\n}\n\nexport const KanbanBoardView: React.FC<KanbanBoardViewProps> = ({\n  consultations,\n  onUpdateStatus,\n}) => {\n  const columns: ConsultationStatus[] = [\n    \'\354\240\221\354\210\230\',\n    \'\355\225\264\352\262\260\354\244\221\',\n    \'\352\263\265\354\234\240\354\236\220 \354\227\260\353\235\275 \354\244\221\',\n    \'\354\234\240\354\204\240 \353\266\200\354\204\234 \355\231\225\354\235\270 \354\244\221\',\n    \'\354\231\204\353\243\214\',\n  ];\n\n  return (\n    <div className=\"p-6 max-w-[1600px] mx-auto space-y-6\">\n      {/* Kanban Header */}\n      <div className=\"bg-white dark:bg-[#0b1c30] p-4 rounded-2xl border border-[#c5c5d8]/40 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-lg font-bold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <KanbanIcon className=\"w-5 h-5 text-[#000eba]\" />\n            \354\203\201\353\213\264 \354\247\204\354\262\231\353\217\204 \354\271\270\353\260\230 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270 (Kanban Board)\n          </h2>\n          <p className=\"text-xs text-[#454555]\">\n            \354\203\201\353\213\264 \354\203\201\355\203\234 \353\213\250\352\263\204\353\245\274 \354\213\234\352\260\201\354\240\201\354\234\274\353\241\234 \355\212\270\353\236\230\355\202\271\355\225\230\352\263\240 \352\260\204\355\216\270\355\225\230\352\262\214 \353\213\250\352\263\204\353\245\274 \354\240\204\355\231\230\355\225\251\353\213\210\353\213\244.\n          </p>\n        </div>\n\n        <span className=\"px-3 py-1 bg-[#e5eeff] text-[#000eba] text-xs font-bold rounded-full\">\n          \354\264\235 {consultations.filter((c) => !c.is_archived).length}\352\261\264 \355\231\234\354\204\261 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270\n        </span>\n      </div>\n\n      {/* Kanban Board Columns */}\n      <div className=\"grid grid-cols-1 md:grid-cols-5 gap-4 overflow-x-auto pb-4\">\n        {columns.map((colStatus) => {\n          const items = consultations.filter(\n            (c) => c.status === colStatus && !c.is_archived\n          );\n\n          return (\n            <div\n              key={colStatus}\n              className=\"bg-[#f8f9ff] dark:bg-[#213145] rounded-2xl border border-[#c5c5d8]/40 p-3 flex flex-col min-h-[600px]\"\n            >\n              {/* Column Header */}\n              <div className=\"flex justify-between items-center mb-3 pb-2 border-b border-[#c5c5d8]/40\">\n                <h3 className=\"font-bold text-xs text-[#0b1c30] dark:text-white flex items-center gap-1.5\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#000eba]\"></span>\n                  {colStatus}\n                </h3>\n                <span className=\"px-2 py-0.5 bg-white dark:bg-[#0b1c30] text-xs font-bold rounded-full border\">\n                  {items.length}\n                </span>\n              </div>\n\n              {/* Column Cards */}\n              <div className=\"space-y-3 flex-1 overflow-y-auto\">\n                {items.length === 0 ? (\n                  <p className=\"text-[11px] text-gray-400 text-center py-10\">\355\225\264\353\213\271 \353\213\250\352\263\204\354\235\230 \354\203\201\353\213\264\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.</p>\n                ) : (\n                  items.map((cons) => (\n                    <div\n                      key={cons.id}\n                      className=\"bg-white dark:bg-[#0b1c30] p-3 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow space-y-2\"\n                    >\n                      <div className=\"flex justify-between items-start text-xs\">\n                        <span className=\"font-bold text-[#000eba] dark:text-[#bec2ff] truncate max-w-[130px]\">\n                          {cons.parking_name || \'\354\243\274\354\260\250\354\236\245 \353\257\270\354\247\200\354\240\225\'}\n                        </span>\n                        <span className=\"px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-[10px] text-gray-600 font-medium\">\n                          {cons.inquiry_type}\n                        </span>\n                      </div>\n\n                      <p className=\"text-xs text-[#0b1c30] dark:text-gray-200 line-clamp-2 leading-relaxed\">\n                        {cons.summary}\n                      </p>\n\n                      {cons.sub_status && (\n                        <p className=\"text-[10px] text-emerald-600 font-medium\">\n                          \342\206\263 {cons.sub_status}\n                        </p>\n                      )}\n\n                      <div className=\"pt-2 border-t border-gray-100 dark:border-gray-800 flex justify-between items-center text-[10px] text-gray-400\">\n                        <span className=\"flex items-center gap-1\">\n                          <User className=\"w-3 h-3\" /> {cons.agent_name}\n                        </span>\n\n                        {/* Column Transition Buttons */}\n                        <div className=\"flex gap-1\">\n                          {columns.indexOf(colStatus) > 0 && (\n                            <button\n                              onClick={() =>\n                                onUpdateStatus(\n                                  cons.id,\n                                  columns[columns.indexOf(colStatus) - 1]\n                                )\n                              }\n                              title=\"\354\235\264\354\240\204 \353\213\250\352\263\204\353\241\234 \354\235\264\353\217\231\"\n                              className=\"p-1 hover:bg-gray-100 rounded text-gray-600\"\n                            >\n                              <ArrowLeft className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                          {columns.indexOf(colStatus) < columns.length - 1 && (\n                            <button\n                              onClick={() =>\n                                onUpdateStatus(\n                                  cons.id,\n                                  columns[columns.indexOf(colStatus) + 1]\n                                )\n                              }\n                              title=\"\353\213\244\354\235\214 \353\213\250\352\263\204\353\241\234 \354\235\264\353\217\231\"\n                              className=\"p-1 hover:bg-gray-100 rounded text-gray-600\"\n                            >\n                              <ArrowRight className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Kanban as KanbanIcon,\n  User,\n  Clock,\n  ArrowRight,\n  ArrowLeft,\n  Filter,\n  Shield,\n  Lock,\n} from \'lucide-react\';\nimport { Consultation, ConsultationStatus } from \'../../types\';\n\ninterface KanbanBoardViewProps {\n  consultations: Consultation[];\n  currentAgentName?: string;\n  onUpdateStatus: (consId: string, newStatus: ConsultationStatus) => void;\n}\n\nexport const KanbanBoardView: React.FC<KanbanBoardViewProps> = ({\n  consultations,\n  currentAgentName = \'\352\271\200\354\262\240\354\210\230\',\n  onUpdateStatus,\n}) => {\n  const isAdmin = currentAgentName === \'\352\264\200\353\246\254\354\236\220\' || currentAgentName.includes(\'\352\264\200\353\246\254\354\236\220\');\n  const [selectedAgentFilter, setSelectedAgentFilter] = useState<string>(\n    isAdmin ? \'ALL\' : currentAgentName\n  );\n\n  const columns: ConsultationStatus[] = [\n    \'\354\240\221\354\210\230\',\n    \'\355\225\264\352\262\260\354\244\221\',\n    \'\352\263\265\354\234\240\354\236\220 \354\227\260\353\235\275 \354\244\221\',\n    \'\354\234\240\354\204\240 \353\266\200\354\204\234 \355\231\225\354\235\270 \354\244\221\',\n    \'\354\231\204\353\243\214\',\n  ];\n\n  // Filter consultations based on agent selection\n  const filteredConsultations = consultations.filter((c) => {\n    if (c.is_archived) return false;\n    if (selectedAgentFilter === \'ALL\') return true;\n    return c.agent_name === selectedAgentFilter;\n  });\n\n  return (\n    <div className=\"p-6 max-w-[1600px] mx-auto space-y-6\">\n      {/* Kanban Header */}\n      <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n            <KanbanIcon className=\"w-5 h-5 text-blue-600\" />\n            \354\203\201\353\213\264 \354\247\204\354\262\231\353\217\204 \354\271\270\353\260\230 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270 (Kanban Board)\n          </h2>\n          <p className=\"text-xs text-slate-500\">\n            \354\203\201\353\213\264 \354\203\201\355\203\234 \353\213\250\352\263\204\353\245\274 \354\213\234\352\260\201\354\240\201\354\234\274\353\241\234 \355\212\270\353\236\230\355\202\271\355\225\230\352\263\240 \352\260\204\355\216\270\355\225\230\352\262\214 \353\213\250\352\263\204\353\245\274 \354\240\204\355\231\230\355\225\251\353\213\210\353\213\244.\n          </p>\n        </div>\n\n        {/* Agent DB Scope Filter */}\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className=\"flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg text-xs\">\n            <Filter className=\"w-3.5 h-3.5 text-blue-600\" />\n            <span className=\"text-slate-500\">\354\241\260\355\232\214 \353\262\224\354\234\204:</span>\n            <select\n              value={selectedAgentFilter}\n              onChange={(e) => setSelectedAgentFilter(e.target.value)}\n              className=\"bg-transparent font-bold text-slate-900 focus:outline-none cursor-pointer\"\n            >\n              {isAdmin && <option value=\"ALL\">\360\237\233\241\357\270\217 \354\240\204\354\262\264 \354\203\201\353\213\264\354\202\254 DB (\352\264\200\353\246\254\354\236\220)</option>}\n              <option value=\"\352\271\200\354\262\240\354\210\230\">\352\271\200\354\262\240\354\210\230 \354\203\201\353\213\264\354\202\254 DB</option>\n              <option value=\"\353\260\225\354\230\201\355\235\254\">\353\260\225\354\230\201\355\235\254 \354\203\201\353\213\264\354\202\254 DB</option>\n              <option value=\"\354\235\264\353\257\274\354\210\230\">\354\235\264\353\257\274\354\210\230 \354\203\201\353\213\264\354\202\254 DB</option>\n              {!isAdmin && <option value=\"ALL\">\354\240\204\354\262\264 \354\203\201\353\213\264\352\261\264 \353\263\264\352\270\260</option>}\n            </select>\n          </div>\n\n          <span className=\"px-3 py-1.5 bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold rounded-lg flex items-center gap-1\">\n            {isAdmin ? (\n              <Shield className=\"w-3.5 h-3.5 text-amber-600\" />\n            ) : (\n              <Lock className=\"w-3.5 h-3.5 text-blue-600\" />\n            )}\n            \354\264\235 {filteredConsultations.length}\352\261\264 \355\231\234\354\204\261 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270\n          </span>\n        </div>\n      </div>\n\n      {/* Kanban Board Columns */}\n      <div className=\"grid grid-cols-1 md:grid-cols-5 gap-4 overflow-x-auto pb-4\">\n        {columns.map((colStatus) => {\n          const items = filteredConsultations.filter((c) => c.status === colStatus);\n\n          return (\n            <div\n              key={colStatus}\n              className=\"bg-slate-50 rounded-xl border border-slate-200 p-3 flex flex-col min-h-[600px]\"\n            >\n              {/* Column Header */}\n              <div className=\"flex justify-between items-center mb-3 pb-2 border-b border-slate-200\">\n                <h3 className=\"font-bold text-xs text-slate-900 flex items-center gap-1.5\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-blue-600\"></span>\n                  {colStatus}\n                </h3>\n                <span className=\"px-2 py-0.5 bg-white text-slate-700 text-xs font-bold rounded-full border border-slate-200\">\n                  {items.length}\n                </span>\n              </div>\n\n              {/* Column Cards */}\n              <div className=\"space-y-3 flex-1 overflow-y-auto\">\n                {items.length === 0 ? (\n                  <p className=\"text-[11px] text-slate-400 text-center py-10\">\n                    \355\225\264\353\213\271 \353\213\250\352\263\204\354\235\230 \354\203\201\353\213\264\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.\n                  </p>\n                ) : (\n                  items.map((cons) => (\n                    <div\n                      key={cons.id}\n                      className=\"bg-white p-3 rounded-lg border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-2\"\n                    >\n                      <div className=\"flex justify-between items-start text-xs\">\n                        <span className=\"font-bold text-blue-700 truncate max-w-[130px]\">\n                          {cons.parking_name || \'\354\243\274\354\260\250\354\236\245 \353\257\270\354\247\200\354\240\225\'}\n                        </span>\n                        <span className=\"px-1.5 py-0.5 rounded bg-slate-100 text-[10px] text-slate-600 font-medium border border-slate-200\">\n                          {cons.inquiry_type}\n                        </span>\n                      </div>\n\n                      <p className=\"text-xs text-slate-800 line-clamp-2 leading-relaxed\">\n                        {cons.summary}\n                      </p>\n\n                      {cons.sub_status && (\n                        <p className=\"text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100\">\n                          \342\206\263 \354\206\214\353\266\204\353\245\230: {cons.sub_status}\n                        </p>\n                      )}\n\n                      <div className=\"pt-2 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-500\">\n                        <span className=\"flex items-center gap-1 font-medium\">\n                          <User className=\"w-3 h-3 text-blue-600\" /> {cons.agent_name}\n                        </span>\n\n                        {/* Column Transition Buttons */}\n                        <div className=\"flex gap-1\">\n                          {columns.indexOf(colStatus) > 0 && (\n                            <button\n                              onClick={() =>\n                                onUpdateStatus(\n                                  cons.id,\n                                  columns[columns.indexOf(colStatus) - 1]\n                                )\n                              }\n                              title=\"\354\235\264\354\240\204 \353\213\250\352\263\204\353\241\234 \354\235\264\353\217\231\"\n                              className=\"p-1 hover:bg-slate-100 rounded text-slate-600 transition-colors\"\n                            >\n                              <ArrowLeft className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                          {columns.indexOf(colStatus) < columns.length - 1 && (\n                            <button\n                              onClick={() =>\n                                onUpdateStatus(\n                                  cons.id,\n                                  columns[columns.indexOf(colStatus) + 1]\n                                )\n                              }\n                              title=\"\353\213\244\354\235\214 \353\213\250\352\263\204\353\241\234 \354\235\264\353\217\231\"\n                              className=\"p-1 hover:bg-slate-100 rounded text-slate-600 transition-colors\"\n                            >\n                              <ArrowRight className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
