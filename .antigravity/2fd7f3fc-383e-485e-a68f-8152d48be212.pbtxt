      target_content: "          {/* Prominent Save Log Button */}\n          <div className=\"pt-3 border-t border-slate-100 mt-3 space-y-2\">\n            {saveSuccessMessage && (\n              <div className=\"p-2.5 bg-emerald-100 border border-emerald-300 text-emerald-900 rounded-lg text-xs font-bold flex items-center gap-2 animate-fadeIn\">\n                <CheckCircle className=\"w-4 h-4 text-emerald-700 shrink-0\" />\n                <span>{saveSuccessMessage}</span>\n              </div>\n            )}\n\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleSaveAndNotify}\n                className=\"flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow-md transition-all flex items-center justify-center gap-2\"\n              >\n                <CheckCircle className=\"w-4 h-4\" />\n                \354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245 & DB \354\246\211\354\213\234 \353\223\261\353\241\235\n              </button>\n\n              <button\n                onClick={() => setShowSendModal(true)}\n                className=\"py-3 px-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-1\"\n                title=\"\353\254\270\354\236\220/\354\271\264\354\271\264\354\230\244\355\206\241 \354\246\211\354\213\234 \353\260\234\354\206\241\"\n              >\n                <Send className=\"w-4 h-4\" /> \353\254\270\354\236\220\353\260\234\354\206\241\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Section: Customer History Logs & Kanban Board Integration */}\n      <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm space-y-3\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-blue-600\" />\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                \352\263\240\352\260\235({customer?.car_number || \'\354\260\250\353\237\211\'}) \354\203\201\353\213\264 \354\235\264\353\240\245 & DB \354\240\200\354\236\245 \353\241\234\352\267\270 (\354\264\235{\' \'}\n                {visibleCustomerConsultations.length}\352\261\264)\n              </h3>\n              <p className=\"text-[11px] text-slate-500\">\n                \354\203\201\353\213\264 \353\202\264\354\227\255\354\235\264 \353\215\260\354\235\264\355\204\260\353\262\240\354\235\264\354\212\244\354\227\220 \354\266\225\354\240\201\353\220\230\354\226\264 \354\235\264\353\240\245\354\235\264 \353\263\264\354\241\264\353\220\230\353\251\260, \354\271\270\353\260\230 \353\263\264\353\223\234 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270\354\227\220 \353\217\231\352\270\260\355\231\224\353\220\251\353\213\210\353\213\244.\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onNavigateToKanban}\n            className=\"px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-lg shadow-sm flex items-center gap-1.5 self-start sm:self-auto\"\n          >\n            <Kanban className=\"w-4 h-4 text-blue-400\" />\n            \354\271\270\353\260\230 \353\263\264\353\223\234\353\241\234 \354\235\264\353\217\231\355\225\230\354\227\254 \354\240\204\354\262\264 \355\231\225\354\235\270\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {visibleCustomerConsultations.length === 0 ? (\n          <div className=\"py-8 text-center text-slate-400 text-xs bg-slate-50 rounded-lg border border-dashed border-slate-200\">\n            {isAdmin\n              ? \'\354\240\200\354\236\245\353\220\234 \352\263\240\352\260\235 \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244. \354\234\204\354\235\230 \354\203\201\353\213\250\354\235\230 \"\354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245\" \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \354\203\210 \353\241\234\352\267\270\353\245\274 \354\240\200\354\236\245\355\225\230\354\204\270\354\232\224.\'\n              : `${currentAgentName} \354\203\201\353\213\264\354\202\254 \352\263\204\354\240\225\354\234\274\353\241\234 \354\240\200\354\236\245\353\220\234 \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.`}\n          </div>\n        ) : (\n          <div className=\"space-y-2.5 max-h-80 overflow-y-auto pr-1\">\n            {visibleCustomerConsultations.map((cons) => (\n              <div\n                key={cons.id}\n                className={`p-3 rounded-lg border transition-all ${\n                  cons.id === activeConsultation?.id\n                    ? \'bg-blue-50/70 border-blue-300 ring-1 ring-blue-300\'\n                    : \'bg-slate-50 border-slate-200 hover:bg-slate-100\'\n                }`}\n              >\n                <div className=\"flex flex-wrap justify-between items-center gap-2 mb-1\">\n                  <div className=\"flex items-center gap-2 text-xs\">\n                    <span className=\"px-2 py-0.5 rounded bg-blue-600 text-white font-bold text-[11px]\">\n                      {cons.status}\n                    </span>\n                    {cons.sub_status && (\n                      <span className=\"px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-semibold text-[11px]\">\n                        \342\206\263 {cons.sub_status}\n                      </span>\n                    )}\n                    <span className=\"font-bold text-slate-900\">\n                      {cons.parking_name || \'\354\243\274\354\260\250\354\236\245 \353\257\270\354\247\200\354\240\225\'}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-3 text-[11px] text-slate-500 font-mono\">\n                    <span className=\"flex items-center gap-1 font-semibold text-blue-700\">\n                      <User className=\"w-3 h-3 text-blue-600\" /> \353\213\264\353\213\271: {cons.agent_name}\n                    </span>\n                    <span>\n                      {cons.created_at ? cons.created_at.slice(0, 16).replace(\'T\', \' \') : \'\'}\n                    </span>\n                  </div>\n                </div>\n\n                <p className=\"text-xs text-slate-800 leading-relaxed bg-white p-2.5 rounded border border-slate-200\">\n                  {cons.summary}\n                </p>\n              </div>\n            ))}\n          </div>\n        )}"
      replacement_content: "          {/* Prominent Save Log Button */}\n          <div className=\"pt-3 border-t border-slate-100 mt-3 space-y-2\">\n            {saveSuccessMessage && (\n              <div className=\"p-2.5 bg-emerald-100 border border-emerald-300 text-emerald-900 rounded-lg text-xs font-bold flex items-center gap-2 animate-fadeIn\">\n                <CheckCircle className=\"w-4 h-4 text-emerald-700 shrink-0\" />\n                <span>{saveSuccessMessage}</span>\n              </div>\n            )}\n\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleSaveAndNotify}\n                className=\"flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow-md transition-all flex items-center justify-center gap-2\"\n              >\n                <CheckCircle className=\"w-4 h-4\" />\n                {isExistingConsultation\n                  ? \'\352\270\260\354\241\264 \354\203\201\353\213\264 \354\235\264\353\240\245 \354\210\230\354\240\225 \353\202\264\354\232\251 \354\240\200\354\236\245 (DB \354\227\205\353\215\260\354\235\264\355\212\270)\'\n                  : \'\354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245 & DB \354\246\211\354\213\234 \353\223\261\353\241\235\'}\n              </button>\n\n              <button\n                onClick={() => setShowSendModal(true)}\n                className=\"py-3 px-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-1\"\n                title=\"\353\254\270\354\236\220/\354\271\264\354\271\264\354\230\244\355\206\241 \354\246\211\354\213\234 \353\260\234\354\206\241\"\n              >\n                <Send className=\"w-4 h-4\" /> \353\254\270\354\236\220\353\260\234\354\206\241\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Section: Customer History Logs & Kanban Board Integration */}\n      <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm space-y-3\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-blue-600\" />\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                \352\263\240\352\260\235({customer?.car_number || \'\354\260\250\353\237\211\'}) \354\203\201\353\213\264 \354\235\264\353\240\245 & DB \354\240\200\354\236\245 \353\241\234\352\267\270 (\354\264\235{\' \'}\n                {visibleCustomerConsultations.length}\352\261\264)\n              </h3>\n              <p className=\"text-[11px] text-slate-500\">\n                \354\203\201\353\213\264 \355\225\255\353\252\251\354\235\204 \355\201\264\353\246\255\355\225\230\352\261\260\353\202\230 \'\354\235\264\354\226\264\354\204\234 \354\210\230\354\240\225\' \353\262\204\355\212\274\354\235\204 \353\210\204\353\245\264\353\251\264 \355\225\264\353\213\271 \354\203\201\353\213\264\352\261\264\354\235\264 \354\203\201\353\213\250 \355\216\270\354\247\221\354\260\275\354\227\220 \353\266\210\353\237\254\354\231\200\354\247\221\353\213\210\353\213\244.\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onNavigateToKanban}\n            className=\"px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-lg shadow-sm flex items-center gap-1.5 self-start sm:self-auto\"\n          >\n            <Kanban className=\"w-4 h-4 text-blue-400\" />\n            \354\271\270\353\260\230 \353\263\264\353\223\234\353\241\234 \354\235\264\353\217\231\355\225\230\354\227\254 \354\240\204\354\262\264 \355\231\225\354\235\270\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {visibleCustomerConsultations.length === 0 ? (\n          <div className=\"py-8 text-center text-slate-400 text-xs bg-slate-50 rounded-lg border border-dashed border-slate-200\">\n            {isAdmin\n              ? \'\354\240\200\354\236\245\353\220\234 \352\263\240\352\260\235 \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244. \354\234\204\354\235\230 \354\203\201\353\213\250\354\235\230 \"\354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245\" \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \354\203\210 \353\241\234\352\267\270\353\245\274 \354\240\200\354\236\245\355\225\230\354\204\270\354\232\224.\'\n              : `${currentAgentName} \354\203\201\353\213\264\354\202\254 \352\263\204\354\240\225\354\234\274\353\241\234 \354\240\200\354\236\245\353\220\234 \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.`}\n          </div>\n        ) : (\n          <div className=\"space-y-2.5 max-h-80 overflow-y-auto pr-1\">\n            {visibleCustomerConsultations.map((cons) => (\n              <div\n                key={cons.id}\n                onClick={() => onSelectConsultation?.(cons.id)}\n                className={`p-3 rounded-lg border transition-all cursor-pointer ${\n                  cons.id === activeConsultation?.id\n                    ? \'bg-blue-50/90 border-blue-400 ring-2 ring-blue-300 shadow-sm\'\n                    : \'bg-slate-50 border-slate-200 hover:bg-slate-100\'\n                }`}\n              >\n                <div className=\"flex flex-wrap justify-between items-center gap-2 mb-1\">\n                  <div className=\"flex items-center gap-2 text-xs\">\n                    <span className=\"px-2 py-0.5 rounded bg-blue-600 text-white font-bold text-[11px]\">\n                      {cons.status}\n                    </span>\n                    {cons.sub_status && (\n                      <span className=\"px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-semibold text-[11px]\">\n                        \342\206\263 {cons.sub_status}\n                      </span>\n                    )}\n                    <span className=\"font-bold text-slate-900\">\n                      {cons.parking_name || \'\354\243\274\354\260\250\354\236\245 \353\257\270\354\247\200\354\240\225\'}\n                    </span>\n                    {cons.id === activeConsultation?.id && (\n                      <span className=\"px-1.5 py-0.5 bg-blue-700 text-white text-[10px] font-bold rounded\">\n                        \355\230\204\354\236\254 \355\216\270\354\247\221 \354\244\221\n                      </span>\n                    )}\n                  </div>\n\n                  <div className=\"flex items-center gap-2 text-[11px]\">\n                    <button\n                      type=\"button\"\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onSelectConsultation?.(cons.id);\n                      }}\n                      className=\"px-2 py-0.5 bg-blue-600 text-white text-[10px] font-bold rounded hover:bg-blue-700 transition-colors shadow-sm\"\n                    >\n                      \342\234\217\357\270\217 \354\235\264\354\226\264\354\204\234 \354\210\230\354\240\225\n                    </button>\n                    <span className=\"text-slate-500 font-mono text-[10px]\">\n                      {cons.created_at ? cons.created_at.slice(0, 16).replace(\'T\', \' \') : \'\'}\n                    </span>\n                  </div>\n                </div>\n\n                <p className=\"text-xs text-slate-800 leading-relaxed bg-white p-2.5 rounded border border-slate-200\">\n                  {cons.summary}\n                </p>\n              </div>\n            ))}\n          </div>\n        )}"
