  file_change {
    absolute_path_uri: "file:///src/lib/services/customerService.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ZMS_CS_HELPER - Customer & Consultation Search / Management Service\n */\n\nimport { Customer, Consultation } from \'../../types\';\nimport { normalizePhoneNumber, normalizeCarNumber } from \'../utils/normalize\';\n\nexport interface CustomerSearchResult {\n  customer: Customer | null;\n  activeConsultation: Consultation | null;\n  history: Consultation[];\n  archivedHistoryCount: number;\n}\n\n/**\n * Performs format-free normalization search for phone number or car number.\n * Strips hyphens, spaces, and handles partial or full matching.\n */\nexport function searchCustomerAndConsultations(\n  query: string,\n  customers: Customer[],\n  consultations: Consultation[]\n): CustomerSearchResult {\n  if (!query || !query.trim()) {\n    return { customer: null, activeConsultation: null, history: [], archivedHistoryCount: 0 };\n  }\n\n  const cleanQuery = query.trim();\n  const normalizedPhoneQuery = normalizePhoneNumber(cleanQuery);\n  const normalizedCarQuery = normalizeCarNumber(cleanQuery);\n\n  // Match Customer\n  let matchedCustomer = customers.find((c) => {\n    const normPhone = normalizePhoneNumber(c.phone_number);\n    const normCar = normalizeCarNumber(c.car_number);\n\n    // Exact or suffix phone match\n    if (normalizedPhoneQuery.length >= 4 && normPhone.endsWith(normalizedPhoneQuery)) {\n      return true;\n    }\n    // License plate match\n    if (normalizedCarQuery.length >= 2 && normCar.includes(normalizedCarQuery)) {\n      return true;\n    }\n    return false;\n  });\n\n  if (!matchedCustomer) {\n    return { customer: null, activeConsultation: null, history: [], archivedHistoryCount: 0 };\n  }\n\n  // Get active consultations vs archived consultations\n  const allForCustomer = consultations.filter((c) => c.customer_id === matchedCustomer!.id);\n  const activeHistory = allForCustomer.filter((c) => !c.is_archived);\n  const archivedCount = allForCustomer.filter((c) => c.is_archived).length;\n\n  const activeConsultation =\n    activeHistory.find((c) => c.status !== \'\354\231\204\353\243\214\') || activeHistory[0] || null;\n\n  return {\n    customer: matchedCustomer,\n    activeConsultation,\n    history: activeHistory,\n    archivedHistoryCount: archivedCount,\n  };\n}\n\n/**\n * Reassigns the active consultation to the current agent (\'\353\202\264\352\260\200 \354\235\264\354\226\264\353\260\233\352\270\260\' Takeover feature)\n */\nexport function takeoverConsultation(\n  consultationId: string,\n  newAgentName: string,\n  consultations: Consultation[]\n): Consultation[] {\n  return consultations.map((item) => {\n    if (item.id === consultationId) {\n      return {\n        ...item,\n        agent_name: newAgentName,\n        sub_status: `${item.sub_status || \'\'} [${newAgentName} \354\203\201\353\213\264\354\202\254 \353\213\264\353\213\271\354\236\220 \353\263\200\352\262\275 \354\235\264\354\226\264\353\260\233\352\270\260 \354\231\204\353\243\214]`.trim(),\n        updated_at: new Date().toISOString(),\n      };\n    }\n    return item;\n  });\n}\n"
    }
