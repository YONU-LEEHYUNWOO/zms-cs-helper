nt_number?: string;\n  account_holder?: string;\n  is_blacklist: boolean;\n  special_note?: string;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface InternalAgent {\n  id: string;\n  agent_name: string;\n  agent_status: \'\355\231\234\354\204\261\355\231\224\' | \'\353\271\204\355\231\234\354\204\261\355\231\224\';\n  created_at: string;\n}\n\nexport interface SavedTemplate {\n  id: string;\n  template_title: string;\n  content: string;\n  created_by: string;\n}\n\nexport interface CallLog {\n  id: string;\n  customer_id?: string;\n  phone_number: string;\n  audio_url?: string;\n  stt_script?: string;\n  ai_summary?: string;\n  created_at: string;\n}\n\nexport interface Consultation {\n  id: string;\n  customer_id: string;\n  call_log_id?: string;\n  user_type: UserType;\n  parking_type: ParkingType;\n  parking_name?: string;\n  product_number?: string;\n  region?: string;\n  hope_date?: string;\n  inquiry_type: InquiryType;\n  status: ConsultationStatus;\n  sub_status?: string; // e.g., \"\353\266\200\354\236\254\354\244\221 1\354\260\250\", \"\352\260\234\353\260\234\355\214\200 \355\231\225\354\235\270 \353\214\200\352\270\260\"\n  agent_name: string;\n  summary: string;\n  created_at: string;\n  updated_at: string;\n  is_archived?: boolean; // True if older than 3 months\n}\n\nexport interface AgentTask {\n  id: string;\n  consultation_id?: string;\n  agent_name: string;\n  task_title: string;\n  due_date: string;\n  is_completed: boolean;\n}\n\nexport interface ParkingSpot {\n  id: string;\n  name: string;\n  region: string;\n  address: string;\n  price_per_hour: number;\n  allowed_car_types: CarType[];\n  available_spaces: number;\n  is_active: boolean;\n}\n"
