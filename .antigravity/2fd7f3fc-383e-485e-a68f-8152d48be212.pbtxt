  user_input {
    user_response: "\354\235\264\354\231\200 \352\260\231\354\235\200 \355\231\224\353\251\264\354\235\264 \354\236\210\353\212\224 \354\225\261\354\235\204 \353\247\214\353\223\244\354\226\264 \354\244\230. HTML\354\227\220\354\204\234 \354\235\264\353\257\270\354\247\200\353\245\274 \355\225\253\353\247\201\355\201\254\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n\n# ZMS_CS_HELPER\n\n# \360\237\223\221 [\354\265\234\354\242\205 \355\206\265\355\225\251 \352\270\260\355\232\215\354\204\234] AI \352\270\260\353\260\230 \354\243\274\354\260\250 \352\263\265\354\234\240 \354\204\234\353\271\204\354\212\244 \355\206\265\355\225\251 CS \352\264\200\353\246\254 \355\224\214\353\236\253\355\217\274\n\n## 1. \355\224\204\353\241\234\354\240\235\355\212\270 \352\260\234\354\232\224 \353\260\217 \353\252\251\354\240\201\n\n- **\353\260\260\352\262\275**: \354\271\264\354\271\264\354\230\244 \354\203\201\353\213\264\355\206\241(\352\264\200\353\246\254\354\236\220 \354\204\274\355\204\260)\352\263\274 \354\234\240\354\204\240 \354\240\204\355\231\224(\354\235\270\355\204\260\353\204\267 \354\240\204\355\231\224\352\270\260)\353\245\274 \353\217\231\354\213\234\354\227\220 \354\235\221\353\214\200\355\225\230\353\212\224 \352\263\274\354\240\225\354\227\220\354\204\234 \354\203\201\353\213\264 \354\235\264\353\240\245 \354\234\240\354\213\244, \352\262\260\354\240\234 \354\227\254\353\266\200 \355\214\214\354\225\205 \353\266\210\352\260\200, \353\213\264\353\213\271\354\236\220 \353\260\260\354\240\225 \353\263\200\352\262\275 \354\213\234 \355\236\210\354\212\244\355\206\240\353\246\254 \353\257\270\352\263\265\354\234\240\353\241\234 \354\235\270\355\225\234 \354\232\264\354\230\201 \355\230\274\354\204\240 \353\260\234\354\203\235. \352\270\260\354\241\264 \353\205\271\354\267\250 \354\213\234\354\212\244\355\205\234(`http://202.30.232.240/dial/call_list.jsp`)\354\235\204 \354\235\274\354\235\274\354\235\264 \354\210\230\353\217\231 \355\231\225\354\235\270\355\225\230\354\227\254 \353\214\200\355\231\224 \353\202\264\354\232\251\354\235\204 \355\214\214\354\225\205\355\225\230\353\215\230 \354\227\205\353\254\264 \353\271\204\355\232\250\354\234\250 \354\241\264\354\236\254.\n- **\353\252\251\354\240\201**: \354\243\274\354\260\250 \352\263\265\354\234\240 \354\204\234\353\271\204\354\212\244 \355\212\271\354\204\261\354\227\220 \353\247\236\354\266\230 **\352\263\240\352\260\235 DB \354\236\220\354\202\260\355\231\224**, **\354\204\270\353\266\204\355\231\224\353\220\234 \354\260\250\354\242\205/\354\203\201\355\203\234 \352\264\200\353\246\254**, **\354\203\201\353\213\264\354\202\254 \352\260\204 \354\231\204\353\262\275\355\225\234 \354\235\264\353\240\245 \354\235\270\354\210\230\354\235\270\352\263\204 \354\213\234\354\212\244\355\205\234(\352\262\200\354\203\211/\355\212\270\353\236\230\355\202\271)**, **\354\236\220\353\217\231 STT & AI \353\205\271\354\267\250 \354\232\224\354\225\275**, **\353\213\250\352\263\204\353\263\204 \353\252\250\353\223\210 \352\262\260\355\225\251 \354\225\204\355\202\244\355\205\215\354\262\230**\353\245\274 \352\265\254\354\266\225\355\225\230\354\227\254 \354\232\264\354\230\201\355\214\200 \353\202\264 \354\235\221\353\214\200 \352\265\254\353\251\215\352\263\274 \353\247\210\352\260\220 \353\210\204\353\235\275\354\235\204 \354\240\234\353\241\234\355\231\224\355\225\250.\n- **\353\260\260\355\217\254 \353\214\200\354\203\201**: \354\202\254\353\202\264 \354\232\264\354\230\201\355\214\200 (SaaS\355\230\225 \354\226\264\353\223\234\353\257\274 \354\233\271 \354\225\240\355\224\214\353\246\254\354\274\200\354\235\264\354\205\230)\n\n## 2. \352\270\260\354\210\240 \354\212\244\355\203\235 \353\260\217 \353\252\250\353\223\210\355\230\225 \354\227\260\353\217\231 \354\225\204\355\202\244\355\205\215\354\262\230 (\354\240\220\354\247\204\354\240\201 \352\270\260\353\212\245 \352\262\260\355\225\251 \354\204\244\352\263\204)\n\n\355\225\234 \353\262\210\354\227\220 \353\214\200\352\267\234\353\252\250 \354\227\260\353\217\231\354\235\204 \354\247\204\355\226\211\355\225\240 \353\225\214 \353\260\234\354\203\235\355\225\230\353\212\224 \354\230\244\353\245\230\353\245\274 \353\260\251\354\247\200\355\225\230\352\270\260 \354\234\204\355\225\264 **\354\204\234\353\271\204\354\212\244-\353\246\254\355\217\254\354\247\200\355\206\240\353\246\254 \355\214\250\355\204\264(Service-Repository Pattern)** \353\260\217 **\354\235\264\353\262\244\355\212\270 \352\270\260\353\260\230(Event-Driven) \353\260\261\354\227\224\353\223\234 \354\225\204\355\202\244\355\205\215\354\262\230**\353\245\274 \354\240\201\354\232\251\355\225\251\353\213\210\353\213\244.\n\n- **\355\224\204\353\241\240\355\212\270\354\227\224\353\223\234**: Next.js 14 (App Router) + Tailwind CSS + Shadcn UI\n- **\353\260\261\354\227\224\353\223\234/DB**: Supabase (PostgreSQL, Realtime DB, Edge Functions)\n- **\353\213\250\352\263\204\353\263\204 \354\227\260\353\217\231 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270**:\n    - **1\353\213\250\352\263\204 (\353\252\250\353\223\210 \352\270\260\353\260\230 \352\265\254\354\204\261)**: \354\210\230\353\217\231 \353\251\224\353\252\250/\354\236\205\353\240\245 \352\270\260\353\260\230 CS \354\226\264\353\223\234\353\257\274 \352\270\260\353\263\270 \354\213\234\354\212\244\355\205\234 \352\265\254\354\266\225. \353\205\271\354\267\250 \355\214\214\354\235\274 URL \354\227\260\353\217\231 \354\235\270\355\204\260\355\216\230\354\235\264\354\212\244 \354\204\244\352\263\204.\n    - **2\353\213\250\352\263\204 (STT & AI \354\232\224\354\225\275 \354\227\260\353\217\231)**: CTI \354\204\234\353\262\204(`http://202.30.232.240/dial/call_list.jsp`) \354\275\234 \353\241\234\352\267\270 \354\210\230\354\213\240 \342\236\224 Whisper / OpenAI / AICC STT \354\227\224\354\247\204 \342\236\224 LLM \354\232\224\354\225\275 \342\236\224 `call_logs` DB \354\236\220\353\217\231 \354\240\200\354\236\245.\n    - **3\353\213\250\352\263\204 (\354\271\264\354\271\264\354\230\244\355\206\241 & \354\226\264\353\223\234\353\257\274 \354\227\260\353\217\231)**: \354\271\264\354\271\264\354\230\244 \354\203\201\353\213\264\355\206\241 API \353\260\217 \354\236\220\354\202\254 \354\226\264\353\223\234\353\257\274 \353\247\244\353\254\274 \354\266\224\354\262\234 API \352\262\260\355\225\251.\n\n## 3. \355\225\265\354\213\254 DB \354\212\244\355\202\244\353\247\210 \353\260\217 \353\215\260\354\235\264\355\204\260 \352\265\254\354\241\260 (\354\240\225\353\260\200\355\231\224)\n\n> **\360\237\222\241 \352\260\234\353\260\234 \355\214\201:** \353\205\270\354\205\230 \355\205\214\354\235\264\353\270\224\353\241\234 \353\263\200\355\231\230\355\225\230\352\261\260\353\202\230 Supabase SQL Editor\354\227\220 \352\267\270\353\214\200\353\241\234 \353\266\231\354\227\254\353\204\243\354\226\264 \354\202\254\354\232\251\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n> \n\n### \360\237\223\212 \355\205\214\354\235\264\353\270\224 1: \352\263\240\352\260\235 \353\260\217 \354\260\250\353\237\211 \353\247\210\354\212\244\355\204\260 (`customers`)\n\n| **\354\273\254\353\237\274\353\252\205 (\355\225\204\353\223\234)** | **\353\215\260\354\235\264\355\204\260 \355\203\200\354\236\205** | **\354\240\234\354\225\275 \354\241\260\352\261\264 / \354\204\240\355\203\235\354\247\200** | **\354\204\244\353\252\205** |\n| --- | --- | --- | --- |\n| `id` | UUID | PRIMARY KEY, \352\270\260\353\263\270\352\260\222 \354\203\235\354\204\261 | \352\263\240\352\260\235 \352\263\240\354\234\240 ID |\n| `phone_number` | VARCHAR | NOT NULL, UNIQUE | **\352\263\240\352\260\235 \355\225\270\353\223\234\355\217\260 \353\262\210\355\230\270 (\355\225\230\354\235\264\355\224\210 \354\240\234\352\261\260 \354\240\225\352\267\234\355\231\224 \354\240\200\354\236\245)** |\n| `car_number` | VARCHAR | NOT NULL, UNIQUE | \354\260\250\353\237\211 \353\262\210\355\230\270 (\354\230\210: 12\352\260\2003456, 000\352\260\2000000) |\n| `car_type` | VARCHAR | \352\262\275\354\260\250, \354\206\214\355\230\225\354\204\270\353\213\250, \354\244\200\354\244\221\355\230\225\354\204\270\353\213\250, \354\244\221\355\230\225\354\204\270\353\213\250, \353\214\200\355\230\225\354\204\270\353\213\250, SUV, RV | \354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230 (\354\240\225\353\260\200 \354\204\270\353\266\204\355\231\224) |\n| `car_detail` | VARCHAR | - | \354\203\201\354\204\270 \354\260\250\354\242\205\353\252\205 (\354\230\210: \354\225\204\353\260\230\353\226\274, \354\206\214\353\202\230\355\203\200, \354\212\244\355\203\200\353\240\211\354\212\244 \353\223\261) |\n| `bank_name` | VARCHAR | - | \352\263\204\354\242\214 \354\240\225\353\263\264: \354\235\200\355\226\211\353\252\205 |\n| `account_number` | VARCHAR | - | \352\263\204\354\242\214 \354\240\225\353\263\264: \352\263\204\354\242\214\353\262\210\355\230\270 |\n| `account_holder` | VARCHAR | - | \352\263\204\354\242\214 \354\240\225\353\263\264: \354\230\210\352\270\210\354\243\274\353\252\205 |\n| `is_blacklist` | BOOLEAN | DEFAULT FALSE | [\354\266\224\354\262\234 \352\270\260\353\212\245] \353\270\224\353\236\231\353\246\254\354\212\244\355\212\270(\354\203\201\354\212\265 \353\266\200\354\240\225\354\243\274\354\260\250/\354\225\205\354\204\261) \354\227\254\353\266\200 |\n| `special_note` | TEXT | - | [\354\266\224\354\262\234 \352\270\260\353\212\245] \355\212\271\354\235\264\354\202\254\355\225\255 \353\260\217 \354\232\224\354\243\274\354\235\230 \355\201\264\353\240\210\354\236\204 \353\251\224\353\252\250 |\n| `created_at` | TIMESTAMP | DEFAULT NOW() | \353\223\261\353\241\235 \354\235\274\354\213\234 |\n| `updated_at` | TIMESTAMP | DEFAULT NOW() | \354\265\234\354\242\205 \354\210\230\354\240\225 \354\235\274\354\213\234 |\n\n### \360\237\223\212 \355\205\214\354\235\264\353\270\224 2: \354\202\254\353\202\264 \354\203\201\353\213\264 \354\247\201\354\233\220 \353\247\210\354\212\244\355\204\260 (`internal_agents`)\n\n| **\354\273\254\353\237\274\353\252\205 (\355\225\204\353\223\234)** | **\353\215\260\354\235\264\355\204\260 \355\203\200\354\236\205** | **\354\240\234\354\225\275 \354\241\260\352\261\264 / \354\204\240\355\203\235\354\247\200** | **\354\204\244\353\252\205** |\n| --- | --- | --- | --- |\n| `id` | UUID | PRIMARY KEY, \352\270\260\353\263\270\352\260\222 \354\203\235\354\204\261 | \354\247\201\354\233\220 \352\263\240\354\234\240 ID |\n| `agent_name` | VARCHAR | NOT NULL, UNIQUE | \354\203\201\353\213\264 \354\247\201\354\233\220 \354\235\264\353\246\204 (\354\235\270\354\202\254 \352\264\200\353\246\254 \354\227\260\353\217\231) |\n| `agent_status` | VARCHAR | \355\231\234\354\204\261\355\231\224, \353\271\204\355\231\234\354\204\261\355\231\224 | \355\207\264\354\202\254\354\236\220 \353\260\217 \353\260\260\354\240\225 \354\240\234\354\231\270 \352\264\200\353\246\254\354\232\251 \354\203\201\355\203\234 |\n| `created_at` | TIMESTAMP | DEFAULT NOW() | \353\223\261\353\241\235 \354\235\274\354\213\234 |\n\n### \360\237\223\212 \355\205\214\354\235\264\353\270\224 3: \354\236\220\354\243\274 \354\223\260\353\212\224 \353\260\234\354\206\241 \353\254\270\352\265\254/\353\247\244\355\201\254\353\241\234 (`saved_templates`)\n\n| **\354\273\254\353\237\274\353\252\205 (\355\225\204\353\223\234)** | **\353\215\260\354\235\264\355\204\260 \355\203\200\354\236\205** | **\354\240\234\354\225\275 \354\241\260\352\261\264 / \354\204\240\355\203\235\354\247\200** | **\354\204\244\353\252\205** |\n| --- | --- | --- | --- |\n| `id` | UUID | PRIMARY KEY, \352\270\260\353\263\270\352\260\222 \354\203\235\354\204\261 | \355\205\234\355\224\214\353\246\277 \352\263\240\354\234\240 ID |\n| `template_title` | VARCHAR | NOT NULL | \355\205\234\355\224\214\353\246\277 \354\240\234\353\252\251 (\354\230\210: \"\352\263\265\354\234\240\354\236\220 \353\266\200\354\236\254\354\244\221 \354\225\210\353\202\264\", \"\355\231\230\353\266\210 \354\226\221\354\213\235 \354\232\224\354\262\255\") |\n| `content` | TEXT | NOT NULL | \353\260\234\354\206\241 \353\254\270\352\265\254 \353\263\270\353\254\270 (\354\271\230\355\231\230\354\236\220 \354\247\200\354\233\220, \354\230\210: `#{car_number}`) |\n| `created_by` | VARCHAR | REFERENCES `internal_agents.agent_name` | \354\236\221\354\204\261\354\236\220 (\352\263\265\354\232\251 \355\230\271\354\235\200 \354\203\201\353\213\264\354\233\220 \352\260\234\354\235\270\354\232\251 \353\266\204\353\245\230 \352\260\200\353\212\245) |\n\n### \360\237\223\212 \355\205\214\354\235\264\353\270\224 4: \355\206\265\355\231\224 \353\205\271\354\267\250 \353\260\217 \354\236\220\353\217\231 STT \354\235\264\353\240\245 (`call_logs`)\n\n| **\354\273\254\353\237\274\353\252\205 (\355\225\204\353\223\234)** | **\353\215\260\354\235\264\355\204\260 \355\203\200\354\236\205** | **\354\240\234\354\225\275 \354\241\260\352\261\264 / \354\204\240\355\203\235\354\247\200** | **\354\204\244\353\252\205** |\n| --- | --- | --- | --- |\n| `id` | UUID | PRIMARY KEY, \352\270\260\353\263\270\352\260\222 \354\203\235\354\204\261 | \355\206\265\355\231\224 \352\270\260\353\241\235 \352\263\240\354\234\240 ID |\n| `customer_id` | UUID | FOREIGN KEY (`customers.id`) | \354\227\260\353\217\231\353\220\234 \352\263\240\352\260\235 ID |\n| `phone_number` | VARCHAR | NOT NULL | \354\210\230/\353\260\234\354\213\240 \354\240\204\355\231\224\353\262\210\355\230\270 |\n| `audio_url` | TEXT | - | \353\205\271\354\267\250 \355\214\214\354\235\274 URL (`http://202.30.232.240/...`) |\n| `stt_script` | TEXT | - | STT \355\205\215\354\212\244\355\212\270 \354\240\204\354\262\264 \353\263\200\355\231\230 \352\262\260\352\263\274 |\n| `ai_summary` | TEXT | - | AI\352\260\200 \353\214\200\355\231\224\353\241\235\354\227\220\354\204\234 \353\217\204\354\266\234\355\225\234 \355\225\265\354\213\254 \354\232\224\352\265\254\354\202\254\355\225\255 \354\232\224\354\225\275 |\n| `created_at` | TIMESTAMP | DEFAULT NOW() | \355\206\265\35