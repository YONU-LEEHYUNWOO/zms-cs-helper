        replacement_content: "export const CenterCustomerForm: React.FC<CenterCustomerFormProps> = ({\n  customer,\n  parkingSpots,\n  onChangeCustomerField,\n  onSelectRecommendedParking,\n}) => {\n  const [showRecommendation, setShowRecommendation] = useState(false);\n\n  const carTypes: CarType[] = [\n    \'\352\262\275\354\260\250\',\n    \'\354\206\214\355\230\225\354\204\270\353\213\250\',\n    \'\354\244\200\354\244\221\355\230\225\354\204\270\353\213\250\',\n    \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n    \'\353\214\200\355\230\225\354\204\270\353\213\250\',\n    \'SUV\',\n    \'RV\',\n  ];\n\n  // Match available parking spots that fit this customer\'s car_type\n  const matchedSpots = customer\n    ? parkingSpots.filter((spot) => spot.allowed_car_types.includes(customer.car_type))\n    : parkingSpots;\n\n  return (\n    <div className=\"bg-white rounded-xl border border-slate-200 p-4 h-full shadow-sm flex flex-col overflow-y-auto\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-4 pb-2 border-b border-slate-100\">\n        <h2 className=\"text-sm font-semibold text-slate-900 flex items-center gap-2\">\n          <Car className=\"w-4 h-4 text-blue-600\" />\n          Customer Profile (\352\263\240\352\260\235 \353\260\217 \354\260\250\353\237\211 \353\247\210\354\212\244\355\204\260)\n        </h2>\n        <span className=\"px-2 py-0.5 bg-blue-50 text-blue-700 text-[11px] font-bold rounded-full flex items-center gap-1\">\n          <ShieldCheck className=\"w-3.5 h-3.5 text-blue-600\" /> Verified DB\n        </span>\n      </div>\n\n      <form className=\"space-y-4 flex-1\">\n        {/* Contact Details */}\n        <div className=\"space-y-2\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            CONTACT DETAILS (\352\263\240\352\260\235 \354\227\260\353\235\275\354\262\230)\n          </h3>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                Phone Number (\354\240\204\355\231\224\353\262\210\355\230\270)\n              </label>\n              <input\n                type=\"tel\"\n                value={customer ? formatPhoneNumber(customer.phone_number) : \'\'}\n                onChange={(e) => onChangeCustomerField(\'phone_number\', e.target.value)}\n                placeholder=\"010-1234-5678\"\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                Account Email (\354\235\264\353\251\224\354\235\274)\n              </label>\n              <input\n                type=\"email\"\n                defaultValue=\"customer@example.com\"\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Primary Vehicle Info */}\n        <div className=\"space-y-2 pt-2 border-t border-slate-100\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            PRIMARY VEHICLE (\354\260\250\353\237\211 \354\240\225\353\260\200 \354\204\270\353\266\204\355\231\224)\n          </h3>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                License Plate (\354\260\250\353\237\211\353\262\210\355\230\270)\n              </label>\n              <input\n                type=\"text\"\n                value={customer?.car_number || \'\'}\n                onChange={(e) => onChangeCustomerField(\'car_number\', e.target.value)}\n                placeholder=\"12\352\260\2003456\"\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 font-mono uppercase font-bold focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                Car Type (\354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230)\n              </label>\n              <div className=\"relative\">\n                <select\n                  value={customer?.car_type || \'\354\244\221\355\230\225\354\204\270\353\213\250\'}\n                  onChange={(e) => onChangeCustomerField(\'car_type\', e.target.value as CarType)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-1.5 text-xs text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white font-medium cursor-pointer\"\n                >\n                  {carTypes.map((ct) => (\n                    <option key={ct} value={ct}>\n                      {ct}\n                    </option>\n                  ))}\n                </select>\n                <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400\" />\n              </div>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n              Detailed Model (\354\203\201\354\204\270 \354\260\250\354\242\205\353\252\205)\n            </label>\n            <input\n              type=\"text\"\n              value={customer?.car_detail || \'\'}\n              onChange={(e) => onChangeCustomerField(\'car_detail\', e.target.value)}\n              placeholder=\"\354\230\210: \354\217\230\353\202\230\355\203\200 DN8, \354\225\204\353\260\230\353\226\274 CN7, \355\214\260\353\246\254\354\204\270\354\235\264\353\223\234\"\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n            />\n          </div>\n        </div>\n\n        {/* Payment Method / Bank Info */}\n        <div className=\"space-y-2 pt-2 border-t border-slate-100\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            PAYMENT & REFUND BANK (\354\240\225\354\202\260 \353\260\217 \355\231\230\353\266\210 \352\263\204\354\242\214)\n          </h3>\n          <div className=\"bg-slate-50 border border-slate-200 rounded-lg p-3 space-y-2\">\n            <div className=\"grid grid-cols-3 gap-2\">\n              <div>\n                <label className=\"text-[11px] text-slate-500 block mb-0.5\">\354\235\200\355\226\211\353\252\205</label>\n                <input\n                  type=\"text\"\n                  value={customer?.bank_name || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'bank_name\', e.target.value)}\n                  placeholder=\"\354\213\240\355\225\234\354\235\200\355\226\211\"\n                  className=\"w-full bg-white border border-slate-200 rounded px-2 py-1 text-xs text-slate-900\"\n                />\n              </div>\n              <div className=\"col-span-2\">\n                <label className=\"text-[11px] text-slate-500 block mb-0.5\">\352\263\204\354\242\214\353\262\210\355\230\270</label>\n                <input\n                  type=\"text\"\n                  value={customer?.account_number || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'account_number\', e.target.value)}\n                  placeholder=\"110-123-456789\"\n                  className=\"w-full bg-white border border-slate-200 rounded px-2 py-1 text-xs text-slate-900 font-mono\"\n                />