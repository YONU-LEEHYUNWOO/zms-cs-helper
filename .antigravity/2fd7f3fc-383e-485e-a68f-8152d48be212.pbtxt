        target_content: "        {/* Card 2: Resolution Status & Canned Responses & Notes */}\n        <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between\">\n          <div className=\"space-y-3\">\n            {/* Resolution Status Major Chips */}\n            <div className=\"pb-2 border-b border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 mb-2 flex items-center gap-1.5\">\n                <CheckCircle className=\"w-4 h-4 text-blue-600\" />\n                \354\247\204\354\262\231\353\217\204 \354\203\201\355\203\234 \353\214\200\353\266\204\353\245\230 & \354\206\214\353\266\204\353\245\230\n              </h2>\n\n              <div className=\"flex flex-wrap gap-1.5\">\n                {statusList.map((st) => (\n                  <button\n                    key={st}\n                    onClick={() => onChangeStatus(st)}\n                    className={`px-3 py-1.5 text-xs rounded-lg font-bold transition-all ${\n                      activeConsultation?.status === st\n                        ? \'bg-blue-600 text-white shadow-sm ring-2 ring-blue-300\'\n                        : \'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200\'\n                    }`}\n                  >\n                    {st}\n                  </button>\n                ))}\n              </div>\n\n              {/* Sub Status Detail Input */}\n              <div className=\"mt-2.5\">\n                <label className=\"text-[11px] text-slate-500 font-bold uppercase tracking-wider block mb-1\">\n                  \354\203\201\354\204\270 \354\206\214\353\266\204\353\245\230 \354\202\254\354\234\240 (\354\230\210: \353\266\200\354\236\254\354\244\221 1\354\260\250, \352\260\234\353\260\234\355\214\200 \355\231\225\354\235\270 \353\214\200\352\270\260)\n                </label>\n                <input\n                  type=\"text\"\n                  value={activeConsultation?.sub_status || \'\'}\n                  onChange={(e) =>\n                    onChangeStatus(activeConsultation.status, e.target.value)\n                  }\n                  placeholder=\"\354\203\201\354\204\270 \354\202\254\354\234\240 \353\260\217 \355\230\204\354\236\245 \354\203\201\355\231\251\354\235\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224...\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                />\n              </div>\n            </div>"
        replacement_content: "        {/* Card 2: Resolution Status & Canned Responses & Notes */}\n        <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between\">\n          <div className=\"space-y-3\">\n            {/* Mode Banner: Existing Edit vs New Registration */}\n            {isExistingConsultation ? (\n              <div className=\"p-2.5 bg-blue-50 border border-blue-200 rounded-lg text-xs flex items-center justify-between\">\n                <span className=\"font-bold text-blue-900 flex items-center gap-1.5\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse\"></span>\n                  \342\234\217\357\270\217 [\352\270\260\354\241\264 \354\203\201\353\213\264 \354\235\264\353\240\245 \354\210\230\354\240\225 \354\244\221] (ID: {activeConsultation.id.slice(0, 16)})\n                </span>\n                {onStartNewConsultation && (\n                  <button\n                    type=\"button\"\n                    onClick={onStartNewConsultation}\n                    className=\"px-2.5 py-1 bg-white hover:bg-slate-100 text-blue-700 font-bold rounded-md border border-blue-300 text-[11px] shadow-sm transition-colors flex items-center gap-1\"\n                  >\n                    \342\236\225 \354\213\240\352\267\234 \354\203\201\353\213\264 \354\236\221\354\204\261\354\234\274\353\241\234 \354\240\204\355\231\230\n                  </button>\n                )}\n              </div>\n            ) : (\n              <div className=\"p-2 bg-emerald-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900 flex items-center gap-1.5\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-600\"></span>\n                \360\237\206\225 [\354\213\240\352\267\234 \354\203\201\353\213\264 \353\223\261\353\241\235 \353\252\250\353\223\234] \353\202\264\354\232\251\354\235\204 \354\203\210\353\241\234 \352\270\260\353\241\235\355\225\230\352\263\240 \354\240\200\354\236\245\355\225\230\354\204\270\354\232\224.\n              </div>\n            )}\n\n            {/* Resolution Status Major Chips */}\n            <div className=\"pb-2 border-b border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 mb-2 flex items-center gap-1.5\">\n                <CheckCircle className=\"w-4 h-4 text-blue-600\" />\n                \354\247\204\354\262\231\353\217\204 \354\203\201\355\203\234 \353\214\200\353\266\204\353\245\230 & \354\206\214\353\266\204\353\245\230\n              </h2>\n\n              <div className=\"flex flex-wrap gap-1.5\">\n                {statusList.map((st) => (\n                  <button\n                    key={st}\n                    onClick={() => onChangeStatus(st)}\n                    className={`px-3 py-1.5 text-xs rounded-lg font-bold transition-all ${\n                      activeConsultation?.status === st\n                        ? \'bg-blue-600 text-white shadow-sm ring-2 ring-blue-300\'\n                        : \'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200\'\n                    }`}\n                  >\n                    {st}\n                  </button>\n                ))}\n              </div>\n\n              {/* Sub Status Detail Input */}\n              <div className=\"mt-2.5\">\n                <label className=\"text-[11px] text-slate-500 font-bold uppercase tracking-wider block mb-1\">\n                  \354\203\201\354\204\270 \354\206\214\353\266\204\353\245\230 \354\202\254\354\234\240 (\354\230\210: \353\266\200\354\236\254\354\244\221 1\354\260\250, \352\260\234\353\260\234\355\214\200 \355\231\225\354\235\270 \353\214\200\352\270\260)\n                </label>\n                <input\n                  type=\"text\"\n                  value={activeConsultation?.sub_status || \'\'}\n                  onChange={(e) =>\n                    onChangeStatus(activeConsultation?.status || \'\354\240\221\354\210\230\', e.target.value)\n                  }\n                  placeholder=\"\354\203\201\354\204\270 \354\202\254\354\234\240 \353\260\217 \355\230\204\354\236\245 \354\203\201\355\231\251\354\235\204 \354\236\220\354\234\240\353\241\255\352\262\214 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224...\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                />\n              </div>\n            </div>"
