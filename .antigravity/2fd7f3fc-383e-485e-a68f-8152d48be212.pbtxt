  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { SideNavBar } from \'./components/SideNavBar\';\nimport { TopNavBar } from \'./components/TopNavBar\';\nimport { LeftInteractionPad } from \'./components/workspace/LeftInteractionPad\';\nimport { CenterCustomerForm } from \'./components/workspace/CenterCustomerForm\';\nimport { RightTaskManager } from \'./components/workspace/RightTaskManager\';\nimport { CalendarView } from \'./components/calendar/CalendarView\';\nimport { KanbanBoardView } from \'./components/kanban/KanbanBoardView\';\nimport { AdminPanel } from \'./components/admin/AdminPanel\';\nimport { LogsArchiveView } from \'./components/logs/LogsArchiveView\';\nimport { SupportAiKms } from \'./components/support/SupportAiKms\';\n\nimport {\n  Customer,\n  InternalAgent,\n  SavedTemplate,\n  CallLog,\n  Consultation,\n  AgentTask,\n  ParkingSpot,\n  ConsultationStatus,\n} from \'./types\';\n\nimport {\n  INITIAL_AGENTS,\n  INITIAL_TEMPLATES,\n  INITIAL_CUSTOMERS,\n  INITIAL_CALL_LOGS,\n  INITIAL_CONSULTATIONS,\n  INITIAL_TASKS,\n  INITIAL_PARKING_SPOTS,\n} from \'./lib/mockData\';\n\nimport { takeoverConsultation } from \'./lib/services/customerService\';\nimport { fetchCTICallLogs } from \'./lib/services/sttService\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\n    \'workspace\' | \'calendar\' | \'kanban\' | \'admin\' | \'logs\' | \'support\'\n  >(\'workspace\');\n\n  // Master State Databases\n  const [customers, setCustomers] = useState<Customer[]>(INITIAL_CUSTOMERS);\n  const [agents, setAgents] = useState<InternalAgent[]>(INITIAL_AGENTS);\n  const [templates, setTemplates] = useState<SavedTemplate[]>(INITIAL_TEMPLATES);\n  const [callLogs, setCallLogs] = useState<CallLog[]>(INITIAL_CALL_LOGS);\n  const [consultations, setConsultations] = useState<Consultation[]>(INITIAL_CONSULTATIONS);\n  const [tasks, setTasks] = useState<AgentTask[]>(INITIAL_TASKS);\n  const [parkingSpots] = useState<ParkingSpot[]>(INITIAL_PARKING_SPOTS);\n\n  // Active Workspace Selection State\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer>(INITIAL_CUSTOMERS[0]);\n  const [currentAgentName, setCurrentAgentName] = useState<string>(\'\352\271\200\354\262\240\354\210\230\');\n  const [notes, setNotes] = useState<string>(\n    \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245 \354\260\250\353\213\250\352\270\260 \353\257\270\354\235\270\354\213\235 \353\254\270\354\235\230\353\241\234 \354\233\220\352\262\251 \352\260\234\353\260\251 \354\262\230\353\246\254 \354\231\204\353\243\214\355\225\250. \354\266\234\354\260\250 \353\252\250\353\213\210\355\204\260\353\247\201 \354\230\210\354\240\225.\'\n  );\n\n  // Active consultation tied to selected customer\n  const activeConsultation =\n    consultations.find(\n      (c) => c.customer_id === selectedCustomer.id && c.status !== \'\354\231\204\353\243\214\'\n    ) || consultations.find((c) => c.customer_id === selectedCustomer.id) || consultations[0];\n\n  const activeCallLog =\n    callLogs.find((cl) => cl.customer_id === selectedCustomer.id) || callLogs[0];\n\n  // Load live CTI logs on boot\n  useEffect(() => {\n    fetchCTICallLogs().then((logs) => {\n      if (logs && logs.length > 0) {\n        setCallLogs((prev) => [...logs, ...prev]);\n      }\n    });\n  }, []);\n\n  // Handlers for Workspace\n  const handleUpdateCustomerField = (field: keyof Customer, value: any) => {\n    setCustomers((prev) =>\n      prev.map((c) => (c.id === selectedCustomer.id ? { ...c, [field]: value } : c))\n    );\n    setSelectedCustomer((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const handleSaveLog = (summaryText: string) => {\n    const updatedSummary = summaryText || notes;\n    setConsultations((prev) =>\n      prev.map((c) =>\n        c.id === activeConsultation.id\n          ? {\n              ...c,\n              summary: updatedSummary,\n              agent_name: currentAgentName,\n              updated_at: new Date().toISOString(),\n            }\n          : c\n      )\n    );\n    alert(`[\354\240\200\354\236\245 \354\231\204\353\243\214] ${selectedCustomer.car_number} \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\204\261\352\263\265\354\240\201\354\234\274\353\241\234 \354\240\200\354\236\245\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`);\n  };\n\n  const handleChangeStatus = (newStatus: ConsultationStatus, subStatusReason?: string) => {\n    setConsultations((prev) =>\n      prev.map((c) =>\n        c.id === activeConsultation.id\n          ? {\n              ...c,\n              status: newStatus,\n              sub_status: subStatusReason !== undefined ? subStatusReason : c.sub_status,\n              updated_at: new Date().toISOString(),\n            }\n          : c\n      )\n    );\n  };\n\n  const handleAddTask = (title: string, dueDate: string) => {\n    const newTask: AgentTask = {\n      id: `task-${Date.now()}`,\n      consultation_id: activeConsultation.id,\n      agent_name: currentAgentName,\n      task_title: title,\n      due_date: dueDate,\n      is_completed: false,\n    };\n    setTasks((prev) => [newTask, ...prev]);\n  };\n\n  const handleToggleTask = (taskId: string) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.id === taskId ? { ...t, is_completed: !t.is_completed } : t))\n    );\n  };\n\n  const handleTakeoverConsultation = (consId: string) => {\n    setConsultations((prev) => takeoverConsultation(consId, currentAgentName, prev));\n    alert(`[\353\213\264\353\213\271\354\236\220 \353\263\200\352\262\275] \355\225\264\353\213\271 \354\203\201\353\213\264\352\261\264 \353\213\264\353\213\271\354\236\220\352\260\200 ${currentAgentName} \354\203\201\353\213\264\354\202\254\353\241\234 \353\263\200\352\262\275\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.`);\n  };\n\n  const handleSelectRecommendedParking = (spot: ParkingSpot) => {\n    setConsultations((prev) =>\n      prev.map((c) =>\n        c.id === activeConsultation.id\n          ? {\n              ...c,\n              parking_name: spot.name,\n              region: spot.region,\n              updated_at: new Date().toISOString(),\n            }\n          : c\n      )\n    );\n    alert(`[\354\266\224\354\262\234 \353\247\244\353\254\274 \354\240\201\354\232\251] ${spot.name} \354\243\274\354\260\250\354\236\245\354\235\264 \353\263\270 \354\203\201\353\213\264\352\261\264\354\227\220 \353\247\244\355\225\221\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.`);\n  };\n\n  // Handlers for Admin\n  const handleAddAgent = (agentName: string) => {\n    const newAgent: InternalAgent = {\n      id: `agent-${Date.now()}`,\n      agent_name: agentName,\n      agent_status: \'\355\231\234\354\204\261\355\231\224\',\n      created_at: new Date().toISOString(),\n    };\n    setAgents((prev) => [...prev, newAgent]);\n  };\n\n  const handleToggleAgentStatus = (agentId: string) => {\n    setAgents((prev) =>\n      prev.map((a) =>\n        a.id === agentId\n          ? { ...a, agent_status: a.agent_status === \'\355\231\234\354\204\261\355\231\224\' ? \'\353\271\204\355\231\234\354\204\261\355\231\224\' : \'\355\231\234\354\204\261\355\231\224\' }\n          : a\n      )\n    );\n  };\n\n  const handleAddTemplate = (title: string, content: string, createdBy: string) => {\n    const newTmpl: SavedTemplate = {\n      id: `tmpl-${Date.now()}`,\n      template_title: title,\n      content,\n      created_by: createdBy,\n    };\n    setTemplates((prev) => [...prev, newTmpl]);\n  };\n\n  const handleDeleteTemplate = (templateId: string) => {\n    setTemplates((prev) => prev.filter((t) => t.id !== templateId));\n  };\n\n  const handleToggleBlacklist = (customerId: string, note?: string) => {\n    setCustomers((prev) =>\n      prev.map((c) =>\n        c.id === customerId\n          ? {\n              ...c,\n              is_blacklist: !c.is_blacklist,\n              special_note: note || c.special_note || \'\353\270\224\353\236\231\353\246\254\354\212\244\355\212\270 \354\210\230\353\217\231 \354\203\201\355\203\234 \354\240\204\355\231\230\353\220\250\',\n            }\n          : c\n      )\n    );\n  };\n\n  return (\n    <div className=\"flex min-h-screen bg-slate-50 text-slate-900 font-sans antialiased overflow-hidden\">\n      {/* Side Navigation Bar */}\n      <SideNavBar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        agentName={currentAgentName}\n      />\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 flex flex-col md:ml-[260px] h-screen overflow-y-auto\">\n        {/* Top Navigation Bar with Normalization Search */}\n        <TopNavBar\n          customers={customers}\n          consultations={consultations}\n          agents={agents}\n          currentAgentName={currentAgentName}\n          setCurrentAgentName={setCurrentAgentName}\n          onSelectCustomer={(cust) => setSelectedCustomer(cust)}\n          onTakeoverConsultation={handleTakeoverConsultation}\n        />\n\n        {/* Dynamic View Routing */}\n        <main className=\"flex-1 p-6 bg-slate-50 overflow-y-auto\">\n          {activeTab === \'workspace\' && (\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 h-full max-w-[1600px] mx-auto\">\n              {/* Column 1: Interaction Pad (Left - Fluid 4 cols) */}\n              <section className=\"lg:col-span-4 flex flex-col gap-4\">\n                <LeftInteractionPad\n                  currentCallLog={activeCallLog}\n                  agents={agents}\n                  currentAgentName={currentAgentName}\n                  notes={notes}\n                  setNotes={setNotes}\n                  carNumber={selectedCustomer.car_number}\n                  onSaveLog={handleSaveLog}\n                />\n              </section>\n\n              {/* Column 2: Customer & Vehicle Form (Center - Fluid 5 cols) */}\n              <section className=\"lg:col-span-5 flex flex-col gap-4\">\n                <CenterCustomerForm\n                  customer={selectedCustomer}\n                  parkingSpots={parkingSpots}\n                  onChangeCustomerField={handleUpdateCustomerField}\n                  onSelectRecommendedParking={handleSelectRecommendedParking}\n                />\n              </section>\n\n              {/* Column 3: Status & Tasks (Right - Fixed intent 3 cols) */}\n              <section className=\"lg:col-span-3 flex flex-col gap-4\">\n                <RightTaskManager\n                  currentStatus={activeConsultation.status}\n                  subStatus={activeConsultation.sub_status || \'\'}\n                  savedTemplates={templates}\n                  tasks={tasks}\n                  currentCustomer={selectedCustomer}\n                  parkingName={activeConsultation.parking_name}\n                  onChangeStatus={handleChangeStatus}\n                  onAddTask={handleAddTask}\n                  onToggleTask={handleToggleTask}\n                />\n              </section>\n            </div>\n          )}\n\n          {activeTab === \'calendar\' && (\n            <CalendarView\n              consultations={consultations}\n              tasks={tasks}\n              currentAgentName={currentAgentName}\n            />\n          )}\n\n          {activeTab === \'kanban\' && (\n            <KanbanBoardView\n              consultations={consultations}\n              onUpdateStatus={(consId, newStatus) => {\n                setConsultations((prev) =>\n                  prev.map((c) => (c.id === consId ? { ...c, status: newStatus } : c))\n                );\n              }}\n            />\n          )}\n\n          {activeTab === \'admin\' && (\n            <AdminPanel\n              agents={agents}\n              templates={templates}\n              customers={customers}\n              onAddAgent={handleAddAgent}\n              onToggleAgentStatus={handleToggleAgentStatus}\n              onAddTemplate={handleAddTemplate}\n              onDeleteTemplate={handleDeleteTemplate}\n              onToggleBlacklist={handleToggleBlacklist}\n            />\n          )}\n\n          {activeTab === \'logs\' && (\n            <LogsArchiveView consultations={consultations} callLogs={callLogs} />\n          )}\n\n          {activeTab === \'support\' && <SupportAiKms consultations={consultations} />}\n        </main>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { SideNavBar } from \'./components/SideNavBar\';\nimport { TopNavBar } from \'./components/TopNavBar\';\nimport { LeftInteractionPad } from \'./components/workspace/LeftInteractionPad\';\nimport { MainConsultationHub } from \'./components/workspace/MainConsultationHub\';\nimport { CalendarView } from \'./components/calendar/CalendarView\';\nimport { KanbanBoardView } from \'./components/kanban/KanbanBoardView\';\nimport { AdminPanel } from \'./components/admin/AdminPanel\';\nimport { LogsArchiveView } from \'./components/logs/LogsArchiveView\';\nimport { SupportAiKms } from \'./components/support/SupportAiKms\';\n\nimport {\n  Customer,\n  InternalAgent,\n  SavedTemplate,\n  CallLog,\n  Consultation,\n  AgentTask,\n  ParkingSpot,\n  ConsultationStatus,\n} from \'./types\';\n\nimport {\n  INITIAL_AGENTS,\n  INITIAL_TEMPLATES,\n  INITIAL_CUSTOMERS,\n  INITIAL_CALL_LOGS,\n  INITIAL_CONSULTATIONS,\n  INITIAL_TASKS,\n  INITIAL_PARKING_SPOTS,\n} from \'./lib/mockData\';\n\nimport { takeoverConsultation } from \'./lib/services/customerService\';\nimport { fetchCTICallLogs } from \'./lib/services/sttService\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\n    \'workspace\' | \'calendar\' | \'kanban\' | \'admin\' | \'logs\' | \'support\'\n  >(\'workspace\');\n\n  // Master State Databases\n  const [customers, setCustomers] = useState<Customer[]>(INITIAL_CUSTOMERS);\n  const [agents, setAgents] = useState<InternalAgent[]>(INITIAL_AGENTS);\n  const [templates, setTemplates] = useState<SavedTemplate[]>(INITIAL_TEMPLATES);\n  const [callLogs, setCallLogs] = useState<CallLog[]>(INITIAL_CALL_LOGS);\n  const [consultations, setConsultations] = useState<Consultation[]>(INITIAL_CONSULTATIONS);\n  const [tasks, setTasks] = useState<AgentTask[]>(INITIAL_TASKS);\n  const [parkingSpots] = useState<ParkingSpot[]>(INITIAL_PARKING_SPOTS);\n\n  // Active Workspace Selection State\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer>(INITIAL_CUSTOMERS[0]);\n  const [currentAgentName, setCurrentAgentName] = useState<string>(\'\352\271\200\354\262\240\354\210\230\');\n  const [notes, setNotes] = useState<string>(\n    \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245 \354\260\250\353\213\250\352\270\260 \353\257\270\354\235\270\354\213\235 \353\254\270\354\235\230\353\241\234 \354\233\220\352\262\251 \352\260\234\353\260\251 \354\262\230\353\246\254 \354\231\204\353\243\214\355\225\250. \354\266\234\354\260\250 \353\252\250\353\213\210\355\204\260\353\247\201 \354\230\210\354\240\225.\'\n  );\n\n  // Active consultation tied to selected customer\n  const activeConsultation =\n    consultations.find(\n      (c) => c.customer_id === selectedCustomer.id && c.status !== \'\354\231\204\353\243\214\'\n    ) || consultations.find((c) => c.customer_id === selectedCustomer.id) || consultations[0];\n\n  const activeCallLog =\n    callLogs.find((cl) => cl.customer_id === selectedCustomer.id) || callLogs[0];\n\n  // Load live CTI logs on boot\n  useEffect(() => {\n    fetchCTICallLogs().then((logs) => {\n      if (logs && logs.length > 0) {\n        setCallLogs((prev) => [...logs, ...prev]);\n      }\n    });\n  }, []);\n\n  // Handlers for Workspace\n  const handleUpdateCustomerField = (field: keyof Customer, value: any) => {\n    setCustomers((prev) =>\n      prev.map((c) => (c.id === selectedCustomer.id ? { ...c, [field]: value } : c))\n    );\n    setSelectedCustomer((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const handleSaveLog = (summaryText: string) => {\n    const updatedSummary = summaryText || notes;\n    const existingIndex = consultations.findIndex(\n      (c) => c.customer_id === selectedCustomer.id && c.id === activeConsultation?.id\n    );\n\n    if (existingIndex !== -1) {\n      setConsultations((prev) =>\n        prev.map((c, idx) =>\n          idx === existingIndex\n            ? {\n                ...c,\n                summary: updatedSummary,\n                agent_name: currentAgentName,\n                updated_at: new Date().toISOString(),\n              }\n            : c\n        )\n      );\n    } else {\n      const newConsultation: Consultation = {\n        id: `cons-${Date.now()}`,\n        customer_id: selectedCustomer.id,\n        user_type: \'\354\202\254\354\232\251\354\236\220\',\n        parking_type: \'\354\235\274\354\243\274\354\260\250\',\n        parking_name: activeConsultation?.parking_name || \'\355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n        inquiry_type: \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n        status: activeConsultation?.status || \'\354\240\221\354\210\230\',\n        sub_status: activeConsultation?.sub_status || \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n        agent_name: currentAgentName,\n        summary: updatedSummary,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n        is_archived: false,\n      };\n      setConsultations((prev) => [newConsultation, ...prev]);\n    }\n  };\n\n  const handleChangeStatus = (newStatus: ConsultationStatus, subStatusReason?: string) => {\n    setConsultations((prev) =>\n      prev.map((c) =>\n        c.id === activeConsultation?.id\n          ? {\n              ...c,\n              status: newStatus,\n              sub_status: subStatusReason !== undefined ? subStatusReason : c.sub_status,\n              updated_at: new Date().toISOString(),\n            }\n          : c\n      )\n    );\n  };\n\n  const handleAddTask = (title: string, dueDate: string) => {\n    const newTask: AgentTask = {\n      id: `task-${Date.now()}`,\n      consultation_id: activeConsultation?.id,\n      agent_name: currentAgentName,\n      task_title: title,\n      due_date: dueDate,\n      is_completed: false,\n    };\n    setTasks((prev) => [newTask, ...prev]);\n  };\n\n  const handleToggleTask = (taskId: string) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.id === taskId ? { ...t, is_completed: !t.is_completed } : t))\n    );\n  };\n\n  const handleTakeoverConsultation = (consId: string) => {\n    setConsultations((prev) => takeoverConsultation(consId, currentAgentName, prev));\n    alert(`[\353\213\264\353\213\271\354\236\220 \353\263\200\352\262\275] \355\225\264\353\213\271 \354\203\201\353\213\264\352\261\264 \353\213\264\353\213\271\354\236\220\352\260\200 ${currentAgentName} \354\203\201\353\213\264\354\202\254\353\241\234 \353\263\200\352\262\275\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.`);\n  };\n\n  const handleSelectRecommendedParking = (spot: ParkingSpot) => {\n    setConsultations((prev) =>\n      prev.map((c) =>\n        c.id === activeConsultation?.id\n          ? {\n              ...c,\n              parking_name: spot.name,\n              region: spot.region,\n              updated_at: new Date().toISOString(),\n            }\n          : c\n      )\n    );\n    alert(`[\354\266\224\354\262\234 \353\247\244\353\254\274 \354\240\201\354\232\251] ${spot.name} \354\243\274\354\260\250\354\236\245\354\235\264 \353\263\270 \354\203\201\353\213\264\352\261\264\354\227\220 \353\247\244\355\225\221\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.`);\n  };\n\n  // Handlers for Admin\n  const handleAddAgent = (agentName: string) => {\n    const newAgent: InternalAgent = {\n      id: `agent-${Date.now()}`,\n      agent_name: agentName,\n      agent_status: \'\355\231\234\354\204\261\355\231\224\',\n      created_at: new Date().toISOString(),\n    };\n    setAgents((prev) => [...prev, newAgent]);\n  };\n\n  const handleToggleAgentStatus = (agentId: string) => {\n    setAgents((prev) =>\n      prev.map((a) =>\n        a.id === agentId\n          ? { ...a, agent_status: a.agent_status === \'\355\231\234\354\204\261\355\231\224\' ? \'\353\271\204\355\231\234\354\204\261\355\231\224\' : \'\355\231\234\354\204\261\355\231\224\' }\n          : a\n      )\n    );\n  };\n\n  const handleAddTemplate = (title: string, content: string, createdBy: string) => {\n    const newTmpl: SavedTemplate = {\n      id: `tmpl-${Date.now()}`,\n      template_title: title,\n      content,\n      created_by: createdBy,\n    };\n    setTemplates((prev) => [...prev, newTmpl]);\n  };\n\n  const handleDeleteTemplate = (templateId: string) => {\n    setTemplates((prev) => prev.filter((t) => t.id !== templateId));\n  };\n\n  const handleToggleBlacklist = (customerId: string, note?: string) => {\n    setCustomers((prev) =>\n      prev.map((c) =>\n        c.id === customerId\n          ? {\n              ...c,\n              is_blacklist: !c.is_blacklist,\n              special_note: note || c.special_note || \'\353\270\224\353\236\231\353\246\254\354\212\244\355\212\270 \354\210\230\353\217\231 \354\203\201\355\203\234 \354\240\204\355\231\230\353\220\250\',\n            }\n          : c\n      )\n    );\n  };\n\n  return (\n    <div className=\"flex min-h-screen bg-slate-50 text-slate-900 font-sans antialiased overflow-hidden\">\n      {/* Side Navigation Bar */}\n      <SideNavBar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        agentName={currentAgentName}\n      />\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 flex flex-col md:ml-[260px] h-screen overflow-y-auto\">\n        {/* Top Navigation Bar with Normalization Search */}\n        <TopNavBar\n          customers={customers}\n          consultations={consultations}\n          agents={agents}\n          currentAgentName={currentAgentName}\n          setCurrentAgentName={setCurrentAgentName}\n          onSelectCustomer={(cust) => setSelectedCustomer(cust)}\n          onTakeoverConsultation={handleTakeoverConsultation}\n        />\n\n        {/* Dynamic View Routing */}\n        <main className=\"flex-1 p-6 bg-slate-50 overflow-y-auto\">\n          {activeTab === \'workspace\' && (\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 h-full max-w-[1600px] mx-auto\">\n              {/* Main Prominent Section: Customer & Car Master + Resolution Status + History (8 cols) */}\n              <section className=\"lg:col-span-8 flex flex-col gap-4\">\n                <MainConsultationHub\n                  customer={selectedCustomer}\n                  parkingSpots={parkingSpots}\n                  savedTemplates={templates}\n                  tasks={tasks}\n                  consultations={consultations}\n                  activeConsultation={activeConsultation}\n                  currentAgentName={currentAgentName}\n                  agents={agents}\n                  notes={notes}\n                  setNotes={setNotes}\n                  onChangeCustomerField={handleUpdateCustomerField}\n                  onSelectRecommendedParking={handleSelectRecommendedParking}\n                  onChangeStatus={handleChangeStatus}\n                  onAddTask={handleAddTask}\n                  onToggleTask={handleToggleTask}\n                  onSaveLog={handleSaveLog}\n                  onNavigateToKanban={() => setActiveTab(\'kanban\')}\n                />\n              </section>\n\n              {/* Secondary Section: Interaction Pad (Live CTI / STT player) shifted to the RIGHT (4 cols) */}\n              <section className=\"lg:col-span-4 flex flex-col gap-4\">\n                <LeftInteractionPad\n                  currentCallLog={activeCallLog}\n                  agents={agents}\n                  currentAgentName={currentAgentName}\n                  notes={notes}\n                  setNotes={setNotes}\n                  carNumber={selectedCustomer.car_number}\n                  onSaveLog={handleSaveLog}\n                />\n              </section>\n            </div>\n          )}\n\n          {activeTab === \'calendar\' && (\n            <CalendarView\n              consultations={consultations}\n              tasks={tasks}\n              currentAgentName={currentAgentName}\n            />\n          )}\n\n          {activeTab === \'kanban\' && (\n            <KanbanBoardView\n              consultations={consultations}\n              currentAgentName={currentAgentName}\n              onUpdateStatus={(consId, newStatus) => {\n                setConsultations((prev) =>\n                  prev.map((c) => (c.id === consId ? { ...c, status: newStatus } : c))\n                );\n              }}\n            />\n          )}\n\n          {activeTab === \'admin\' && (\n            <AdminPanel\n              agents={agents}\n              templates={templates}\n              customers={customers}\n              onAddAgent={handleAddAgent}\n              onToggleAgentStatus={handleToggleAgentStatus}\n              onAddTemplate={handleAddTemplate}\n              onDeleteTemplate={handleDeleteTemplate}\n              onToggleBlacklist={handleToggleBlacklist}\n            />\n          )}\n\n          {activeTab === \'logs\' && (\n            <LogsArchiveView consultations={consultations} callLogs={callLogs} />\n          )}\n\n          {activeTab === \'support\' && <SupportAiKms consultations={consultations} />}\n        </main>\n      </div>\n    </div>\n  );\n}\n"
    }
