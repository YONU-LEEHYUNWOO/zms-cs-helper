  file_change {
    absolute_path_uri: "file:///src/components/workspace/RightTaskManager.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { CheckSquare, Plus, Send, Clock, ChevronDown, MessageSquare, ShieldCheck, CheckCircle } from \'lucide-react\';\nimport {\n  ConsultationStatus,\n  SavedTemplate,\n  AgentTask,\n  Customer,\n} from \'../../types\';\nimport { replaceMacroPlaceholders } from \'../../lib/utils/normalize\';\n\ninterface RightTaskManagerProps {\n  currentStatus: ConsultationStatus;\n  subStatus: string;\n  savedTemplates: SavedTemplate[];\n  tasks: AgentTask[];\n  currentCustomer: Customer | null;\n  parkingName?: string;\n  onChangeStatus: (status: ConsultationStatus, subStatus?: string) => void;\n  onAddTask: (title: string, dueDate: string) => void;\n  onToggleTask: (taskId: string) => void;\n}\n\nexport const RightTaskManager: React.FC<RightTaskManagerProps> = ({\n  currentStatus,\n  subStatus,\n  savedTemplates,\n  tasks,\n  currentCustomer,\n  parkingName,\n  onChangeStatus,\n  onAddTask,\n  onToggleTask,\n}) => {\n  const [selectedTemplateId, setSelectedTemplateId] = useState(\'\');\n  const [previewText, setPreviewText] = useState(\'\');\n  const [showSendModal, setShowSendModal] = useState(false);\n  const [newTaskTitle, setNewTaskTitle] = useState(\'\');\n  const [newTaskDueDate, setNewTaskDueDate] = useState(\'\');\n  const [showAddTaskForm, setShowAddTaskForm] = useState(false);\n\n  const statuses: ConsultationStatus[] = [\n    \'\354\240\221\354\210\230\',\n    \'\355\225\264\352\262\260\354\244\221\',\n    \'\352\263\265\354\234\240\354\236\220 \354\227\260\353\235\275 \354\244\221\',\n    \'\354\234\240\354\204\240 \353\266\200\354\204\234 \355\231\225\354\235\270 \354\244\221\',\n    \'\354\231\204\353\243\214\',\n  ];\n\n  const handleSelectTemplate = (tmplId: string) => {\n    setSelectedTemplateId(tmplId);\n    const tmpl = savedTemplates.find((t) => t.id === tmplId);\n    if (tmpl) {\n      const substituted = replaceMacroPlaceholders(tmpl.content, {\n        car_number: currentCustomer?.car_number || \'12\352\260\2003456\',\n        parking_name: parkingName || \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n        bank_name: currentCustomer?.bank_name || \'\354\213\240\355\225\234\354\235\200\355\226\211\',\n      });\n      setPreviewText(substituted);\n      setShowSendModal(true);\n    }\n  };\n\n  const handleCreateTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTaskTitle) return;\n    onAddTask(\n      newTaskTitle,\n      newTaskDueDate || new Date(Date.now() + 3600000 * 2).toISOString()\n    );\n    setNewTaskTitle(\'\');\n    setShowAddTaskForm(false);\n  };\n\n  return (\n    <div className=\"bg-white dark:bg-[#0b1c30] rounded-xl border border-[#c5c5d8]/40 p-4 h-full flex flex-col shadow-sm\">\n      {/* Resolution Status Header & Chips */}\n      <div className=\"mb-4\">\n        <h2 className=\"text-sm font-semibold text-[#0b1c30] dark:text-white mb-2 flex items-center gap-1.5\">\n          <CheckCircle className=\"w-4 h-4 text-[#000eba]\" />\n          Resolution Status (\354\247\204\354\262\231\353\217\204 \353\214\200\353\266\204\353\245\230/\354\206\214\353\266\204\353\245\230)\n        </h2>\n\n        <div className=\"flex flex-wrap gap-1.5 mb-2\">\n          {statuses.map((st) => (\n            <button\n              key={st}\n              type=\"button\"\n              onClick={() => onChangeStatus(st)}\n              className={`px-2.5 py-1 text-xs rounded-full font-bold transition-colors ${\n                currentStatus === st\n                  ? \'bg-[#000eba] text-white shadow\'\n                  : \'bg-[#f8f9ff] text-[#454555] dark:bg-[#213145] dark:text-gray-300 border border-gray-200 hover:bg-gray-200\'\n              }`}\n            >\n              {st}\n            </button>\n          ))}\n        </div>\n\n        {/* Sub Status Input */}\n        <div className=\"mt-2\">\n          <label className=\"text-[11px] text-[#454555] font-semibold uppercase tracking-wider block mb-1\">\n            \354\203\201\354\204\270 \354\206\214\353\266\204\353\245\230 \354\202\254\354\234\240 (\354\230\210: \353\266\200\354\236\254\354\244\221 1\354\260\250, \352\260\234\353\260\234\355\214\200 \355\231\225\354\235\270 \353\214\200\352\270\260)\n          </label>\n          <input\n            type=\"text\"\n            value={subStatus}\n            onChange={(e) => onChangeStatus(currentStatus, e.target.value)}\n            placeholder=\"\354\203\201\354\204\270 \354\202\254\354\234\240 \353\260\217 \354\247\204\355\226\211 \354\203\201\355\231\251\354\235\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224...\"\n            className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg px-2.5 py-1 text-xs text-[#0b1c30] dark:text-white focus:ring-2 focus:ring-[#000eba]\"\n          />\n        </div>\n      </div>\n\n      {/* Canned Responses / Saved Macros */}\n      <div className=\"mb-4 pt-3 border-t border-[#c5c5d8]/30\">\n        <label className=\"block text-xs font-bold text-[#454555] uppercase tracking-wider mb-1\">\n          Quick Replies (\354\203\201\354\232\251\352\265\254 \353\266\210\353\237\254\354\230\244\352\270\260 & \354\271\230\355\231\230)\n        </label>\n        <div className=\"relative\">\n          <select\n            value={selectedTemplateId}\n            onChange={(e) => handleSelectTemplate(e.target.value)}\n            className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg pl-3 pr-8 py-1.5 text-xs text-[#0b1c30] dark:text-white appearance-none focus:ring-2 focus:ring-[#000eba]\"\n          >\n            <option value=\"\">\354\233\220\355\201\264\353\246\255 \354\203\201\354\232\251\352\265\254 \355\205\234\355\224\214\353\246\277 \354\204\240\355\203\235...</option>\n            {savedTemplates.map((t) => (\n              <option key={t.id} value={t.id}>\n                {t.template_title}\n              </option>\n            ))}\n          </select>\n          <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400\" />\n        </div>\n      </div>\n\n      {/* Checklist / Google Task Manager */}\n      <div className=\"flex-1 flex flex-col pt-3 border-t border-[#c5c5d8]/30\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-xs font-bold text-[#454555] uppercase tracking-wider flex items-center gap-1\">\n            <CheckSquare className=\"w-3.5 h-3.5 text-[#000eba]\" />\n            Action Items (\355\203\234\354\212\244\355\201\254 \353\246\254\353\247\210\354\235\270\353\215\224)\n          </h3>\n          <button\n            onClick={() => setShowAddTaskForm(!showAddTaskForm)}\n            className=\"text-[#000eba] hover:bg-[#e5eeff] rounded-full p-1 transition-colors\"\n            title=\"\354\203\210 \355\203\234\354\212\244\355\201\254 \354\266\224\352\260\200\"\n          >\n            <Plus className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Add Task Form */}\n        {showAddTaskForm && (\n          <form onSubmit={handleCreateTask} className=\"p-2 mb-2 bg-[#f8f9ff] dark:bg-[#213145] rounded-lg border border-[#c5c5d8]/40 space-y-2\">\n            <input\n              type=\"text\"\n              value={newTaskTitle}\n              onChange={(e) => setNewTaskTitle(e.target.value)}\n              placeholder=\"\355\225\240 \354\235\274 \354\236\205\353\240\245 (\354\230\210: [\352\263\265\354\234\240\354\236\220 \353\266\200\354\236\254] 16:00 \354\236\254\355\206\265\355\231\224)\"\n              className=\"w-full text-xs p-1.5 rounded border border-gray-300 dark:bg-[#0b1c30] dark:text-white\"\n            />\n            <div className=\"flex gap-2\">\n              <input\n                type=\"datetime-local\"\n                value={newTaskDueDate}\n                onChange={(e) => setNewTaskDueDate(e.target.value)}\n                className=\"text-xs p-1 rounded border border-gray-300 dark:bg-[#0b1c30] dark:text-white flex-1\"\n              />\n              <button\n                type=\"submit\"\n                className=\"px-2.5 py-1 bg-[#000eba] text-white text-xs font-bold rounded hover:bg-[#2532d8]\"\n              >\n                \353\223\261\353\241\235\n              </button>\n            </div>\n          </form>\n        )}\n\n        {/* Tasks List */}\n        <div className=\"flex-1 overflow-y-auto space-y-1 pr-1\">\n          {tasks.map((task) => (\n            <label\n              key={task.id}\n              className=\"flex items-start gap-2 p-2 rounded-lg hover:bg-[#f8f9ff] dark:hover:bg-[#213145] transition-colors cursor-pointer group border border-transparent hover:border-gray-200\"\n            >\n              <input\n                type=\"checkbox\"\n                checked={task.is_completed}\n                onChange={() => onToggleTask(task.id)}\n                className=\"mt-0.5 w-4 h-4 rounded text-[#000eba] focus:ring-[#000eba]\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <p\n                  className={`text-xs ${\n                    task.is_completed\n                      ? \'text-gray-400 line-through\'\n                      : \'text-[#0b1c30] dark:text-gray-200 font-medium\'\n                  }`}\n                >\n                  {task.task_title}\n                </p>\n                <p className=\"text-[10px] text-gray-400 flex items-center gap-1 mt-0.5\">\n                  <Clock className=\"w-3 h-3\" /> \354\225\275\354\206\215 \354\213\234\352\260\201: {task.due_date.slice(5, 16).replace(\'T\', \' \')}\n                </p>\n              </div>\n            </label>\n          ))}\n        </div>\n      </div>\n\n      {/* Kakao / SMS Dispatch Modal */}\n      {showSendModal && (\n        <div className=\"fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#0b1c30] rounded-2xl p-5 max-w-md w-full border border-[#c5c5d8]/40 shadow-2xl space-y-3\">\n            <div className=\"flex justify-between items-center border-b pb-2\">\n              <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-1.5\">\n                <Send className=\"w-4 h-4 text-[#000eba]\" />\n                \354\271\230\355\231\230 \353\254\270\352\265\254 \353\260\234\354\206\241 (\354\271\264\354\271\264\354\230\244\355\206\241 / \353\254\270\354\236\220)\n              </h3>\n              <button\n                onClick={() => setShowSendModal(false)}\n                className=\"text-gray-400 hover:text-gray-600\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <p className=\"text-xs text-gray-500\">\n              \352\263\240\352\260\235 \354\260\250\353\237\211\353\262\210\355\230\270(<span className=\"font-bold text-[#000eba]\">{currentCustomer?.car_number || \'12\352\260\2003456\'}</span>)\354\231\200 \354\243\274\354\260\250\354\236\245\353\252\205\354\235\264 \354\236\220\353\217\231 \353\247\244\355\225\221\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.\n            </p>\n\n            <textarea\n              value={previewText}\n              onChange={(e) => setPreviewText(e.target.value)}\n              rows={5}\n              className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-xl p-3 text-xs text-[#0b1c30] dark:text-white leading-relaxed font-sans focus:ring-2 focus:ring-[#000eba]\"\n            />\n\n            <div className=\"flex justify-end gap-2 pt-2\">\n              <button\n                onClick={() => setShowSendModal(false)}\n                className=\"px-3 py-1.5 rounded-lg bg-gray-200 dark:bg-gray-700 text-xs text-gray-700 dark:text-gray-200\"\n              >\n                \354\267\250\354\206\214\n              </button>\n              <button\n                onClick={() => {\n                  alert(`[\354\225\214\353\246\274] \352\263\240\352\260\235(${currentCustomer?.phone_number || \'\354\210\230\354\213\240\354\236\220\'})\354\227\220\352\262\214 \353\260\234\354\206\241 \354\231\204\353\243\214 \353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`);\n                  setShowSendModal(false);\n                }}\n                className=\"px-4 py-1.5 rounded-lg bg-[#000eba] hover:bg-[#2532d8] text-white text-xs font-bold shadow flex items-center gap-1\"\n              >\n                <Send className=\"w-3.5 h-3.5\" /> \354\246\211\354\213\234 \353\260\234\354\206\241\355\225\230\352\270\260\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
