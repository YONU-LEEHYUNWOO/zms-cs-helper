    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Car,\n  ShieldCheck,\n  ChevronDown,\n  Sparkles,\n  Building,\n  MapPin,\n  CheckCircle,\n  CheckSquare,\n  Plus,\n  Clock,\n  Send,\n  Kanban,\n  FileText,\n  Lock,\n  Shield,\n  History,\n  ArrowRight,\n  User,\n} from \'lucide-react\';\nimport {\n  Customer,\n  CarType,\n  ParkingSpot,\n  SavedTemplate,\n  AgentTask,\n  Consultation,\n  ConsultationStatus,\n  InternalAgent,\n} from \'../../types\';\n\ninterface MainConsultationHubProps {\n  customer: Customer;\n  parkingSpots: ParkingSpot[];\n  savedTemplates: SavedTemplate[];\n  tasks: AgentTask[];\n  consultations: Consultation[];\n  activeConsultation: Consultation;\n  currentAgentName: string;\n  agents: InternalAgent[];\n  notes: string;\n  setNotes: (text: string) => void;\n  onChangeCustomerField: (field: keyof Customer, value: any) => void;\n  onSelectRecommendedParking: (spot: ParkingSpot) => void;\n  onChangeStatus: (status: ConsultationStatus, subStatusReason?: string) => void;\n  onAddTask: (title: string, dueDate: string) => void;\n  onToggleTask: (taskId: string) => void;\n  onSaveLog: (summaryText: string) => void;\n  onNavigateToKanban: () => void;\n}\n\nconst carTypes: CarType[] = [\n  \'\352\262\275\354\260\250\',\n  \'\354\206\214\355\230\225\354\204\270\353\213\250\',\n  \'\354\244\200\354\244\221\355\230\225\354\204\270\353\213\250\',\n  \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n  \'\353\214\200\355\230\225\354\204\270\353\213\250\',\n  \'SUV\',\n  \'RV\',\n];\n\nconst statusList: ConsultationStatus[] = [\n  \'\354\240\221\354\210\230\',\n  \'\355\225\264\352\262\260\354\244\221\',\n  \'\352\263\265\354\234\240\354\236\220 \354\227\260\353\235\275 \354\244\221\',\n  \'\354\234\240\354\204\240 \353\266\200\354\204\234 \355\231\225\354\235\270 \354\244\221\',\n  \'\354\231\204\353\243\214\',\n];\n\nexport const MainConsultationHub: React.FC<MainConsultationHubProps> = ({\n  customer,\n  parkingSpots,\n  savedTemplates,\n  tasks,\n  consultations,\n  activeConsultation,\n  currentAgentName,\n  agents,\n  notes,\n  setNotes,\n  onChangeCustomerField,\n  onSelectRecommendedParking,\n  onChangeStatus,\n  onAddTask,\n  onToggleTask,\n  onSaveLog,\n  onNavigateToKanban,\n}) => {\n  const [showRecommendation, setShowRecommendation] = useState(false);\n  const [selectedTemplateId, setSelectedTemplateId] = useState(\'\');\n  const [showAddTaskForm, setShowAddTaskForm] = useState(false);\n  const [newTaskTitle, setNewTaskTitle] = useState(\'\');\n  const [newTaskDueDate, setNewTaskDueDate] = useState(\n    new Date(Date.now() + 3600000).toISOString().slice(0, 16)\n  );\n  const [showSendModal, setShowSendModal] = useState(false);\n  const [previewText, setPreviewText] = useState(\'\');\n  const [saveSuccessMessage, setSaveSuccessMessage] = useState<string | null>(null);\n\n  const isAdmin = currentAgentName === \'\352\264\200\353\246\254\354\236\220\' || currentAgentName.includes(\'\352\264\200\353\246\254\354\236\220\');\n\n  // Filter parking spots based on car type compatibility\n  const matchedSpots = customer\n    ? parkingSpots.filter((s) => s.allowed_car_types.includes(customer.car_type))\n    : parkingSpots;\n\n  // Filter tasks for active consultation\n  const activeTasks = tasks.filter((t) => t.consultation_id === activeConsultation.id);\n\n  // Filter history logs for current customer\n  const customerConsultations = consultations.filter((c) => c.customer_id === customer.id);\n\n  // Apply Account Scope filtering rule for display:\n  // Non-admins see their own DB entries or customer entries tagged with their ownership\n  const visibleCustomerConsultations = isAdmin\n    ? customerConsultations\n    : customerConsultations.filter((c) => c.agent_name === currentAgentName);\n\n  const handleSelectTemplate = (templateId: string) => {\n    setSelectedTemplateId(templateId);\n    const tmpl = savedTemplates.find((t) => t.id === templateId);\n    if (tmpl) {\n      const substituted = tmpl.content\n        .replace(/#{car_number}/g, customer?.car_number || \'12\352\260\2003456\')\n        .replace(/#{parking_name}/g, activeConsultation?.parking_name || \'\355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\');\n\n      setNotes(substituted);\n      setPreviewText(substituted);\n    }\n  };\n\n  const handleCreateTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTaskTitle.trim()) return;\n    onAddTask(newTaskTitle, newTaskDueDate);\n    setNewTaskTitle(\'\');\n    setShowAddTaskForm(false);\n  };\n\n  const handleSaveAndNotify = () => {\n    onSaveLog(notes);\n    setSaveSuccessMessage(`[\354\240\200\354\236\245 \354\204\261\352\263\265] ${customer.car_number} \354\203\201\353\213\264 \353\202\264\354\227\255\354\235\264 DB\354\227\220 \353\223\261\353\241\235\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.`);\n    setTimeout(() => {\n      setSaveSuccessMessage(null);\n    }, 4000);\n  };\n\n  const formatPhoneNumber = (val: string) => {\n    const raw = val.replace(/\\D/g, \'\');\n    if (raw.length === 11) {\n      return `${raw.slice(0, 3)}-${raw.slice(3, 7)}-${raw.slice(7)}`;\n    }\n    return val;\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      {/* DB Scope Indicator Banner */}\n      <div\n        className={`p-3 rounded-xl border flex items-center justify-between text-xs font-semibold ${\n          isAdmin\n            ? \'bg-amber-50 border-amber-200 text-amber-900\'\n            : \'bg-blue-50 border-blue-200 text-blue-900\'\n        }`}\n      >\n        <div className=\"flex items-center gap-2\">\n          {isAdmin ? (\n            <Shield className=\"w-4 h-4 text-amber-600\" />\n          ) : (\n            <Lock className=\"w-4 h-4 text-blue-600\" />\n          )}\n          <span>\n            {isAdmin ? (\n              <>\n                <strong className=\"text-amber-800\">[\352\264\200\353\246\254\354\236\220 \355\206\265\355\225\251 DB \353\252\250\353\223\234]</strong> \354\240\204\354\262\264 \354\203\201\353\213\264\354\202\254\354\235\230\n                \353\252\250\353\223\240 DB \353\260\217 \354\203\201\353\213\264 \353\202\264\354\227\255\354\235\204 \354\264\235\352\264\204 \352\264\200\354\240\234\355\225\230\352\263\240 \354\236\210\354\212\265\353\213\210\353\213\244.\n              </>\n            ) : (\n              <>\n                <strong className=\"text-blue-800\">[{currentAgentName} \354\203\201\353\213\264\354\202\254 \352\260\234\354\235\270 DB \353\252\250\353\223\234]</strong>{\' \'}\n                \353\263\270\354\235\270 \352\263\204\354\240\225\354\227\220 \354\214\223\354\235\270 \354\240\204\354\232\251 DB \354\203\201\353\213\264 \353\202\264\354\227\255\354\235\264 \354\241\260\355\232\214 \353\260\217 \352\270\260\353\241\235\353\220\251\353\213\210\353\213\244.\n              </>\n            )}\n          </span>\n        </div>\n        <span className=\"text-[11px] font-mono opacity-80\">\n          \352\263\204\354\240\225: {currentAgentName} ({isAdmin ? \'\354\265\234\352\263\240 \352\264\200\353\246\254\354\236\220\' : \'\354\235\274\353\260\230 \354\203\201\353\213\264\354\233\220\'})\n        </span>\n      </div>\n\n      {/* Main Grid: Customer Master + Resolution Status */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-5\">\n        {/* Card 1: Customer & Vehicle Master (Email Completely Removed) */}\n        <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between\">\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between pb-2 border-b border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n                <Car className=\"w-4 h-4 text-blue-600\" />\n                \352\263\240\352\260\235 \353\260\217 \354\260\250\353\237\211 \353\247\210\354\212\244\355\204\260 (Customer Profile)\n              </h2>\n              <span className=\"px-2.5 py-0.5 bg-blue-50 text-blue-700 text-[11px] font-bold rounded-full flex items-center gap-1\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-blue-600\" /> Verified DB\n              </span>\n            </div>\n\n            {/* Contact Details */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                \354\240\204\355\231\224\353\262\210\355\230\270 (Contact)\n              </label>\n              <input\n                type=\"text\"\n                value={customer ? formatPhoneNumber(customer.phone_number) : \'\'}\n                onChange={(e) => onChangeCustomerField(\'phone_number\', e.target.value)}\n                placeholder=\"010-1234-5678\"\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-900 font-mono font-semibold focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n              />\n            </div>\n\n            {/* Primary Vehicle Info */}\n            <div className=\"space-y-2 pt-2 border-t border-slate-100\">\n              <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n                VEHICLE DETAILS (\354\260\250\353\237\211 \354\240\225\353\260\200 \354\204\270\353\266\204\355\231\224)\n              </h3>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                    \354\260\250\353\237\211\353\262\210\355\230\270 (License Plate)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={customer?.car_number || \'\'}\n                    onChange={(e) => onChangeCustomerField(\'car_number\', e.target.value)}\n                    placeholder=\"12\352\260\2003456\"\n                    className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-900 font-mono uppercase font-bold focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                    \354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230\n                  </label>\n                  <div className=\"relative\">\n                    <select\n                      value={customer?.car_type || \'\354\244\221\355\230\225\354\204\270\353\213\250\'}\n                      onChange={(e) =>\n                        onChangeCustomerField(\'car_type\', e.target.value as CarType)\n                      }\n                      className=\"w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-2 text-xs text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white font-medium cursor-pointer\"\n                    >\n                      {carTypes.map((ct) => (\n                        <option key={ct} value={ct}>\n                          {ct}\n                        </option>\n                      ))}\n                    </select>\n                    <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400\" />\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                  \354\203\201\354\204\270 \354\260\250\354\242\205\353\252\205\n                </label>\n                <input\n                  type=\"text\"\n                  value={customer?.car_detail || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'car_detail\', e.target.value)}\n                  placeholder=\"\354\230\210: \354\217\230\353\202\230\355\203\200 DN8, \354\225\204\353\260\230\353\226\274 CN7, \355\214\260\353\246\254\354\204\270\354\235\264\353\223\234\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                />\n              </div>\n            </div>\n\n            {/* Payment Method / Bank Info */}\n            <div className=\"space-y-2 pt-2 border-t border-slate-100\">\n              <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n                REFUND BANK (\354\240\225\354\202\260 \353\260\217 \355\231\230\353\266\210 \352\263\204\354\242\214)\n              </h3>\n              <div className=\"bg-slate-50 border border-slate-200 rounded-lg p-2.5 space-y-2\">\n                <div className=\"grid grid-cols-3 gap-2\">\n                  <div>\n                    <label className=\"text-[11px] text-slate-500 block mb-0.5\">\354\235\200\355\226\211\353\252\205</label>\n                    <input\n                      type=\"text\"\n                      value={customer?.bank_name || \'\'}\n                      onChange={(e) => onChangeCustomerField(\'bank_name\', e.target.value)}\n                      placeholder=\"\354\213\240\355\225\234\354\235\200\355\226\211\"\n                      className=\"w-full bg-white border border-slate-200 rounded px-2 py-1 text-xs text-slate-900\"\n                    />\n                  </div>\n                  <div className=\"col-span-2\">\n                    <label className=\"text-[11px] text-slate-500 block mb-0.5\">\352\263\204\354\242\214\353\262\210\355\230\270</label>\n                    <input\n                      type=\"text\"\n                      value={customer?.account_number || \'\'}\n                      onChange={(e) => onChangeCustomerField(\'account_number\', e.target.value)}\n                      placeholder=\"110-123-456789\"\n                      className=\"w-full bg-white border border-slate-200 rounded px-2 py-1 text-xs text-slate-900 font-mono\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-[11px] text-slate-500 block mb-0.5\">\354\230\210\352\270\210\354\243\274\353\252\205</label>\n                  <input\n                    type=\"text\"\n                    value={customer?.account_holder || \'\'}\n                    onChange={(e) => onChangeCustomerField(\'account_holder\', e.target.value)}\n                    placeholder=\"\355\231\215\352\270\270\353\217\231\"\n                    className=\"w-full bg-white border border-slate-200 rounded px-2 py-1 text-xs text-slate-900\"\n                  />\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Recommended Parking Spot Drawer */}\n          <div className=\"pt-3 border-t border-slate-100 mt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setShowRecommendation(!showRecommendation)}\n              className=\"w-full py-2 px-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-sm flex items-center justify-center gap-2 transition-all\"\n            >\n              <Sparkles className=\"w-4 h-4 text-amber-300\" />\n              \354\236\220\354\202\254 \354\226\264\353\223\234\353\257\274 \354\243\274\354\260\250\354\236\245 \353\247\244\353\254\274 \354\266\224\354\262\234 ({matchedSpots.length}\352\261\264 \352\260\200\353\212\245)\n            </button>\n\n            {showRecommendation && (\n              <div className=\"mt-2 p-3 bg-slate-100 rounded-xl border border-slate-200 space-y-2\">\n                <div className=\"text-xs font-bold text-blue-700 flex items-center gap-1\">\n                  <Building className=\"w-3.5 h-3.5\" /> \354\260\250\354\242\205({customer?.car_type || \'\354\244\221\355\230\225\354\204\270\353\213\250\'}) \354\236\205\354\260\250\n                  \352\260\200\353\212\245 \353\247\244\353\254\274 \353\252\251\353\241\235\n                </div>\n\n                {matchedSpots.map((spot) => (\n                  <div\n                    key={spot.id}\n                    className=\"p-2.5 bg-white rounded-lg border border-slate-200 flex items-center justify-between text-xs shadow-sm\"\n                  >\n                    <div>\n                      <p className=\"font-bold text-slate-900\">{spot.name}</p>\n                      <p className=\"text-[11px] text-slate-500 flex items-center gap-0.5\">\n                        <MapPin className=\"w-3 h-3\" /> {spot.address} | \354\213\234\352\260\204\353\213\271{\' \'}\n                        {spot.price_per_hour.toLocaleString()}\354\233\220\n                      </p>\n                    </div>\n                    <button\n                      onClick={() => {\n                        onSelectRecommendedParking(spot);\n                        setShowRecommendation(false);\n                      }}\n                      className=\"px-2.5 py-1 bg-blue-600 text-white text-[11px] font-semibold rounded hover:bg-blue-700 shrink-0\"\n                    >\n                      \354\204\240\355\203\235 \354\240\201\354\232\251\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Card 2: Resolution Status & Canned Responses & Notes */}\n        <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between\">\n          <div className=\"space-y-3\">\n            {/* Resolution Status Major Chips */}\n            <div className=\"pb-2 border-b border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 mb-2 flex items-center gap-1.5\">\n                <CheckCircle className=\"w-4 h-4 text-blue-600\" />\n                \354\247\204\354\262\231\353\217\204 \354\203\201\355\203\234 \353\214\200\353\266\204\353\245\230 & \354\206\214\353\266\204\353\245\230\n              </h2>\n\n              <div className=\"flex flex-wrap gap-1.5\">\n                {statusList.map((st) => (\n                  <button\n                    key={st}\n                    onClick={() => onChangeStatus(st)}\n                    className={`px-3 py-1.5 text-xs rounded-lg font-bold transition-all ${\n                      activeConsultation?.status === st\n                        ? \'bg-blue-600 text-white shadow-sm ring-2 ring-blue-300\'\n                        : \'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200\'\n                    }`}\n                  >\n                    {st}\n                  </button>\n                ))}\n              </div>\n\n              {/* Sub Status Detail Input */}\n              <div className=\"mt-2.5\">\n                <label className=\"text-[11px] text-slate-500 font-bold uppercase tracking-wider block mb-1\">\n                  \354\203\201\354\204\270 \354\206\214\353\266\204\353\245\230 \354\202\254\354\234\240 (\354\230\210: \353\266\200\354\236\254\354\244\221 1\354\260\250, \352\260\234\353\260\234\355\214\200 \355\231\225\354\235\270 \353\214\200\352\270\260)\n                </label>\n                <input\n                  type=\"text\"\n                  value={activeConsultation?.sub_status || \'\'}\n                  onChange={(e) =>\n                    onChangeStatus(activeConsultation.status, e.target.value)\n                  }\n                  placeholder=\"\354\203\201\354\204\270 \354\202\254\354\234\240 \353\260\217 \355\230\204\354\236\245 \354\203\201\355\231\251\354\235\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224...\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                />\n              </div>\n            </div>\n\n            {/* Canned Templates / Macros Selector */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1\">\n                \354\233\220\355\201\264\353\246\255 \354\203\201\354\232\251\352\265\254 \355\205\234\355\224\214\353\246\277 (\354\271\230\355\231\230 \355\205\215\354\212\244\355\212\270)\n              </label>\n              <div className=\"relative\">\n                <select\n                  value={selectedTemplateId}\n                  onChange={(e) => handleSelectTemplate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-2 text-xs text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-blue-600 font-medium cursor-pointer\"\n                >\n                  <option value=\"\">\354\233\220\355\201\264\353\246\255 \354\203\201\354\232\251\352\265\254 \355\205\234\355\224\214\353\246\277 \354\204\240\355\203\235...</option>\n                  {savedTemplates.map((t) => (\n                    <option key={t.id} value={t.id}>\n                      [{t.template_title}] {t.content.slice(0, 30)}...\n                    </option>\n                  ))}\n                </select>\n                <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400\" />\n              </div>\n            </div>\n\n            {/* Consultation Note Textarea */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1 flex justify-between\">\n                <span>\354\203\201\353\213\264 \354\232\224\354\225\275 \353\251\224\353\252\250 (Consultation Summary)</span>\n                <span className=\"text-[11px] text-blue-600 font-normal\">\n                  \353\213\264\353\213\271: {currentAgentName} \354\203\201\353\213\264\354\202\254\n                </span>\n              </label>\n              <textarea\n                value={notes}\n                onChange={(e) => setNotes(e.target.value)}\n                rows={4}\n                placeholder=\"\354\203\201\353\213\264 \353\202\264\354\232\251\354\235\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224. \354\203\201\353\213\250\354\235\230 \'\354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245\' \353\262\204\355\212\274\354\235\204 \353\210\204\353\245\264\353\251\264 DB\354\227\220 \352\270\260\353\241\235\353\220\251\353\213\210\353\213\244.\"\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white resize-none\"\n              />\n            </div>\n\n            {/* Action Items List */}\n            <div className=\"pt-2 border-t border-slate-100\">\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <h3 className=\"text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1\">\n                  <CheckSquare className=\"w-3.5 h-3.5 text-blue-600\" />\n                  Action Items (\353\246\254\353\247\210\354\235\270\353\215\224 / \354\225\275\354\206\215)\n                </h3>\n                <button\n                  onClick={() => setShowAddTaskForm(!showAddTaskForm)}\n                  className=\"text-blue-600 hover:bg-blue-50 rounded-full p-1 transition-colors text-xs font-bold flex items-center gap-0.5\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" /> \354\266\224\352\260\200\n                </button>\n              </div>\n\n              {showAddTaskForm && (\n                <form\n                  onSubmit={handleCreateTask}\n                  className=\"p-2 mb-2 bg-slate-50 rounded-lg border border-slate-200 space-y-2\"\n                >\n                  <input\n                    type=\"text\"\n                    value={newTaskTitle}\n                    onChange={(e) => setNewTaskTitle(e.target.value)}\n                    placeholder=\"\355\225\240 \354\235\274 \354\236\205\353\240\245 (\354\230\210: [\352\263\265\354\234\240\354\236\220 \353\266\200\354\236\254] 16:00 \354\236\254\355\206\265\355\231\224)\"\n                    className=\"w-full text-xs p-2 rounded border border-slate-200 bg-white text-slate-900\"\n                  />\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"datetime-local\"\n                      value={newTaskDueDate}\n                      onChange={(e) => setNewTaskDueDate(e.target.value)}\n                      className=\"text-xs p-1.5 rounded border border-slate-200 bg-white text-slate-900 flex-1\"\n                    />\n                    <button\n                      type=\"submit\"\n                      className=\"px-3 py-1 bg-blue-600 text-white text-xs font-bold rounded hover:bg-blue-700\"\n                    >\n                      \353\223\261\353\241\235\n                    </button>\n                  </div>\n                </form>\n              )}\n\n              <div className=\"space-y-1 max-h-24 overflow-y-auto pr-1\">\n                {activeTasks.length === 0 ? (\n                  <p className=\"text-[11px] text-slate-400 italic\">\353\223\261\353\241\235\353\220\234 \353\246\254\353\247\210\354\235\270\353\215\224\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244.</p>\n                ) : (\n                  activeTasks.map((task) => (\n                    <label\n                      key={task.id}\n                      className=\"flex items-center justify-between p-1.5 rounded hover:bg-slate-50 text-xs cursor-pointer border border-slate-100\"\n                    >\n                      <div className=\"flex items-center gap-2\">\n                        <input\n                          type=\"checkbox\"\n                          checked={task.is_completed}\n                          onChange={() => onToggleTask(task.id)}\n                          className=\"w-3.5 h-3.5 text-blue-600 rounded\"\n                        />\n                        <span\n                          className={\n                            task.is_completed ? \'line-through text-slate-400\' : \'text-slate-900 font-medium\'\n                          }\n                        >\n                          {task.task_title}\n                        </span>\n                      </div>\n                      <span className=\"text-[10px] text-slate-400 flex items-center gap-0.5\">\n                        <Clock className=\"w-3 h-3\" /> {task.due_date.slice(11, 16)}\n                      </span>\n                    </label>\n                  ))\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Prominent Save Log Button */}\n          <div className=\"pt-3 border-t border-slate-100 mt-3 space-y-2\">\n            {saveSuccessMessage && (\n              <div className=\"p-2.5 bg-emerald-100 border border-emerald-300 text-emerald-900 rounded-lg text-xs font-bold flex items-center gap-2 animate-fadeIn\">\n                <CheckCircle className=\"w-4 h-4 text-emerald-700 shrink-0\" />\n                <span>{saveSuccessMessage}</span>\n              </div>\n            )}\n\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleSaveAndNotify}\n                className=\"flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow-md transition-all flex items-center justify-center gap-2\"\n              >\n                <CheckCircle className=\"w-4 h-4\" />\n                \354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245 & DB \354\246\211\354\213\234 \353\223\261\353\241\235\n              </button>\n\n              <button\n                onClick={() => setShowSendModal(true)}\n                className=\"py-3 px-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-1\"\n                title=\"\353\254\270\354\236\220/\354\271\264\354\271\264\354\230\244\355\206\241 \354\246\211\354\213\234 \353\260\234\354\206\241\"\n              >\n                <Send className=\"w-4 h-4\" /> \353\254\270\354\236\220\353\260\234\354\206\241\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Section: Customer History Logs & Kanban Board Integration */}\n      <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm space-y-3\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-blue-600\" />\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                \352\263\240\352\260\235({customer?.car_number || \'\354\260\250\353\237\211\'}) \354\203\201\353\213\264 \354\235\264\353\240\245 & DB \354\240\200\354\236\245 \353\241\234\352\267\270 (\354\264\235{\' \'}\n                {visibleCustomerConsultations.length}\352\261\264)\n              </h3>\n              <p className=\"text-[11px] text-slate-500\">\n                \354\203\201\353\213\264 \353\202\264\354\227\255\354\235\264 \353\215\260\354\235\264\355\204\260\353\262\240\354\235\264\354\212\244\354\227\220 \354\266\225\354\240\201\353\220\230\354\226\264 \354\235\264\353\240\245\354\235\264 \353\263\264\354\241\264\353\220\230\353\251\260, \354\271\270\353\260\230 \353\263\264\353\223\234 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270\354\227\220 \353\217\231\352\270\260\355\231\224\353\220\251\353\213\210\353\213\244.\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onNavigateToKanban}\n            className=\"px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-lg shadow-sm flex items-center gap-1.5 self-start sm:self-auto\"\n          >\n            <Kanban className=\"w-4 h-4 text-blue-400\" />\n            \354\271\270\353\260\230 \353\263\264\353\223\234\353\241\234 \354\235\264\353\217\231\355\225\230\354\227\254 \354\240\204\354\262\264 \355\231\225\354\235\270\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {visibleCustomerConsultations.length === 0 ? (\n          <div className=\"py-8 text-center text-slate-400 text-xs bg-slate-50 rounded-lg border border-dashed border-slate-200\">\n            {isAdmin\n              ? \'\354\240\200\354\236\245\353\220\234 \352\263\240\352\260\235 \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244. \354\234\204\354\235\230 \354\203\201\353\213\250\354\235\230 \"\354\203\201\353\213\264 \353\241\234\352\267\270 \354\240\200\354\236\245\" \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \354\203\210 \353\241\234\352\267\270\353\245\274 \354\240\200\354\236\245\355\225\230\354\204\270\354\232\224.\'\n              : `${currentAgentName} \354\203\201\353\213\264\354\202\254 \352\263\204\354\240\225\354\234\274\353\241\234 \354\240\200\354\236\245\353\220\234 \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.`}\n          </div>\n        ) : (\n          <div className=\"space-y-2.5 max-h-80 overflow-y-auto pr-1\">\n            {visibleCustomerConsultations.map((cons) => (\n              <div\n                key={cons.id}\n                className={`p-3 rounded-lg border transition-all ${\n                  cons.id === activeConsultation?.id\n                    ? \'bg-blue-50/70 border-blue-300 ring-1 ring-blue-300\'\n                    : \'bg-slate-50 border-slate-200 hover:bg-slate-100\'\n                }`}\n              >\n                <div className=\"flex flex-wrap justify-between items-center gap-2 mb-1\">\n                  <div className=\"flex items-center gap-2 text-xs\">\n                    <span className=\"px-2 py-0.5 rounded bg-blue-600 text-white font-bold text-[11px]\">\n                      {cons.status}\n                    </span>\n                    {cons.sub_status && (\n                      <span className=\"px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-semibold text-[11px]\">\n                        \342\206\263 {cons.sub_status}\n                      </span>\n                    )}\n                    <span className=\"font-bold text-slate-900\">\n                      {cons.parking_name || \'\354\243\274\354\260\250\354\236\245 \353\257\270\354\247\200\354\240\225\'}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-3 text-[11px] text-slate-500 font-mono\">\n                    <span className=\"flex items-center gap-1 font-semibold text-blue-700\">\n                      <User className=\"w-3 h-3 text-blue-600\" /> \353\213\264\353\213\271: {cons.agent_name}\n                    </span>\n                    <span>\n                      {cons.created_at ? cons.created_at.slice(0, 16).replace(\'T\', \' \') : \'\'}\n                    </span>\n                  </div>\n                </div>\n\n                <p className=\"text-xs text-slate-800 leading-relaxed bg-white p-2.5 rounded border border-slate-200\">\n                  {cons.summary}\n                </p>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Kakao / SMS Dispatch Modal */}\n      {showSendModal && (\n        <div className=\"fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl p-5 max-w-md w-full border border-slate-200 shadow-2xl space-y-3\">\n            <div className=\"flex justify-between items-center border-b border-slate-100 pb-2\">\n              <h3 className=\"font-bold text-sm text-slate-900 flex items-center gap-1.5\">\n                <Send className=\"w-4 h-4 text-blue-600\" />\n                \354\271\230\355\231\230 \353\254\270\352\265\254 \353\260\234\354\206\241 (\354\271\264\354\271\264\354\230\244\355\206\241 / \353\254\270\354\236\220)\n              </h3>\n              <button\n                onClick={() => setShowSendModal(false)}\n                className=\"text-slate-400 hover:text-slate-600\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-500\">\n              \352\263\240\352\260\235 \354\260\250\353\237\211\353\262\210\355\230\270(\n              <span className=\"font-bold text-blue-600\">\n                {customer?.car_number || \'12\352\260\2003456\'}\n              </span>\n              )\354\231\200 \354\243\274\354\260\250\354\236\245\353\252\205\354\235\264 \354\236\220\353\217\231 \353\247\244\355\225\221\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.\n            </p>\n\n            <textarea\n              value={previewText || notes}\n              onChange={(e) => setPreviewText(e.target.value)}\n              rows={5}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-900 leading-relaxed font-sans focus:outline-none focus:ring-2 focus:ring-blue-600\"\n            />\n\n            <div className=\"flex justify-end gap-2 pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => setShowSendModal(false)}\n                className=\"px-3 py-1.5 rounded-lg bg-slate-100 text-xs text-slate-700 hover:bg-slate-200\"\n              >\n                \354\267\250\354\206\214\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  alert(\n                    `[\354\225\214\353\246\274] \352\263\240\352\260\235(${customer?.phone_number || \'\354\210\230\354\213\240\354\236\220\'})\354\227\220\352\262\214 \353\260\234\354\206\241 \354\231\204\353\243\214 \353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`\n                  );\n                  setShowSendModal(false);\n                }}\n                className=\"px-4 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm flex items-center gap-1\"\n              >\n                <Send className=\"w-3.5 h-3.5\" /> \354\246\211\354\213\234 \353\260\234\354\206\241\355\225\230\352\270\260\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
