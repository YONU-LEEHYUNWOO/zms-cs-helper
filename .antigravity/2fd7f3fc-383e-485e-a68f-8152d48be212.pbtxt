    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ShieldCheck, UserPlus, FileText, AlertTriangle, Lock, Save, Plus, Trash2 } from \'lucide-react\';\nimport { InternalAgent, SavedTemplate, Customer } from \'../../types\';\n\ninterface AdminPanelProps {\n  agents: InternalAgent[];\n  templates: SavedTemplate[];\n  customers: Customer[];\n  onAddAgent: (agentName: string) => void;\n  onToggleAgentStatus: (agentId: string) => void;\n  onAddTemplate: (title: string, content: string, createdBy: string) => void;\n  onDeleteTemplate: (templateId: string) => void;\n  onToggleBlacklist: (customerId: string, note?: string) => void;\n}\n\nexport const AdminPanel: React.FC<AdminPanelProps> = ({\n  agents,\n  templates,\n  customers,\n  onAddAgent,\n  onToggleAgentStatus,\n  onAddTemplate,\n  onDeleteTemplate,\n  onToggleBlacklist,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'agents\' | \'templates\' | \'blacklist\' | \'integrity\'>(\'agents\');\n\n  // New agent form\n  const [newAgentName, setNewAgentName] = useState(\'\');\n\n  // New template form\n  const [newTmplTitle, setNewTmplTitle] = useState(\'\');\n  const [newTmplContent, setNewTmplContent] = useState(\'\');\n\n  const handleCreateAgent = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newAgentName) return;\n    onAddAgent(newAgentName);\n    setNewAgentName(\'\');\n  };\n\n  const handleCreateTemplate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTmplTitle || !newTmplContent) return;\n    onAddTemplate(newTmplTitle, newTmplContent, \'\352\264\200\353\246\254\354\236\220\');\n    setNewTmplTitle(\'\');\n    setNewTmplContent(\'\');\n  };\n\n  return (\n    <div className=\"p-6 max-w-[1600px] mx-auto space-y-6\">\n      {/* Admin Panel Header */}\n      <div className=\"bg-white dark:bg-[#0b1c30] p-4 rounded-2xl border border-[#c5c5d8]/40 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-lg font-bold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <ShieldCheck className=\"w-5 h-5 text-[#000eba]\" />\n            \353\215\260\354\235\264\355\204\260 \353\247\210\354\212\244\355\204\260 \352\264\200\353\246\254\354\236\220 \355\214\250\353\204\220 (Admin Panel)\n          </h2>\n          <p className=\"text-xs text-[#454555]\">\n            \354\203\201\353\213\264 \354\247\201\354\233\220 \354\235\270\354\202\254 \352\264\200\353\246\254, \353\260\234\354\206\241 \354\203\201\354\232\251\352\265\254 \355\205\234\355\224\214\353\246\277, \353\270\224\353\236\231\353\246\254\354\212\244\355\212\270 \353\260\217 \354\240\204\354\202\260 \353\254\264\352\262\260\354\204\261 \354\240\225\354\261\205\354\235\204 \355\206\265\354\240\234\355\225\251\353\213\210\353\213\244.\n          </p>\n        </div>\n\n        {/* Admin Tabs */}\n        <div className=\"flex gap-1 bg-[#f8f9ff] dark:bg-[#213145] p-1 rounded-xl border\">\n          <button\n            onClick={() => setActiveTab(\'agents\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              activeTab === \'agents\' ? \'bg-[#000eba] text-white shadow\' : \'text-gray-600\'\n            }`}\n          >\n            \354\203\201\353\213\264\354\233\220 \354\235\270\354\202\254 \352\264\200\353\246\254\n          </button>\n          <button\n            onClick={() => setActiveTab(\'templates\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              activeTab === \'templates\' ? \'bg-[#000eba] text-white shadow\' : \'text-gray-600\'\n            }`}\n          >\n            \353\260\234\354\206\241 \354\203\201\354\232\251\352\265\254 \355\205\234\355\224\214\353\246\277\n          </button>\n          <button\n            onClick={() => setActiveTab(\'blacklist\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              activeTab === \'blacklist\' ? \'bg-[#000eba] text-white shadow\' : \'text-gray-600\'\n            }`}\n          >\n            \353\270\224\353\236\231\353\246\254\354\212\244\355\212\270 \352\264\200\353\246\254\n          </button>\n          <button\n            onClick={() => setActiveTab(\'integrity\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              activeTab === \'integrity\' ? \'bg-[#000eba] text-white shadow\' : \'text-gray-600\'\n            }`}\n          >\n            \354\240\204\354\202\260 \353\254\264\352\262\260\354\204\261 \354\204\244\354\240\225\n          </button>\n        </div>\n      </div>\n\n      {/* Tab 1: Agents Management */}\n      {activeTab === \'agents\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n            <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-2\">\n              <UserPlus className=\"w-4 h-4 text-[#000eba]\" /> \354\213\240\352\267\234 \354\203\201\353\213\264 \354\247\201\354\233\220 \353\223\261\353\241\235\n            </h3>\n            <form onSubmit={handleCreateAgent} className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs text-gray-500 block mb-1\">\354\247\201\354\233\220 \354\235\264\353\246\204</label>\n                <input\n                  type=\"text\"\n                  value={newAgentName}\n                  onChange={(e) => setNewAgentName(e.target.value)}\n                  placeholder=\"\354\230\210: \354\265\234\354\210\230\354\247\204\"\n                  className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border rounded-lg px-3 py-2 text-xs text-[#0b1c30] dark:text-white\"\n                />\n              </div>\n              <button\n                type=\"submit\"\n                className=\"w-full py-2 bg-[#000eba] text-white text-xs font-bold rounded-lg hover:bg-[#2532d8] shadow\"\n              >\n                \354\203\201\353\213\264\354\233\220 \354\266\224\352\260\200\355\225\230\352\270\260\n              </button>\n            </form>\n          </div>\n\n          <div className=\"md:col-span-2 bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n            <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white\">\n              \353\223\261\353\241\235\353\220\234 \354\202\254\353\202\264 \354\203\201\353\213\264\354\233\220 \353\247\210\354\212\244\355\204\260 ({agents.length}\353\252\205)\n            </h3>\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-xs text-left border-collapse\">\n                <thead>\n                  <tr className=\"bg-[#f8f9ff] dark:bg-[#213145] text-gray-500 border-b\">\n                    <th className=\"p-2.5\">\354\247\201\354\233\220 \354\235\264\353\246\204</th>\n                    <th className=\"p-2.5\">\354\203\201\355\203\234</th>\n                    <th className=\"p-2.5\">\353\223\261\353\241\235\354\235\274\354\213\234</th>\n                    <th className=\"p-2.5 text-right\">\354\203\201\355\203\234 \353\263\200\352\262\275</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y\">\n                  {agents.map((agent) => (\n                    <tr key={agent.id} className=\"hover:bg-[#f8f9ff]/50\">\n                      <td className=\"p-2.5 font-bold text-[#0b1c30] dark:text-white\">\n                        {agent.agent_name} \354\203\201\353\213\264\354\202\254\n                      </td>\n                      <td className=\"p-2.5\">\n                        <span\n                          className={`px-2 py-0.5 rounded text-[10px] font-bold ${\n                            agent.agent_status === \'\355\231\234\354\204\261\355\231\224\'\n                              ? \'bg-emerald-100 text-emerald-800\'\n                              : \'bg-gray-200 text-gray-600\'\n                          }`}\n                        >\n                          {agent.agent_status}\n                        </span>\n                      </td>\n                      <td className=\"p-2.5 text-gray-400 font-mono\">\n                        {agent.created_at.slice(0, 10)}\n                      </td>\n                      <td className=\"p-2.5 text-right\">\n                        <button\n                          onClick={() => onToggleAgentStatus(agent.id)}\n                          className=\"px-2.5 py-1 text-[11px] rounded bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium\"\n                        >\n                          {agent.agent_status === \'\355\231\234\354\204\261\355\231\224\' ? \'\353\271\204\355\231\234\354\204\261\355\231\224 \354\240\204\355\231\230\' : \'\355\231\234\354\204\261\355\231\224 \354\240\204\355\231\230\'}\n                        </button>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Tab 2: Saved Macro Templates */}\n      {activeTab === \'templates\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n            <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-2\">\n              <FileText className=\"w-4 h-4 text-[#000eba]\" /> \354\213\240\352\267\234 \353\260\234\354\206\241 \355\205\234\355\224\214\353\246\277 \353\223\261\353\241\235\n            </h3>\n            <form onSubmit={handleCreateTemplate} className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs text-gray-500 block mb-1\">\355\205\234\355\224\214\353\246\277 \354\240\234\353\252\251</label>\n                <input\n                  type=\"text\"\n                  value={newTmplTitle}\n                  onChange={(e) => setNewTmplTitle(e.target.value)}\n                  placeholder=\"\354\230\210: \354\236\205\354\260\250 \353\266\210\354\235\221 \354\225\210\353\202\264\"\n                  className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border rounded-lg px-3 py-2 text-xs text-[#0b1c30] dark:text-white\"\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-gray-500 block mb-1\">\n                  \353\263\270\353\254\270 (\354\247\200\354\233\220 \354\271\230\355\231\230\354\236\220: #&#123;car_number&#125;, #&#123;parking_name&#125;)\n                </label>\n                <textarea\n                  value={newTmplContent}\n                  onChange={(e) => setNewTmplContent(e.target.value)}\n                  rows={4}\n                  placeholder=\"[ZMS] #{parking_name} \354\243\274\354\260\250\354\236\245\354\227\220 #{car_number} \354\260\250\353\237\211 \354\225\210\353\202\264 \353\223\234\353\246\275\353\213\210\353\213\244...\"\n                  className=\"w-full bg-[#f8f9ff] dark:bg-[#213145] border rounded-lg p-2.5 text-xs text-[#0b1c30] dark:text-white\"\n                />\n              </div>\n              <button\n                type=\"submit\"\n                className=\"w-full py-2 bg-[#000eba] text-white text-xs font-bold rounded-lg hover:bg-[#2532d8] shadow\"\n              >\n                \355\205\234\355\224\214\353\246\277 \354\240\200\354\236\245\355\225\230\352\270\260\n              </button>\n            </form>\n          </div>\n\n          <div className=\"md:col-span-2 bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n            <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white\">\n              \354\236\220\354\243\274 \354\223\260\353\212\224 \354\203\201\354\232\251\352\265\254 \355\205\234\355\224\214\353\246\277 \353\252\251\353\241\235 ({templates.length}\352\261\264)\n            </h3>\n            <div className=\"space-y-3\">\n              {templates.map((tmpl) => (\n                <div\n                  key={tmpl.id}\n                  className=\"p-3 bg-[#f8f9ff] dark:bg-[#213145] rounded-xl border border-gray-200 flex justify-between items-start text-xs space-y-1\"\n                >\n                  <div>\n                    <span className=\"font-bold text-[#000eba]\">{tmpl.template_title}</span>\n                    <p className=\"text-gray-600 dark:text-gray-300 mt-1 font-mono\">{tmpl.content}</p>\n                    <span className=\"text-[10px] text-gray-400\">\354\236\221\354\204\261\354\236\220: {tmpl.created_by}</span>\n                  </div>\n                  <button\n                    onClick={() => onDeleteTemplate(tmpl.id)}\n                    className=\"p-1 text-red-500 hover:bg-red-50 rounded\"\n                    title=\"\354\202\255\354\240\234\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Tab 3: Blacklist Management */}\n      {activeTab === \'blacklist\' && (\n        <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n          <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <AlertTriangle className=\"w-4 h-4 text-red-500\" /> \354\203\201\354\212\265 \353\266\200\354\240\225\354\243\274\354\260\250 \353\260\217 \354\232\224\354\243\274\354\235\230 \352\263\240\352\260\235(\353\270\224\353\236\231\353\246\254\354\212\244\355\212\270) \355\206\265\354\240\234\n          </h3>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-xs text-left border-collapse\">\n              <thead>\n                <tr className=\"bg-[#f8f9ff] dark:bg-[#213145] text-gray-500 border-b\">\n                  <th className=\"p-2.5\">\354\260\250\353\237\211\353\262\210\355\230\270</th>\n                  <th className=\"p-2.5\">\354\227\260\353\235\275\354\262\230</th>\n                  <th className=\"p-2.5\">\354\260\250\354\242\205</th>\n                  <th className=\"p-2.5\">\353\270\224\353\236\231\353\246\254\354\212\244\355\212\270 \354\203\201\355\203\234</th>\n                  <th className=\"p-2.5\">\355\212\271\354\235\264\354\202\254\355\225\255 \353\251\224\353\252\250</th>\n                  <th className=\"p-2.5 text-right\">\355\206\240\352\270\200 \354\240\204\355\231\230</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y\">\n                {customers.map((cust) => (\n                  <tr key={cust.id} className=\"hover:bg-[#f8f9ff]/50\">\n                    <td className=\"p-2.5 font-mono font-bold text-[#000eba]\">\n                      {cust.car_number}\n                    </td>\n                    <td className=\"p-2.5 font-mono\">{cust.phone_number}</td>\n                    <td className=\"p-2.5\">{cust.car_type}</td>\n                    <td className=\"p-2.5\">\n                      {cust.is_blacklist ? (\n                        <span className=\"px-2 py-0.5 rounded bg-red-100 text-red-800 font-bold\">\n                          \360\237\224\264 \353\270\224\353\236\231\353\246\254\354\212\244\355\212\270\n                        </span>\n                      ) : (\n                        <span className=\"px-2 py-0.5 rounded bg-gray-100 text-gray-600\">\n                          \354\240\225\354\203\201 \352\263\240\352\260\235\n                        </span>\n                      )}\n                    </td>\n                    <td className=\"p-2.5 text-gray-500 max-w-xs truncate\">\n                      {cust.special_note || \'-\'}\n                    </td>\n                    <td className=\"p-2.5 text-right\">\n                      <button\n                        onClick={() => onToggleBlacklist(cust.id)}\n                        className={`px-2.5 py-1 text-[11px] rounded font-bold ${\n                          cust.is_blacklist\n                            ? \'bg-gray-200 text-gray-700\'\n                            : \'bg-red-600 text-white hover:bg-red-700\'\n                        }`}\n                      >\n                        {cust.is_blacklist ? \'\355\225\264\354\240\234\355\225\230\352\270\260\' : \'\353\270\224\353\236\231\353\246\254\354\212\244\355\212\270 \353\223\261\353\241\235\'}\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n\n      {/* Tab 4: Data Integrity Settings */}\n      {activeTab === \'integrity\' && (\n        <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n          <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <Lock className=\"w-4 h-4 text-[#000eba]\" /> \354\240\204\354\202\260 \353\215\260\354\235\264\355\204\260 \353\254\264\352\262\260\354\204\261 (Data Integrity) \353\260\217 \354\266\251\353\217\214 \353\260\251\354\247\200 \354\262\230\353\246\254\n          </h3>\n\n          <div className=\"space-y-3 text-xs text-gray-600 dark:text-gray-300\">\n            <div className=\"p-4 bg-[#f8f9ff] dark:bg-[#213145] rounded-xl border flex items-center justify-between\">\n              <div>\n                <p className=\"font-bold text-[#0b1c30] dark:text-white\">\353\217\231\354\213\234 \354\210\230\354\240\225 \354\266\251\353\217\214 \354\240\234\354\226\264 (Supabase Realtime Lock)</p>\n                <p className=\"text-[11px] text-gray-400\">\353\221\220 \354\203\201\353\213\264\354\202\254\352\260\200 \353\217\231\354\235\274 \352\263\240\352\260\235\354\235\204 \353\217\231\354\213\234\354\227\220 \354\210\230\354\240\225\355\225\240 \353\225\214 \353\215\260\354\235\264\355\204\260 \353\215\256\354\226\264\354\223\260\352\270\260 \353\260\251\354\247\200 \354\262\230\353\246\254</p>\n              </div>\n              <span className=\"px-2.5 py-1 bg-emerald-100 text-emerald-800 font-bold rounded-full text-[11px]\">\n                \355\231\234\354\204\261\355\231\224 (Active)\n              </span>\n            </div>\n\n            <div className=\"p-4 bg-[#f8f9ff] dark:bg-[#213145] rounded-xl border flex items-center justify-between\">\n              <div>\n                <p className=\"font-bold text-[#0b1c30] dark:text-white\">\354\260\250\353\237\211\353\262\210\355\230\270 \353\260\217 \354\240\204\355\231\224\353\262\210\355\230\270 \354\234\240\355\232\250\354\204\261 \354\236\220\353\217\231 \352\262\200\354\246\235 (Validation)</p>\n                <p className=\"text-[11px] text-gray-400\">\354\230\244\354\236\205\353\240\245 \354\240\225\355\230\225 \353\215\260\354\235\264\355\204\260 \354\236\220\353\217\231 \354\260\250\353\213\250 \353\260\217 \355\225\230\354\235\264\355\224\210 \354\240\234\352\261\260 \354\240\225\352\267\234\355\231\224 \354\240\200\354\236\245</p>\n              </div>\n              <span className=\"px-2.5 py-1 bg-emerald-100 text-emerald-800 font-bold rounded-full text-[11px]\">\n                \355\231\234\354\204\261\355\231\224 (Active)\n              </span>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
