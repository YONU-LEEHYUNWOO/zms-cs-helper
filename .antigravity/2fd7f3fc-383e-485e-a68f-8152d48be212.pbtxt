      target_content: "  // Active Workspace Selection State\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer>(INITIAL_CUSTOMERS[0]);\n  const [selectedConsultationId, setSelectedConsultationId] = useState<string | null>(null);\n  const [currentAgentName, setCurrentAgentName] = useState<string>(\'\352\271\200\354\262\240\354\210\230\');\n  const [notes, setNotes] = useState<string>(\n    \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245 \354\260\250\353\213\250\352\270\260 \353\257\270\354\235\270\354\213\235 \353\254\270\354\235\230\353\241\234 \354\233\220\352\262\251 \352\260\234\353\260\251 \354\262\230\353\246\254 \354\231\204\353\243\214\355\225\250. \354\266\234\354\260\250 \353\252\250\353\213\210\355\204\260\353\247\201 \354\230\210\354\240\225.\'\n  );\n\n  // Active consultation tied to selected consultation ID or customer with robust fallback\n  const activeConsultation: Consultation = useMemo(() => {\n    if (selectedConsultationId) {\n      const found = consultations.find((c) => c.id === selectedConsultationId);\n      if (found) return found;\n    }\n    const byCust =\n      consultations.find((c) => c.customer_id === selectedCustomer.id && c.status !== \'\354\231\204\353\243\214\') ||\n      consultations.find((c) => c.customer_id === selectedCustomer.id);\n    if (byCust) return byCust;\n\n    return {\n      id: `draft-${selectedCustomer.id}`,\n      customer_id: selectedCustomer.id,\n      car_number: selectedCustomer.car_number,\n      phone_number: selectedCustomer.phone_number,\n      user_type: (selectedCustomer.user_type as any) || \'\354\202\254\354\232\251\354\236\220\',\n      parking_type: \'\354\235\274\354\243\274\354\260\250\',\n      parking_name: \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n      inquiry_type: \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n      status: \'\354\240\221\354\210\230\',\n      sub_status: \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n      agent_name: currentAgentName,\n      summary: notes,\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n  }, [selectedConsultationId, consultations, selectedCustomer, currentAgentName, notes]);\n\n  const isExistingConsultation = useMemo(() => {\n    return consultations.some((c) => c.id === activeConsultation?.id);\n  }, [consultations, activeConsultation]);\n\n  const activeCallLog =\n    callLogs.find((cl) => cl.customer_id === selectedCustomer.id) || callLogs[0];\n\n  // Load live CTI logs on boot\n  useEffect(() => {\n    fetchCTICallLogs().then((logs) => {\n      if (logs && logs.length > 0) {\n        setCallLogs((prev) => [...logs, ...prev]);\n      }\n    });\n  }, []);\n\n  // Handlers for Workspace\n  const handleUpdateCustomerField = (field: keyof Customer, value: any) => {\n    setCustomers((prev) => {\n      const exists = prev.some((c) => c.id === selectedCustomer.id);\n      if (exists) {\n        return prev.map((c) => (c.id === selectedCustomer.id ? { ...c, [field]: value } : c));\n      }\n      return [{ ...selectedCustomer, [field]: value }, ...prev];\n    });\n    setSelectedCustomer((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const handleSelectConsultation = (consId: string) => {\n    const target = consultations.find((c) => c.id === consId);\n    if (target) {\n      setSelectedConsultationId(consId);\n      setNotes(target.summary || \'\');\n\n      // Sync customer\n      const matchingCust =\n        customers.find((c) => c.id === target.customer_id) ||\n        customers.find((c) => c.car_number && c.car_number === target.car_number) ||\n        customers.find((c) => c.phone_number && c.phone_number === target.phone_number);\n\n      if (matchingCust) {\n        setSelectedCustomer(matchingCust);\n      } else {\n        setSelectedCustomer({\n          id: target.customer_id || `cust-${Date.now()}`,\n          phone_number: target.phone_number || \'\',\n          car_number: target.car_number || \'\',\n          car_type: \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n          car_detail: \'\',\n          bank_name: \'\',\n          account_number: \'\',\n          account_holder: \'\',\n          is_blacklist: false,\n          special_note: \'\',\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString(),\n        });\n      }\n\n      setActiveTab(\'workspace\');\n    }\n  };\n\n  const handleStartNewConsultation = () => {\n    setSelectedConsultationId(null);\n    setNotes(\'\');\n  };\n\n  const handleResetForm = () => {\n    setSelectedConsultationId(null);\n    const freshCustomer: Customer = {\n      id: `cust-${Date.now()}`,\n      phone_number: \'\',\n      car_number: \'\',\n      car_type: \'\354\244\221\355\230\225\354\204\270\353\213\250\',\n      car_detail: \'\',\n      bank_name: \'\',\n      account_number: \'\',\n      account_holder: \'\',\n      is_blacklist: false,\n      special_note: \'\',\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n    setSelectedCustomer(freshCustomer);\n    setNotes(\'\');\n  };"
      replacement_content: "  // Helper to create a clean fresh customer template\n  const createFreshCustomer = (): Customer => ({\n    id: `cust-${Date.now()}`,\n    phone_number: \'\',\n    car_number: \'\',\n    car_type: \'\',\n    car_detail: \'\',\n    bank_name: \'\',\n    account_number: \'\',\n    account_holder: \'\',\n    is_blacklist: false,\n    special_note: \'\',\n    created_at: new Date().toISOString(),\n    updated_at: new Date().toISOString(),\n  });\n\n  // Active Workspace Selection State (Defaults to Fresh New Input)\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer>(createFreshCustomer);\n  const [selectedConsultationId, setSelectedConsultationId] = useState<string | null>(null);\n  const [currentAgentName, setCurrentAgentName] = useState<string>(\'\352\271\200\354\262\240\354\210\230\');\n  const [notes, setNotes] = useState<string>(\'\');\n\n  // Active consultation tied to selected consultation ID or customer with robust fallback\n  const activeConsultation: Consultation = useMemo(() => {\n    if (selectedConsultationId) {\n      const found = consultations.find((c) => c.id === selectedConsultationId);\n      if (found) return found;\n    }\n    const byCust =\n      consultations.find((c) => c.customer_id === selectedCustomer.id && c.status !== \'\354\231\204\353\243\214\') ||\n      consultations.find((c) => c.customer_id === selectedCustomer.id);\n    if (byCust) return byCust;\n\n    return {\n      id: `draft-${selectedCustomer.id}`,\n      customer_id: selectedCustomer.id,\n      car_number: selectedCustomer.car_number,\n      phone_number: selectedCustomer.phone_number,\n      user_type: (selectedCustomer.user_type as any) || \'\354\202\254\354\232\251\354\236\220\',\n      parking_type: \'\354\235\274\354\243\274\354\260\250\',\n      parking_name: \'\352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245\',\n      inquiry_type: \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n      status: \'\354\240\221\354\210\230\',\n      sub_status: \'\354\213\240\352\267\234 \354\240\221\354\210\230 \352\261\264\',\n      agent_name: currentAgentName,\n      summary: notes,\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n  }, [selectedConsultationId, consultations, selectedCustomer, currentAgentName, notes]);\n\n  const isExistingConsultation = useMemo(() => {\n    return consultations.some((c) => c.id === activeConsultation?.id);\n  }, [consultations, activeConsultation]);\n\n  const activeCallLog =\n    callLogs.find((cl) => cl.customer_id === selectedCustomer.id) || callLogs[0];\n\n  // Load live CTI logs on boot\n  useEffect(() => {\n    fetchCTICallLogs().then((logs) => {\n      if (logs && logs.length > 0) {\n        setCallLogs((prev) => [...logs, ...prev]);\n      }\n    });\n  }, []);\n\n  // Handlers for Workspace\n  const handleUpdateCustomerField = (field: keyof Customer, value: any) => {\n    const updatedCust = { ...selectedCustomer, [field]: value };\n\n    // Automatic DB lookup when typing phone or car number\n    if (field === \'phone_number\' || field === \'car_number\') {\n      const strVal = String(value || \'\').trim();\n      const cleanVal = strVal.replace(/[^0-9a-zA-Z\352\260\200-\355\236\243]/g, \'\');\n\n      if (cleanVal.length >= 3) {\n        // Search matching customer in DB\n        const match = customers.find((c) => {\n          if (field === \'phone_number\') {\n            const cPhone = (c.phone_number || \'\').replace(/[^0-9]/g, \'\');\n            return cPhone.length >= 3 && cPhone === cleanVal.replace(/[^0-9]/g, \'\');\n          } else {\n            const cCar = (c.car_number || \'\').replace(/\\s+/g, \'\').toUpperCase();\n            return cCar.length >= 3 && cCar === cleanVal.toUpperCase();\n          }\n        });\n\n        if (match) {\n          setSelectedCustomer({ ...match, [field]: value });\n          const matchCons =\n            consultations.find((c) => c.customer_id === match.id && c.status !== \'\354\231\204\353\243\214\') ||\n            consultations.find((c) => c.customer_id === match.id);\n\n          if (matchCons) {\n            setSelectedConsultationId(matchCons.id);\n            setNotes(matchCons.summary || \'\');\n          } else {\n            setSelectedConsultationId(null);\n          }\n\n          setCustomers((prev) =>\n            prev.map((c) => (c.id === match.id ? { ...match, [field]: value } : c))\n          );\n          return;\n        } else {\n          // No match found -> keep as new input mode\n          if (selectedConsultationId) {\n            setSelectedConsultationId(null);\n          }\n        }\n      }\n    }\n\n    setCustomers((prev) => {\n      const exists = prev.some((c) => c.id === selectedCustomer.id);\n      if (exists) {\n        return prev.map((c) => (c.id === selectedCustomer.id ? updatedCust : c));\n      }\n      return prev;\n    });\n\n    setSelectedCustomer(updatedCust);\n  };\n\n  const handleSelectConsultation = (consId: string) => {\n    const target = consultations.find((c) => c.id === consId);\n    if (target) {\n      setSelectedConsultationId(consId);\n      setNotes(target.summary || \'\');\n\n      // Sync customer\n      const matchingCust =\n        customers.find((c) => c.id === target.customer_id) ||\n        customers.find((c) => c.car_number && c.car_number === target.car_number) ||\n        customers.find((c) => c.phone_number && c.phone_number === target.phone_number);\n\n      if (matchingCust) {\n        setSelectedCustomer(matchingCust);\n      } else {\n        setSelectedCustomer({\n          id: target.customer_id || `cust-${Date.now()}`,\n          phone_number: target.phone_number || \'\',\n          car_number: target.car_number || \'\',\n          car_type: \'\',\n          car_detail: \'\',\n          bank_name: \'\',\n          account_number: \'\',\n          account_holder: \'\',\n          is_blacklist: false,\n          special_note: \'\',\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString(),\n        });\n      }\n\n      setActiveTab(\'workspace\');\n    }\n  };\n\n  const handleStartNewConsultation = () => {\n    setSelectedConsultationId(null);\n    setNotes(\'\');\n  };\n\n  const handleResetForm = () => {\n    setSelectedConsultationId(null);\n    setSelectedCustomer(createFreshCustomer());\n    setNotes(\'\');\n  };"
