    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Bell, HelpCircle, Settings, Sparkles, User, UserCheck } from \'lucide-react\';\nimport { HeaderSearchBar } from \'./search/HeaderSearchBar\';\nimport { Customer, Consultation, InternalAgent } from \'../types\';\nimport { fetchAIMorningBriefing } from \'../lib/services/aiSummaryService\';\n\ninterface TopNavBarProps {\n  customers: Customer[];\n  consultations: Consultation[];\n  agents: InternalAgent[];\n  currentAgentName: string;\n  setCurrentAgentName: (name: string) => void;\n  onSelectCustomer: (cust: Customer) => void;\n  onTakeoverConsultation: (consId: string) => void;\n}\n\nexport const TopNavBar: React.FC<TopNavBarProps> = ({\n  customers,\n  consultations,\n  agents,\n  currentAgentName,\n  setCurrentAgentName,\n  onSelectCustomer,\n  onTakeoverConsultation,\n}) => {\n  const [briefingOpen, setBriefingOpen] = useState(false);\n  const [briefingText, setBriefingText] = useState<string | null>(null);\n  const [loadingBriefing, setLoadingBriefing] = useState(false);\n\n  const handleOpenBriefing = async () => {\n    setBriefingOpen(!briefingOpen);\n    if (!briefingText) {\n      setLoadingBriefing(true);\n      const text = await fetchAIMorningBriefing(currentAgentName);\n      setBriefingText(text);\n      setLoadingBriefing(false);\n    }\n  };\n\n  return (\n    <header className=\"bg-white dark:bg-[#0b1c30] flex justify-between items-center w-full px-6 h-16 sticky top-0 z-30 border-b border-[#c5c5d8]/40 shadow-sm\">\n      {/* Brand & Search Bar */}\n      <div className=\"flex items-center gap-6 flex-1 max-w-2xl\">\n        <span className=\"text-xl font-black text-[#000eba] dark:text-[#bec2ff] tracking-tight shrink-0\">\n          PARK_OS\n        </span>\n\n        {/* Format-free Header Search */}\n        <HeaderSearchBar\n          customers={customers}\n          consultations={consultations}\n          currentAgentName={currentAgentName}\n          onSelectCustomer={onSelectCustomer}\n          onTakeoverConsultation={onTakeoverConsultation}\n        />\n      </div>\n\n      {/* Right Controls: Agent Selector, AI Briefing Bell, Avatar */}\n      <div className=\"flex items-center gap-3\">\n        {/* Active Agent Selector */}\n        <div className=\"hidden sm:flex items-center gap-1.5 bg-[#e5eeff] dark:bg-[#213145] px-3 py-1 rounded-full text-xs border border-[#c5c5d8]/30\">\n          <UserCheck className=\"w-3.5 h-3.5 text-[#000eba] dark:text-[#bec2ff]\" />\n          <span className=\"text-gray-500 text-[11px]\">\353\213\264\353\213\271:</span>\n          <select\n            value={currentAgentName}\n            onChange={(e) => setCurrentAgentName(e.target.value)}\n            className=\"bg-transparent font-bold text-[#0b1c30] dark:text-white border-none focus:outline-none cursor-pointer\"\n          >\n            {agents\n              .filter((a) => a.agent_status === \'\355\231\234\354\204\261\355\231\224\')\n              .map((a) => (\n                <option key={a.id} value={a.agent_name} className=\"bg-white dark:bg-[#0b1c30]\">\n                  {a.agent_name} \354\203\201\353\213\264\354\202\254\n                </option>\n              ))}\n          </select>\n        </div>\n\n        {/* AI Morning Briefing Bell */}\n        <div className=\"relative\">\n          <button\n            onClick={handleOpenBriefing}\n            title=\"AI \354\225\204\354\271\250 \353\270\214\353\246\254\355\225\221 & \354\225\214\353\246\274\"\n            className=\"p-2 text-gray-600 dark:text-gray-300 hover:bg-[#e5eeff] dark:hover:bg-[#213145] transition-colors rounded-full relative\"\n          >\n            <Bell className=\"w-4 h-4\" />\n            <span className=\"w-2 h-2 rounded-full bg-red-500 absolute top-1.5 right-1.5 animate-ping\"></span>\n            <span className=\"w-2 h-2 rounded-full bg-red-500 absolute top-1.5 right-1.5\"></span>\n          </button>\n\n          {/* AI Briefing Popup */}\n          {briefingOpen && (\n            <div className=\"absolute right-0 top-full mt-2 w-80 bg-white dark:bg-[#213145] rounded-2xl shadow-2xl border border-[#c5c5d8]/40 p-4 z-50 text-xs\">\n              <div className=\"flex items-center justify-between border-b pb-2 mb-2\">\n                <span className=\"font-bold flex items-center gap-1 text-[#000eba] dark:text-[#bec2ff]\">\n                  <Sparkles className=\"w-3.5 h-3.5\" /> AI \354\266\234\352\267\274 \353\270\214\353\246\254\355\225\221\n                </span>\n                <button onClick={() => setBriefingOpen(false)} className=\"text-gray-400 hover:text-gray-600\">\n                  \342\234\225\n                </button>\n              </div>\n\n              {loadingBriefing ? (\n                <div className=\"py-4 text-center text-gray-400 animate-pulse\">\n                  AI\352\260\200 \354\230\244\353\212\230\354\235\230 \353\257\270\352\262\260 \352\263\274\354\240\234 \353\260\217 \354\275\234\353\260\261\354\235\204 \353\270\214\353\246\254\355\225\221 \354\244\221\354\236\205\353\213\210\353\213\244...\n                </div>\n              ) : (\n                <div className=\"space-y-2 text-[#0b1c30] dark:text-gray-200\">\n                  <p className=\"bg-[#f8f9ff] dark:bg-[#0b1c30] p-3 rounded-xl border border-gray-100 dark:border-gray-800 leading-relaxed\">\n                    {briefingText}\n                  </p>\n                  <div className=\"text-[10px] text-gray-400 text-right\">\n                    \354\265\234\354\242\205 \353\217\231\352\270\260\355\231\224: \354\230\244\353\212\230 09:00 (\354\240\204\352\262\260\354\234\250 100% \353\252\251\355\221\234)\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Agent Avatar */}\n        <div className=\"w-8 h-8 rounded-full overflow-hidden border border-[#c5c5d8] cursor-pointer hover:opacity-80 transition-opacity bg-[#dce9ff] flex items-center justify-center text-[#000eba] font-bold text-xs\">\n          {currentAgentName.slice(0, 1)}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
