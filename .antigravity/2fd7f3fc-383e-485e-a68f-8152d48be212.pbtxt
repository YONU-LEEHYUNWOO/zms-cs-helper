    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { History, Database, Archive, Play, FileText, Search } from \'lucide-react\';\nimport { Consultation, CallLog } from \'../../types\';\n\ninterface LogsArchiveViewProps {\n  consultations: Consultation[];\n  callLogs: CallLog[];\n}\n\nexport const LogsArchiveView: React.FC<LogsArchiveViewProps> = ({\n  consultations,\n  callLogs,\n}) => {\n  const [showColdArchive, setShowColdArchive] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'consultations\' | \'call_logs\'>(\'consultations\');\n\n  const warmConsultations = consultations.filter((c) => !c.is_archived);\n  const coldArchivedConsultations = consultations.filter((c) => c.is_archived);\n\n  return (\n    <div className=\"p-6 max-w-[1600px] mx-auto space-y-6\">\n      {/* Logs Header */}\n      <div className=\"bg-white dark:bg-[#0b1c30] p-4 rounded-2xl border border-[#c5c5d8]/40 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-lg font-bold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-[#000eba]\" />\n            \355\206\265\355\231\224 \353\205\271\354\267\250 & \354\231\204\353\243\214 \353\215\260\354\235\264\355\204\260 \354\235\264\353\240\245 \354\225\204\354\271\264\354\235\264\353\271\231 (3\353\213\250\352\263\204 Archiving)\n          </h2>\n          <p className=\"text-xs text-[#454555]\">\n            \354\265\234\352\267\274 3\352\260\234\354\233\224 \353\257\270\353\247\214 \353\215\260\354\235\264\355\204\260(Warm DB)\354\231\200 3\352\260\234\354\233\224 \354\235\264\354\203\201 \352\262\275\352\263\274 \353\263\264\354\241\264 \353\215\260\354\235\264\355\204\260(Cold DB)\353\245\274 \354\260\250\353\223\261 \355\230\270\354\266\234\355\225\230\354\227\254 \354\204\234\353\262\204 \354\206\215\353\217\204\353\245\274 \354\265\234\354\240\201\355\231\224\355\225\251\353\213\210\353\213\244.\n          </p>\n        </div>\n\n        <div className=\"flex gap-2\">\n          <button\n            onClick={() => setActiveTab(\'consultations\')}\n            className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${\n              activeTab === \'consultations\'\n                ? \'bg-[#000eba] text-white shadow\'\n                : \'bg-[#f8f9ff] text-gray-600 border\'\n            }`}\n          >\n            \354\203\201\353\213\264 \354\235\264\353\240\245 \352\264\200\353\246\254\n          </button>\n          <button\n            onClick={() => setActiveTab(\'call_logs\')}\n            className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${\n              activeTab === \'call_logs\'\n                ? \'bg-[#000eba] text-white shadow\'\n                : \'bg-[#f8f9ff] text-gray-600 border\'\n            }`}\n          >\n            CTI \353\205\271\354\267\250 \353\241\234\352\267\270\n          </button>\n        </div>\n      </div>\n\n      {activeTab === \'consultations\' ? (\n        <div className=\"space-y-4\">\n          {/* Active Warm DB Table */}\n          <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-3\">\n            <div className=\"flex justify-between items-center border-b pb-2\">\n              <span className=\"font-bold text-xs text-[#000eba] flex items-center gap-1.5\">\n                <Database className=\"w-4 h-4 text-emerald-600\" /> [Warm DB] \355\231\234\354\204\261 \353\260\217 \354\265\234\352\267\274 3\352\260\234\354\233\224 \354\203\201\353\213\264 \354\235\264\353\240\245 ({warmConsultations.length}\352\261\264)\n              </span>\n              <span className=\"text-[11px] text-gray-400\">\354\203\201\354\213\234 \354\213\244\354\213\234\352\260\204 \353\217\231\352\270\260\355\231\224 \355\230\270\354\266\234</span>\n            </div>\n\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-xs text-left border-collapse\">\n                <thead>\n                  <tr className=\"bg-[#f8f9ff] dark:bg-[#213145] text-gray-500 border-b\">\n                    <th className=\"p-2.5\">\354\240\221\354\210\230 \354\235\274\354\213\234</th>\n                    <th className=\"p-2.5\">\354\203\201\353\213\264\354\233\220</th>\n                    <th className=\"p-2.5\">\354\243\274\354\260\250\354\236\245\353\252\205</th>\n                    <th className=\"p-2.5\">\353\254\270\354\235\230 \354\234\240\355\230\225</th>\n                    <th className=\"p-2.5\">\354\247\204\354\262\231\353\217\204 \354\203\201\355\203\234</th>\n                    <th className=\"p-2.5\">\354\232\224\354\225\275 \353\251\224\353\252\250</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y\">\n                  {warmConsultations.map((c) => (\n                    <tr key={c.id} className=\"hover:bg-[#f8f9ff]/50\">\n                      <td className=\"p-2.5 font-mono text-gray-500\">\n                        {c.created_at.slice(0, 16).replace(\'T\', \' \')}\n                      </td>\n                      <td className=\"p-2.5 font-bold text-[#000eba]\">{c.agent_name}</td>\n                      <td className=\"p-2.5 font-medium\">{c.parking_name || \'\353\257\270\354\247\200\354\240\225\'}</td>\n                      <td className=\"p-2.5\">\n                        <span className=\"px-1.5 py-0.5 rounded bg-gray-100 text-gray-700\">\n                          {c.inquiry_type}\n                        </span>\n                      </td>\n                      <td className=\"p-2.5\">\n                        <span className=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-semibold\">\n                          {c.status}\n                        </span>\n                      </td>\n                      <td className=\"p-2.5 text-gray-600 dark:text-gray-300 max-w-md truncate\">\n                        {c.summary}\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          {/* 3-Month Archive Cold DB Bridge Toggle */}\n          <div className=\"text-center pt-2\">\n            <button\n              onClick={() => setShowColdArchive(!showColdArchive)}\n              className=\"px-4 py-2 bg-[#e5eeff] dark:bg-[#213145] hover:bg-[#dce9ff] text-[#000eba] dark:text-[#bec2ff] font-bold text-xs rounded-xl border border-[#c5c5d8]/40 shadow-sm transition-all flex items-center justify-center gap-2 mx-auto\"\n            >\n              <Archive className=\"w-4 h-4 text-[#000eba]\" />\n              {showColdArchive\n                ? \'3\352\260\234\354\233\224 \354\235\264\354\240\204 \352\263\274\352\261\260 \354\225\204\354\271\264\354\235\264\353\270\214 \354\235\264\353\240\245 \353\213\253\352\270\260\'\n                : `[3\352\260\234\354\233\224 \354\235\264\354\240\204 \352\263\274\352\261\260 \354\235\264\353\240\245 \353\215\224 \353\263\264\352\270\260 (${coldArchivedConsultations.length}\352\261\264 \354\241\264\354\236\254)]`}\n            </button>\n          </div>\n\n          {/* Cold Backup DB View */}\n          {showColdArchive && (\n            <div className=\"bg-gray-50 dark:bg-[#213145]/40 p-5 rounded-2xl border border-dashed border-gray-300 space-y-3 animate-fadeIn\">\n              <div className=\"flex justify-between items-center border-b border-gray-200 pb-2\">\n                <span className=\"font-bold text-xs text-purple-700 dark:text-purple-300 flex items-center gap-1.5\">\n                  <Archive className=\"w-4 h-4\" /> [Cold DB] 3\352\260\234\354\233\224 \352\262\275\352\263\274 \353\260\261\354\227\205 \354\235\264\352\264\200 \353\215\260\354\235\264\355\204\260 (Archive Table)\n                </span>\n                <span className=\"text-[11px] text-gray-400\">\353\271\204\353\217\231\352\270\260 \353\270\214\353\246\277\354\247\200 \354\240\204\354\232\251 \353\271\204\353\266\200\355\225\230 \355\230\270\354\266\234</span>\n              </div>\n\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-xs text-left border-collapse\">\n                  <thead>\n                    <tr className=\"bg-gray-100 dark:bg-gray-800 text-gray-500 border-b\">\n                      <th className=\"p-2.5\">\352\263\274\352\261\260 \354\235\274\354\213\234</th>\n                      <th className=\"p-2.5\">\353\213\264\353\213\271 \354\203\201\353\213\264\354\233\220</th>\n                      <th className=\"p-2.5\">\354\243\274\354\260\250\354\236\245\353\252\205</th>\n                      <th className=\"p-2.5\">\354\235\264\352\264\200 \354\203\201\355\203\234</th>\n                      <th className=\"p-2.5\">\352\263\274\352\261\260 \354\235\264\353\240\245 \354\232\224\354\225\275</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y\">\n                    {coldArchivedConsultations.map((ac) => (\n                      <tr key={ac.id} className=\"hover:bg-gray-100/50\">\n                        <td className=\"p-2.5 font-mono text-gray-400\">{ac.created_at.slice(0, 10)}</td>\n                        <td className=\"p-2.5 text-gray-600\">{ac.agent_name}</td>\n                        <td className=\"p-2.5 font-medium\">{ac.parking_name}</td>\n                        <td className=\"p-2.5\">\n                          <span className=\"px-2 py-0.5 rounded bg-purple-100 text-purple-800 font-semibold text-[10px]\">\n                            {ac.sub_status || \'\353\260\261\354\227\205 \354\235\264\352\264\200\'}\n                          </span>\n                        </td>\n                        <td className=\"p-2.5 text-gray-500 max-w-md truncate\">{ac.summary}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n        </div>\n      ) : (\n        /* CTI Call Logs List View */\n        <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n          <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <FileText className=\"w-4 h-4 text-[#000eba]\" /> CTI \354\204\234\353\262\204 \354\227\260\353\217\231 \354\275\234 \353\241\234\352\267\270 \353\260\217 \354\236\220\353\217\231 STT \354\212\244\355\201\254\353\246\275\355\212\270 (http://202.30.232.240/dial/call_list.jsp)\n          </h3>\n\n          <div className=\"space-y-3\">\n            {callLogs.map((log) => (\n              <div\n                key={log.id}\n                className=\"p-4 bg-[#f8f9ff] dark:bg-[#213145] rounded-xl border border-gray-200 dark:border-gray-700 space-y-2\"\n              >\n                <div className=\"flex justify-between items-center text-xs\">\n                  <span className=\"font-mono font-bold text-[#000eba]\">\n                    \354\240\204\355\231\224\353\262\210\355\230\270: {log.phone_number}\n                  </span>\n                  <a\n                    href={log.audio_url}\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    className=\"px-2.5 py-1 bg-[#000eba] text-white text-[11px] font-semibold rounded hover:bg-[#2532d8] flex items-center gap-1\"\n                  >\n                    <Play className=\"w-3 h-3\" /> CTI \354\235\214\354\204\261 \355\214\214\354\235\274 \354\262\255\354\267\250\n                  </a>\n                </div>\n\n                <div className=\"p-3 bg-white dark:bg-[#0b1c30] rounded-lg border text-xs text-gray-700 dark:text-gray-200 whitespace-pre-line leading-relaxed\">\n                  {log.stt_script}\n                </div>\n\n                {log.ai_summary && (\n                  <p className=\"text-xs text-emerald-700 dark:text-emerald-300 font-semibold\">\n                    \360\237\222\241 AI \354\232\224\354\225\275: {log.ai_summary}\n                  </p>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
