    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ZMS_CS_HELPER - AI Summary & Assistance Service Module\n * Calls server-side Gemini endpoints for call summarization and morning briefing\n */\n\nexport interface AISummarizeResult {\n  summary: string;\n  category: string;\n  keyIssues: string[];\n  recommendedAction: string;\n}\n\nexport async function generateAISummary(\n  notesOrTranscript: string,\n  customerCarNumber?: string\n): Promise<AISummarizeResult> {\n  try {\n    const res = await fetch(\'/api/ai/summarize\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ text: notesOrTranscript, carNumber: customerCarNumber }),\n    });\n\n    if (!res.ok) {\n      throw new Error(\'AI Server response error\');\n    }\n\n    return await res.json();\n  } catch (err) {\n    console.warn(\'AI Summarize fallback used:\', err);\n    return {\n      summary: notesOrTranscript.length > 10\n        ? `[\354\232\224\354\225\275] ${notesOrTranscript.slice(0, 60)}...`\n        : \'\354\203\201\353\213\264 \353\202\264\354\232\251 \354\232\224\354\225\275 \354\231\204\353\243\214.\',\n      category: \'\354\230\244\353\245\230/\354\235\264\354\212\210\',\n      keyIssues: [\'\354\260\250\353\213\250\352\270\260 \354\235\270\354\213\235\', \'\354\236\205\354\260\250 \354\247\200\354\233\220\'],\n      recommendedAction: \'\354\233\220\352\262\251 \354\260\250\353\213\250\352\270\260 \354\213\240\355\230\270 \353\260\234\354\206\241 \355\233\204 \354\266\234\354\260\250 \353\252\250\353\213\210\355\204\260\353\247\201\',\n    };\n  }\n}\n\nexport async function fetchAIMorningBriefing(agentName: string): Promise<string> {\n  try {\n    const res = await fetch(\'/api/ai/briefing\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ agentName }),\n    });\n    if (!res.ok) throw new Error(\'Briefing error\');\n    const data = await res.json();\n    return data.briefing;\n  } catch (err) {\n    return `${agentName} \354\203\201\353\213\264\354\233\220\353\213\230, \354\230\244\353\212\230 16:00\354\227\220 \352\263\265\354\234\240\354\236\220 \354\236\254\355\206\265\355\231\224 \354\225\275\354\206\215\354\235\264 \354\236\241\355\236\214 \'\355\225\264\352\262\260\354\244\221(\353\266\200\354\236\254\354\244\221 1\354\260\250)\' \352\261\264\352\263\274 \355\212\271\354\235\264\354\202\254\355\225\255 1\352\261\264\354\235\264 \354\236\210\354\212\265\353\213\210\353\213\244. \354\227\205\353\254\264 \354\235\264\352\264\200\354\235\204 \355\231\225\354\235\270\355\225\264\354\243\274\354\204\270\354\232\224.`;\n  }\n}\n"
    }
