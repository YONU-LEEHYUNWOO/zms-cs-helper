  file_change {
    absolute_path_uri: "file:///src/components/support/SupportAiKms.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { HelpCircle, Download, Bot, Sparkles, CheckCircle } from \'lucide-react\';\nimport { Consultation } from \'../../types\';\n\ninterface SupportAiKmsProps {\n  consultations: Consultation[];\n}\n\nexport const SupportAiKms: React.FC<SupportAiKmsProps> = ({ consultations }) => {\n  const [downloaded, setDownloaded] = useState(false);\n\n  // Group FAQ by inquiry_type\n  const categories = Array.from(new Set(consultations.map((c) => c.inquiry_type)));\n\n  const handleExportKMSDataset = () => {\n    const dataset = consultations.map((c) => ({\n      prompt: `[${c.inquiry_type}] ${c.parking_name || \'\354\243\274\354\260\250\354\236\245\'} ${c.summary}`,\n      completion: `[\354\241\260\354\271\230\353\260\251\354\225\210] \354\247\204\354\262\231\353\217\204\354\203\201\355\203\234: ${c.status}, \354\204\270\353\266\200\353\202\264\354\232\251: ${c.sub_status || \'\354\240\225\354\203\201 \354\262\230\353\246\254 \354\231\204\353\243\214\'}`,\n      category: c.inquiry_type,\n    }));\n\n    const jsonStr = JSON.stringify(dataset, null, 2);\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `zms_cs_kms_dataset_${new Date().toISOString().slice(0, 10)}.json`;\n    a.click();\n\n    setDownloaded(true);\n    setTimeout(() => setDownloaded(false), 3000);\n  };\n\n  return (\n    <div className=\"p-6 max-w-[1600px] mx-auto space-y-6\">\n      {/* Support Header */}\n      <div className=\"bg-white dark:bg-[#0b1c30] p-4 rounded-2xl border border-[#c5c5d8]/40 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-lg font-bold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n            <HelpCircle className=\"w-5 h-5 text-[#000eba]\" />\n            \354\247\200\354\233\220 \353\260\217 24\354\213\234\352\260\204 \354\236\220\353\217\231\355\231\224 KMS \353\215\260\354\235\264\355\204\260\354\205\213 \352\265\254\354\266\225 (BI & AI Training)\n          </h2>\n          <p className=\"text-xs text-[#454555]\">\n            \354\203\201\353\213\264 \354\235\264\353\240\245\354\235\204 \352\270\260\353\260\230\354\234\274\353\241\234 FAQ \355\214\250\355\204\264\354\235\204 \353\266\204\354\204\235\355\225\230\352\263\240 24\354\213\234\352\260\204 AI \354\261\227\353\264\207 \355\225\231\354\212\265 \353\215\260\354\235\264\355\204\260\354\205\213\354\235\204 \354\236\220\354\202\260\355\231\224\355\225\251\353\213\210\353\213\244.\n          </p>\n        </div>\n\n        <button\n          onClick={handleExportKMSDataset}\n          className=\"px-4 py-2 bg-[#000eba] hover:bg-[#2532d8] text-white font-bold text-xs rounded-xl shadow flex items-center gap-2 transition-all\"\n        >\n          <Bot className=\"w-4 h-4 text-amber-300\" />\n          {downloaded ? \'\353\215\260\354\235\264\355\204\260\354\205\213 \353\202\264\353\263\264\353\202\264\352\270\260 \354\231\204\353\243\214!\' : \'AI \354\261\227\353\264\207 KMS \353\215\260\354\235\264\355\204\260\354\205\213 \354\266\224\354\266\234 (JSON)\'}\n        </button>\n      </div>\n\n      {/* FAQ Analytics Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"p-5 bg-white dark:bg-[#0b1c30] rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-2\">\n          <span className=\"text-xs font-bold text-[#000eba] uppercase tracking-wider\">\n            \353\210\204\354\240\201 \355\225\231\354\212\265 \353\215\260\354\235\264\355\204\260 \352\261\264\354\210\230\n          </span>\n          <p className=\"text-3xl font-black text-[#0b1c30] dark:text-white\">\n            {consultations.length}\352\261\264\n          </p>\n          <p className=\"text-xs text-gray-400\">\354\213\244\354\213\234\352\260\204 \354\203\201\353\213\264 \354\235\264\353\240\245 \353\247\244\355\225\221 \354\231\204\353\243\214</p>\n        </div>\n\n        <div className=\"p-5 bg-white dark:bg-[#0b1c30] rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-2\">\n          <span className=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">\n            \354\265\234\353\214\200 \353\260\234\354\203\235 \355\201\264\353\240\210\354\236\204 \354\234\240\355\230\225\n          </span>\n          <p className=\"text-2xl font-black text-[#0b1c30] dark:text-white\">\n            \354\230\244\353\245\230/\354\235\264\354\212\210 (\354\260\250\353\213\250\352\270\260)\n          </p>\n          <p className=\"text-xs text-gray-400\">\354\240\204\354\262\264 \353\254\270\354\235\230 \354\244\221 42% \354\240\220\354\234\240</p>\n        </div>\n\n        <div className=\"p-5 bg-white dark:bg-[#0b1c30] rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-2\">\n          <span className=\"text-xs font-bold text-purple-600 uppercase tracking-wider\">\n            24\354\213\234\352\260\204 \354\236\220\353\217\231\355\231\224 \354\244\200\353\271\204\354\234\250\n          </span>\n          <p className=\"text-3xl font-black text-[#0b1c30] dark:text-white\">98.5%</p>\n          <p className=\"text-xs text-gray-400\">RAG \353\262\240\354\235\264\354\212\244 \354\246\211\354\213\234 \354\240\204\355\231\230 \352\260\200\353\212\245</p>\n        </div>\n      </div>\n\n      {/* FAQ Category Listing */}\n      <div className=\"bg-white dark:bg-[#0b1c30] p-5 rounded-2xl border border-[#c5c5d8]/40 shadow-sm space-y-4\">\n        <h3 className=\"font-bold text-sm text-[#0b1c30] dark:text-white flex items-center gap-2\">\n          <Sparkles className=\"w-4 h-4 text-[#000eba]\" /> \354\271\264\355\205\214\352\263\240\353\246\254\353\263\204 \353\210\204\354\240\201 FAQ \353\252\250\353\262\224 \353\213\265\354\225\210 \354\247\200\354\213\235\353\262\240\354\235\264\354\212\244\n        </h3>\n\n        <div className=\"space-y-3\">\n          {categories.map((cat) => {\n            const catCons = consultations.filter((c) => c.inquiry_type === cat);\n\n            return (\n              <div\n                key={cat}\n                className=\"p-4 bg-[#f8f9ff] dark:bg-[#213145] rounded-xl border border-gray-200 dark:border-gray-700 space-y-2\"\n              >\n                <div className=\"flex justify-between items-center text-xs\">\n                  <span className=\"font-bold text-[#000eba] px-2.5 py-1 bg-white rounded border\">\n                    [\353\266\204\353\245\230] {cat} ({catCons.length}\352\261\264)\n                  </span>\n                  <span className=\"text-emerald-600 font-semibold text-[11px]\">\n                    \355\221\234\354\244\200 \353\214\200\354\235\221 \355\205\234\355\224\214\353\246\277 \352\262\200\354\246\235 \354\231\204\353\243\214\n                  </span>\n                </div>\n\n                <div className=\"space-y-1.5 pt-1\">\n                  {catCons.map((item) => (\n                    <div\n                      key={item.id}\n                      className=\"p-2.5 bg-white dark:bg-[#0b1c30] rounded-lg border text-xs space-y-1\"\n                    >\n                      <p className=\"font-semibold text-[#0b1c30] dark:text-white\">\n                        Q: {item.parking_name || \'\354\243\274\354\260\250\354\236\245\'} - {item.summary}\n                      </p>\n                      <p className=\"text-[#000eba] font-medium text-[11px]\">\n                        A (AI \355\221\234\354\244\200 \352\260\200\354\235\264\353\223\234): {item.sub_status || \'\354\233\220\352\262\251 \352\260\234\353\260\251 \353\260\217 \354\203\201\354\232\251\352\265\254 \353\254\270\354\236\220 \354\225\210\353\202\264 \354\262\230\353\246\254\'}\n                      </p>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
