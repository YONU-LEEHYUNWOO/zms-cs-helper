    replacement_chunks {
      replacement_content: "/**\n * ZMS_CS_HELPER - CTI Call Log & STT Service Module\n * Handles loose integration with http://202.30.232.240/dial/call_list.jsp\n */\n\nimport { CallLog } from \'../../types\';\n\nexport async function fetchCTICallLogs(): Promise<CallLog[]> {\n  try {\n    const res = await fetch(\'/api/cti/calls\');\n    if (!res.ok) throw new Error(\'CTI server error\');\n    return await res.json();\n  } catch (err) {\n    console.warn(\'Failed to fetch CTI calls from server, using local fallback:\', err);\n    return [\n      {\n        id: \'call-live-1\',\n        phone_number: \'01012344567\',\n        audio_url: \'http://202.30.232.240/dial/call_list.jsp?id=20260804_001\',\n        stt_script: `[\354\203\201\353\213\264\354\202\254 \352\271\200\354\262\240\354\210\230] ParkOS \354\243\274\354\260\250 \352\263\265\354\234\240 CS \354\204\274\355\204\260 \352\271\200\354\262\240\354\210\230\354\236\205\353\213\210\353\213\244.\n[\352\263\240\352\260\235 \355\231\215\352\270\270\353\217\231] \353\204\244, \352\260\225\353\202\250\354\227\255 \355\205\214\355\227\244\353\236\200\353\271\214\353\224\251 \354\243\274\354\260\250\354\236\245 \354\260\250\353\213\250\352\270\260\352\260\200 \354\225\210 \354\227\264\353\240\244\354\232\224. \354\260\250\353\237\211\353\262\210\355\230\270 12\352\260\2003456 \354\236\205\354\260\250 \354\247\204\355\226\211\354\244\221\354\235\270\353\215\260\354\232\224.\n[\354\203\201\353\213\264\354\202\254 \352\271\200\354\262\240\354\210\230] \355\231\225\354\235\270 \355\233\204 \354\233\220\352\262\251\354\234\274\353\241\234 \354\260\250\353\213\250\352\270\260\353\245\274 \354\230\254\353\240\244\353\223\234\353\240\270\354\212\265\353\213\210\353\213\244.`,\n        ai_summary: \'\352\260\225\353\202\250\354\227\255 \354\260\250\353\213\250\352\270\260 \353\257\270\354\235\270\354\213\235 \354\233\220\352\262\251 \352\260\234\353\260\251 \354\247\200\354\233\220\352\261\264.\',\n        created_at: new Date().toISOString(),\n      },\n    ];\n  }\n}\n\nexport function parseSTTTranscriptToKeywords(script: string): string[] {\n  if (!script) return [];\n  const words = [\'\354\260\250\353\213\250\352\270\260\', \'\354\233\220\352\262\251\', \'\355\231\230\353\266\210\', \'\354\236\205\354\260\250\', \'\353\266\200\354\240\225\354\243\274\354\260\250\', \'\354\227\260\354\236\245\', \'\352\263\204\354\242\214\', \'SUV\', \'\354\233\224\354\243\274\354\260\250\', \'\352\262\260\354\240\234\'];\n  return words.filter((w) => script.includes(w));\n}\n"
    }
