       >\n                      {carTypes.map((ct) => (\n                        <option key={ct} value={ct}>\n                          {ct}\n                        </option>\n                      ))}\n                    </select>\n                    <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400\" />\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                  \354\203\201\354\204\270 \354\260\250\354\242\205\353\252\205\n                </label>\n                <input\n                  type=\"text\"\n                  value={customer?.car_detail || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'car_detail\', e.target.value)}\n                  placeholder=\"\354\230\210: \354\217\230\353\202\230\355\203\200 DN8, \354\225\204\353\260\230\353\226\274 CN7, \355\214\260\353\246\254\354\204\270\354\235\264\353\223\234\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                />\n              </div>\n            </div>"
      replacement_content: "            {/* Primary Vehicle Info */}\n            <div className=\"space-y-2 pt-2 border-t border-slate-100\">\n              <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n                VEHICLE DETAILS (\354\260\250\353\237\211 \354\240\225\353\260\200 \354\204\270\353\266\204\355\231\224)\n              </h3>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                    \354\260\250\353\237\211\353\262\210\355\230\270 (License Plate)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={customer?.car_number || \'\'}\n                    onChange={(e) => onChangeCustomerField(\'car_number\', e.target.value)}\n                    placeholder=\"12\352\260\2003456 (\354\204\240\355\203\235/\353\271\210\354\271\270 \352\260\200\353\212\245)\"\n                    className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-900 font-mono uppercase font-bold focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                    \354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230\n                  </label>\n                  <div className=\"relative\">\n                    <select\n                      value={\n                        STANDARD_CAR_TYPES.some(\n                          (opt) => opt.value === (customer?.car_type || \'\')\n                        )\n                          ? customer?.car_type || \'\'\n                          : \'\352\270\260\355\203\200 \354\260\250\353\237\211\'\n                      }\n                      onChange={(e) => {\n                        const val = e.target.value;\n                        if (val === \'\352\270\260\355\203\200 \354\260\250\353\237\211\') {\n                          onChangeCustomerField(\'car_type\', \'\352\270\260\355\203\200 \354\260\250\353\237\211\');\n                        } else {\n                          onChangeCustomerField(\'car_type\', val);\n                        }\n                      }}\n                      className=\"w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-2 text-xs text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white font-medium cursor-pointer\"\n                    >\n                      {STANDARD_CAR_TYPES.map((opt) => (\n                        <option key={opt.label} value={opt.value}>\n                          {opt.label}\n                        </option>\n                      ))}\n                    </select>\n                    <ChevronDown className=\"w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400\" />\n                  </div>\n                </div>\n              </div>\n\n              {/* \352\270\260\355\203\200 \354\260\250\353\237\211 \354\204\240\355\203\235 \354\213\234 \354\247\201\354\240\221 \354\236\205\353\240\245\354\260\275 */}\n              {(customer?.car_type === \'\352\270\260\355\203\200 \354\260\250\353\237\211\' ||\n                (!STANDARD_CAR_TYPES.some((opt) => opt.value === (customer?.car_type || \'\')) &&\n                  customer?.car_type !== \'\')) && (\n                <div>\n                  <label className=\"block text-[11px] font-bold text-blue-700 mb-1 flex items-center gap-1\">\n                    \342\234\217\357\270\217 \352\270\260\355\203\200 \354\260\250\354\242\205 \353\214\200\353\266\204\353\245\230 \354\247\201\354\240\221 \354\236\205\353\240\245\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={customer?.car_type === \'\352\270\260\355\203\200 \354\260\250\353\237\211\' ? \'\' : customer?.car_type || \'\'}\n                    onChange={(e) =>\n                      onChangeCustomerField(\'car_type\', e.target.value || \'\352\270\260\355\203\200 \354\260\250\353\237\211\')\n                    }\n                    placeholder=\"\354\230\210: \355\212\271\354\210\230\354\260\250, \354\272\240\355\225\221\354\271\264, 2.5T \355\231\224\353\254\274, \354\230\244\355\206\240\353\260\224\354\235\264 \353\223\261 \354\236\220\354\234\240 \354\236\205\353\240\245\"\n                    className=\"w-full bg-blue-50/50 border border-blue-300 rounded-lg px-3 py-1.5 text-xs text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                  />\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 mb-1\">\n                  \354\203\201\354\204\270 \354\260\250\354\242\205\353\252\205\n                </label>\n                <input\n                  type=\"text\"\n                  value={customer?.car_detail || \'\'}\n                  onChange={(e) => onChangeCustomerField(\'car_detail\', e.target.value)}\n                  placeholder=\"\354\230\210: \354\217\230\353\202\230\355\203\200 DN8, \354\225\204\353\260\230\353\226\274 CN7, 1T \355\217\254\355\204\260 \355\203\221\354\260\250 \353\223\261 (\354\204\240\355\203\235/\353\271\210\354\271\270 \352\260\200\353\212\245)\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white\"\n                />\n              </div>\n            </div>"
