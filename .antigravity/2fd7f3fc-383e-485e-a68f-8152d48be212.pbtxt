  file_change {
    absolute_path_uri: "file:///src/components/workspace/LeftInteractionPad.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Play, Pause, AtSign, Sparkles, Radio, CheckCircle, MessageSquare } from \'lucide-react\';\nimport { CallLog, InternalAgent } from \'../../types\';\nimport { generateAISummary } from \'../../lib/services/aiSummaryService\';\n\ninterface LeftInteractionPadProps {\n  currentCallLog: CallLog | null;\n  agents: InternalAgent[];\n  currentAgentName: string;\n  notes: string;\n  setNotes: (text: string) => void;\n  carNumber?: string;\n  onSaveLog: (summaryText: string) => void;\n}\n\nexport const LeftInteractionPad: React.FC<LeftInteractionPadProps> = ({\n  currentCallLog,\n  agents,\n  currentAgentName,\n  notes,\n  setNotes,\n  carNumber,\n  onSaveLog,\n}) => {\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [showMention, setShowMention] = useState(false);\n  const [aiSummary, setAiSummary] = useState<string | null>(currentCallLog?.ai_summary || null);\n  const [isSummarizing, setIsSummarizing] = useState(false);\n\n  const handleRunAISummary = async () => {\n    const textToSummarize = notes || currentCallLog?.stt_script || \'\';\n    if (!textToSummarize) return;\n\n    setIsSummarizing(true);\n    const result = await generateAISummary(textToSummarize, carNumber);\n    setAiSummary(result.summary);\n    setIsSummarizing(false);\n  };\n\n  const handleMentionAgent = (agentName: string) => {\n    setNotes(`${notes} @${agentName} `);\n    setShowMention(false);\n  };\n\n  return (\n    <div className=\"bg-white dark:bg-[#0b1c30] rounded-xl border border-[#c5c5d8]/40 p-4 flex flex-col h-full shadow-sm\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-3 pb-2 border-b border-[#c5c5d8]/30\">\n        <h2 className=\"text-sm font-semibold text-[#0b1c30] dark:text-white flex items-center gap-2\">\n          <MessageSquare className=\"w-4 h-4 text-[#000eba]\" />\n          Interaction Pad\n        </h2>\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"px-2 py-0.5 bg-[#e5eeff] text-[#000eba] text-[11px] font-bold rounded\">\n            Live CTI\n          </span>\n          <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\"></span>\n        </div>\n      </div>\n\n      {/* STT Player Widget */}\n      <div className=\"bg-[#f8f9ff] dark:bg-[#213145] rounded-lg p-3 mb-3 border border-[#c5c5d8]/30\">\n        <div className=\"flex items-center gap-3 mb-2\">\n          <button\n            onClick={() => setIsPlaying(!isPlaying)}\n            className=\"w-8 h-8 rounded-full bg-[#000eba] text-white flex items-center justify-center hover:bg-[#2532d8] transition-colors shrink-0 shadow-sm\"\n          >\n            {isPlaying ? <Pause className=\"w-4 h-4\" /> : <Play className=\"w-4 h-4 pl-0.5\" />}\n          </button>\n          <div className=\"flex-1 h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full relative\">\n            <div\n              className={`absolute left-0 top-0 h-full bg-[#000eba] rounded-full ${\n                isPlaying ? \'w-2/3 transition-all duration-1000\' : \'w-1/3\'\n              }`}\n            ></div>\n          </div>\n          <span className=\"text-[11px] font-mono text-[#454555] dark:text-gray-300\">\n            {isPlaying ? \'02:14 / 04:15\' : \'01:24 / 04:15\'}\n          </span>\n        </div>\n\n        {/* STT Script Box */}\n        <div className=\"h-28 overflow-y-auto pr-1 space-y-1.5 text-xs\">\n          {currentCallLog?.stt_script ? (\n            currentCallLog.stt_script.split(\'\\n\').map((line, idx) => (\n              <p\n                key={idx}\n                className={`p-1.5 rounded ${\n                  line.includes(\'[\352\263\240\352\260\235\')\n                    ? \'bg-blue-50 text-blue-900 dark:bg-blue-950/40 dark:text-blue-200\'\n                    : \'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200\'\n                }`}\n              >\n                {line}\n              </p>\n            ))\n          ) : (\n            <p className=\"text-gray-400 italic\">\354\227\260\353\217\231\353\220\234 CTI \355\206\265\355\231\224 \353\205\271\354\267\250 STT \355\205\215\354\212\244\355\212\270\352\260\200 \355\221\234\354\213\234\353\220\251\353\213\210\353\213\244.</p>\n          )}\n        </div>\n      </div>\n\n      {/* AI Live Summary Card */}\n      <div className=\"mb-3 p-3 bg-emerald-50/60 dark:bg-emerald-950/30 rounded-xl border border-emerald-200/60\">\n        <div className=\"flex items-center justify-between mb-1\">\n          <span className=\"text-xs font-bold text-emerald-900 dark:text-emerald-300 flex items-center gap-1\">\n            <Sparkles className=\"w-3.5 h-3.5 text-emerald-600\" /> AI \354\236\220\353\217\231 \355\206\265\355\231\224 \354\232\224\354\225\275\n          </span>\n          <button\n            onClick={handleRunAISummary}\n            disabled={isSummarizing}\n            className=\"text-[10px] px-2 py-0.5 rounded bg-emerald-600 text-white font-semibold hover:bg-emerald-700 disabled:opacity-50\"\n          >\n            {isSummarizing ? \'\354\232\224\354\225\275\354\244\221...\' : \'\354\213\244\354\213\234\352\260\204 AI \354\232\224\354\225\275 \354\213\244\355\226\211\'}\n          </button>\n        </div>\n\n        <p className=\"text-xs text-emerald-950 dark:text-emerald-200 leading-relaxed\">\n          {aiSummary || \'\354\203\201\353\213\264 \354\232\224\354\225\275 \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 AI \354\212\244\355\201\254\353\246\275\355\212\270 \355\225\265\354\213\254 \354\232\224\354\225\275\354\235\204 \354\203\235\354\204\261\355\225\230\354\204\270\354\232\224.\'}\n        </p>\n      </div>\n\n      {/* Session Notes Text Pad */}\n      <div className=\"flex-1 flex flex-col relative\">\n        <label className=\"text-xs font-bold text-[#0b1c30] dark:text-white mb-1 flex justify-between items-center\">\n          <span>Session Notes (\353\251\224\353\252\250)</span>\n          <span className=\"text-[10px] text-[#454555]\">@\354\203\201\353\213\264\354\202\254 \354\235\264\353\246\204 \353\251\230\354\205\230 \354\247\200\354\233\220</span>\n        </label>\n        <textarea\n          value={notes}\n          onChange={(e) => setNotes(e.target.value)}\n          placeholder=\"\354\271\264\355\206\241 \353\260\217 \354\234\240\354\204\240 \354\235\221\353\214\200 \353\202\264\354\232\251\354\235\204 \354\213\244\354\213\234\352\260\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224... (@\354\236\205\353\240\245\354\213\234 \354\203\201\353\213\264\354\233\220 \353\251\230\354\205\230 \355\206\240\354\212\244)\"\n          className=\"flex-1 w-full bg-[#f8f9ff] dark:bg-[#213145] border border-[#c5c5d8]/40 rounded-lg p-3 text-xs text-[#0b1c30] dark:text-white focus:ring-2 focus:ring-[#000eba] resize-none placeholder:text-gray-400\"\n        />\n\n        {/* Mention Selector Dropdown */}\n        {showMention && (\n          <div className=\"absolute left-2 bottom-12 bg-white dark:bg-[#0b1c30] border border-[#c5c5d8] rounded-lg shadow-xl z-20 w-48 overflow-hidden\">\n            <div className=\"p-1.5 bg-gray-100 dark:bg-gray-800 text-[10px] font-bold text-gray-600 dark:text-gray-300 border-b\">\n              \353\213\264\353\213\271 \354\203\201\353\213\264\354\233\220 \355\206\240\354\212\244 \353\251\230\354\205\230\n            </div>\n            {agents\n              .filter((a) => a.agent_name !== currentAgentName)\n              .map((agent) => (\n                <button\n                  key={agent.id}\n                  onClick={() => handleMentionAgent(agent.agent_name)}\n                  className=\"w-full text-left px-3 py-1.5 hover:bg-[#e5eeff] dark:hover:bg-[#213145] text-xs text-[#0b1c30] dark:text-white flex items-center gap-1.5\"\n                >\n                  <AtSign className=\"w-3 h-3 text-[#000eba]\" />\n                  <span>{agent.agent_name} \354\203\201\353\213\264\354\202\254</span>\n                </button>\n              ))}\n          </div>\n        )}\n      </div>\n\n      {/* Action Bar */}\n      <div className=\"mt-3 flex justify-between items-center pt-2 border-t border-[#c5c5d8]/30\">\n        <button\n          type=\"button\"\n          onClick={() => setShowMention(!showMention)}\n          className=\"text-xs font-semibold text-[#000eba] hover:bg-[#e5eeff] px-2.5 py-1.5 rounded transition-colors flex items-center gap-1\"\n        >\n          <AtSign className=\"w-3.5 h-3.5\" /> Mention\n        </button>\n\n        <button\n          onClick={() => onSaveLog(aiSummary || notes)}\n          className=\"bg-[#000eba] hover:bg-[#2532d8] text-white px-4 py-1.5 rounded-lg text-xs font-bold transition-colors shadow-sm flex items-center gap-1\"\n        >\n          <CheckCircle className=\"w-3.5 h-3.5\" /> Save Log\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
